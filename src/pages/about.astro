---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/sections/About.astro';
import OpenSource from '@/components/sections/OpenSource.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout
  title="Sobre - Maison Galvão"
  description="Sobre Maison Galvão: desenvolvedor senior, 13+ anos de experiência, especialista em arquitetura de sistemas, liderança técnica e desenvolvimento full-stack."
>
  <div class="py-12 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">Sobre Mim</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      Desenvolvedor com 13+ anos de experiência na esfera pública, combinando expertise técnica
      com liderança estratégica. Apaixonado por resolver problemas complexos e compartilhar conhecimento.
    </p>
  </div>

  <About id="about" />
  <OpenSource id="opensource" />
  <Contact id="contact" />
</BaseLayout>
