---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileServices from '@/components/ui/ProfileServices.astro';
---

<BaseLayout title="Serviços e Perfis" description="Confira todos os meus perfis e serviços em um único lugar.">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 py-12 space-y-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-ink mb-4">Meus Serviços e Perfis</h1>
      <p class="text-lg text-ink-muted max-w-2xl mx-auto">
        Encontre todos os meus perfis profissionais, projetos e serviços que uso. Clique em qualquer card para visitar.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="max-w-6xl mx-auto">
      <ProfileServices showCategories={true} columns="auto" />
    </div>

    <!-- Footer Info -->
    <div class="border-t border-hairline pt-8 text-center text-ink-muted">
      <p class="text-sm">
        Última atualização: {new Date().toLocaleDateString('pt-BR')}
      </p>
    </div>
  </div>
</BaseLayout>
