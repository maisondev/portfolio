---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroWithProfile from '@/components/sections/HeroWithProfile.astro';
import TechStack from '@/components/sections/TechStack.astro';
import Button from '@/components/ui/Button.astro';
import { getLanguageFromUrl, getTranslation, isValidLanguage, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};
---

<BaseLayout
  title={`Maison Galvão - ${t('hero.title')}`}
  description={t('pages.experience.description')}
>
  <HeroWithProfile
    name="Maison Galvão"
    title={t('hero.title')}
    description={t('hero.description')}
    lang={lang}
  />

  <TechStack lang={lang} />

  <!-- Quick CTA Section -->
  <section class="bg-canvas py-20 md:py-24 space-y-8">
    <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-8">
      <div class="space-y-4">
        <h2 class="text-display-md font-semibold text-ink">{t('cta.explore')}</h2>
        <p class="text-body-lg text-ink-muted">{t('cta.exploreDesc')}</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-3">
        <Button href={getLocalizedPath('/experience')} variant="secondary">
          {t('cta.experience')}
        </Button>
        <Button href={getLocalizedPath('/education')} variant="secondary">
          {t('cta.education')}
        </Button>
        <Button href={getLocalizedPath('/blog')} variant="secondary">
          {t('cta.articles')}
        </Button>
        <Button href="mailto:maisongalvao@outlook.com" variant="secondary">
          {t('cta.message')}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
