---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroWithProfile from '@/components/sections/HeroWithProfile.astro';
import About from '@/components/sections/About.astro';
import Stats from '@/components/sections/Stats.astro';
import Contact from '@/components/sections/Contact.astro';
import TechStack from '@/components/sections/TechStack.astro';
import Button from '@/components/ui/Button.astro';
import { getLanguageFromUrl, getTranslation, isValidLanguage, getLocalizedPath as getLocalizedPathFor, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';
import { personSchema, organizationSchema } from '@/utils/schema';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema(lang),
    organizationSchema(lang),
  ],
};

const getLocalizedPath = (path: string) => getLocalizedPathFor(lang, path);
---

<BaseLayout
  title={`Maison Galvão - ${t('hero.title')}`}
  description={t('pages.experience.description')}
  schema={schema}
>
  <HeroWithProfile
    name="Maison Galvão"
    title={t('hero.title')}
    description={t('hero.description')}
    lang={lang}
  />

  <About lang={lang} />

  <Stats lang={lang} />

  <!-- Quick CTA Section -->
  <section class="bg-canvas py-20 md:py-24 space-y-8">
    <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-8">
      <div class="space-y-4">
        <h2 class="text-display-md font-semibold text-ink">{t('cta.explore')}</h2>
        <p class="text-body-lg text-ink-muted">{t('cta.exploreDesc')}</p>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        <Button href={getLocalizedPath('/contests')} variant="secondary">
          {t('cta.contests')}
        </Button>
        <Button href={getLocalizedPath('/courses')} variant="secondary">
          {t('cta.courses')}
        </Button>
        <Button href={getLocalizedPath('/education')} variant="secondary">
          {t('cta.education')}
        </Button>
        <Button href={getLocalizedPath('/experience')} variant="secondary">
          {t('cta.experience')}
        </Button>
        <Button href={getLocalizedPath('/recognitions')} variant="secondary">
          {t('cta.recognitions')}
        </Button>
      </div>
    </div>
  </section>

  <Contact id="contact" lang={lang} />
</BaseLayout>
