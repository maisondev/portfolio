---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Blog from '@/components/sections/Blog.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);
---

<BaseLayout
  title={`${t('pages.blog.title')} - Maison Galvão`}
  description={t('pages.blog.description')}
>
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 pt-8 md:pt-10 space-y-4">
    <h1 class="text-display-xl font-semibold text-ink">{t('pages.blog.title')}</h1>
    <p class="text-body-lg text-ink-muted max-w-3xl">
      {t('pages.blog.description')}
    </p>
  </div>

  <Blog id="blog" lang={lang} />
</BaseLayout>
