---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileServices from '@/components/ui/ProfileServices.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);

const titleMap = {
  pt: 'Serviços e Perfis',
  en: 'Services & Profiles',
};

const descriptionMap = {
  pt: 'Confira todos os meus perfis profissionais, projetos e serviços que uso. Clique em qualquer card para visitar.',
  en: 'Check out all my professional profiles, projects, and services I use. Click any card to visit.',
};
---

<BaseLayout
  title={titleMap[lang]}
  description={descriptionMap[lang]}
>
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 py-12 space-y-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-ink mb-4">{titleMap[lang]}</h1>
      <p class="text-lg text-ink-muted max-w-2xl mx-auto">
        {descriptionMap[lang]}
      </p>
    </div>

    <!-- Services Grid -->
    <div class="max-w-6xl mx-auto">
      <ProfileServices lang={lang} showCategories={true} columns="auto" />
    </div>

    <!-- Footer Info -->
    <div class="border-t border-hairline pt-8 text-center text-ink-muted">
      <p class="text-sm">
        {lang === 'pt' ? 'Última atualização:' : 'Last update:'} {new Date().toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US')}
      </p>
    </div>
  </div>
</BaseLayout>
