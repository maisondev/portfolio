---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RecognitionCard from '@/components/ui/RecognitionCard.astro';
import RecognitionCertModal from '@/components/ui/RecognitionCertModal.astro';
import { languages, getLanguageFromUrl, getLocalizedPath as getLocalizedPathFor, type Language } from '@/i18n/utils';
import type { Recognition } from '@/config/recognitions';
import { getRecognitionsWithSlugs } from '@/utils/recognitionSlugs';
import { breadcrumbSchema } from '@/utils/schema';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) =>
    getRecognitionsWithSlugs(lang as Language).map(({ slug, ...recognition }) => ({
      params: { lang, slug },
      props: { recognition },
    })),
  );
}

interface Props {
  recognition: Recognition;
}

const { recognition } = Astro.props;
const lang = getLanguageFromUrl(Astro.url) as Language;

const getLocalizedPath = (path: string) => getLocalizedPathFor(lang, path);

const labels = {
  pt: { back: 'Voltar aos reconhecimentos', home: 'Início', recognitions: 'Reconhecimentos' },
  en: { back: 'Back to recognitions', home: 'Home', recognitions: 'Recognitions' },
}[lang];

const pageTitle = `${recognition.title} · Maison Galvão`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: recognition.title,
      description: recognition.description,
      url: pageUrl,
      creator: {
        '@type': 'Organization',
        name: recognition.holder,
      },
    },
    breadcrumbSchema([
      { name: labels.home, url: new URL(getLocalizedPath('/'), Astro.site).href },
      { name: labels.recognitions, url: new URL(getLocalizedPath('/recognitions'), Astro.site).href },
      { name: recognition.title, url: pageUrl },
    ]),
  ],
};
---

<BaseLayout title={pageTitle} description={recognition.description} schema={schema}>
  <section class="bg-canvas pt-8 md:pt-10 pb-20 md:pb-24">
    <div class="max-w-3xl mx-auto px-6 md:px-8 space-y-6">
      <a
        href={getLocalizedPath('/recognitions')}
        class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-ink transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        {labels.back}
      </a>

      <RecognitionCard recognition={recognition} lang={lang} />
    </div>
  </section>

  <RecognitionCertModal />
</BaseLayout>
