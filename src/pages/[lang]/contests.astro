---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Contests from '@/components/sections/Contests.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);
---

<BaseLayout
  title={`${t('pages.contests.title')} - Maison Galvão`}
  description={t('pages.contests.description')}
>
  <section class="bg-canvas py-12 md:py-16">
    <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-6">
      <h1 class="text-display-xl font-semibold text-ink">{t('pages.contests.title')}</h1>
      <p class="text-body-lg text-ink-muted max-w-3xl">
        {t('pages.contests.description')}
      </p>
    </div>
  </section>

  <Contests id="contests" lang={lang} />
</BaseLayout>
