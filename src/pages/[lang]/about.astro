---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/sections/About.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);
---

<BaseLayout
  title={`Sobre - Maison Galvão`}
  description="Sobre Maison Galvão - Desenvolvedor com 13+ anos de experiência"
>
  <About lang={lang} />
</BaseLayout>
