---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/sections/About.astro';
import Contact from '@/components/sections/Contact.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);
---

<BaseLayout
  title={lang === 'pt' ? 'Sobre - Maison Galvão' : 'About - Maison Galvão'}
  description={lang === 'pt' ? 'Sobre Maison Galvão - Desenvolvedor com 16+ anos de experiência' : 'About Maison Galvão - Developer with 16+ years of experience'}
>
  <About lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
