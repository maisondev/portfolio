---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CoursesList from '@/components/ui/CoursesList.astro';
import { getLanguageFromUrl, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;

const titles = {
  pt: 'Meus Cursos',
  en: 'My Courses',
};

const descriptions = {
  pt: 'Explore meus cursos e certificações. Filtre por tecnologia ou instituição para encontrar cursos específicos.',
  en: 'Explore my courses and certifications. Filter by technology or institution to find specific courses.',
};
---

<BaseLayout
  title={titles[lang]}
  description={descriptions[lang]}
>
  <div class="py-12 space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">{titles[lang]}</h1>
      <p class="text-[#d4d4d8] text-lg max-w-3xl">
        {descriptions[lang]}
      </p>
    </div>

    <!-- Courses List with Filters -->
    <CoursesList lang={lang} />
  </div>
</BaseLayout>
