---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CoursesList from '@/components/ui/CoursesList.astro';
import { getLanguageFromUrl, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;

const titles = {
  pt: 'Meus Cursos',
  en: 'My Courses',
};

const descriptions = {
  pt: 'Explore meus cursos e certificações. Filtre por tecnologia ou instituição para encontrar cursos específicos.',
  en: 'Explore my courses and certifications. Filter by technology or institution to find specific courses.',
};
---

<BaseLayout
  title={titles[lang]}
  description={descriptions[lang]}
>
  <section class="bg-canvas pt-8 md:pt-10 pb-0">
    <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-2">
      <h1 class="text-display-xl font-semibold text-ink">{titles[lang]}</h1>
      <p class="text-body-lg text-ink-muted max-w-3xl">
        {descriptions[lang]}
      </p>
    </div>
  </section>

  <section class="bg-canvas py-20 md:py-24">
    <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-12">
      <CoursesList lang={lang} />
    </div>
  </section>
</BaseLayout>
