---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Education from '@/components/sections/Education.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);
---

<BaseLayout
  title={`${t('pages.education.title')} - Maison Galvão`}
  description={t('pages.education.description')}
>
  <div class="py-12 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">{t('pages.education.title')}</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      {t('pages.education.description')}
    </p>
  </div>

  <Education id="education" lang={lang} />
</BaseLayout>
