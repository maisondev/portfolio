---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { languages, getLanguageFromUrl, type Language } from '@/i18n/utils';
import { getProjects, type Project } from '@/config/projects';
import { breadcrumbSchema } from '@/utils/schema';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) =>
    getProjects(lang as Language).map((project) => ({
      params: { lang, slug: project.slug },
      props: { project },
    })),
  );
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = getLanguageFromUrl(Astro.url) as Language;

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};

const labels = {
  pt: { back: 'Voltar aos projetos', home: 'Início', projects: 'Projetos', visit: 'Visitar', code: 'Código', copyLink: 'Copiar link', linkCopied: 'Link copiado!' },
  en: { back: 'Back to projects', home: 'Home', projects: 'Projects', visit: 'Visit', code: 'Code', copyLink: 'Copy link', linkCopied: 'Link copied!' },
}[lang];

const pageTitle = `${project.title} · Maison Galvão`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: project.title,
      description: project.description,
      url: pageUrl,
      image: project.image ? new URL(project.image, Astro.site).href : undefined,
      creator: {
        '@type': 'Person',
        name: 'Maison Galvão',
      },
    },
    breadcrumbSchema([
      { name: labels.home, url: new URL(getLocalizedPath('/'), Astro.site).href },
      { name: labels.projects, url: new URL(getLocalizedPath('/projects'), Astro.site).href },
      { name: project.title, url: pageUrl },
    ]),
  ],
};
---

<BaseLayout title={pageTitle} description={project.description} schema={schema}>
  <section class="bg-canvas pt-8 md:pt-10 pb-20 md:pb-24">
    <div class="max-w-3xl mx-auto px-6 md:px-8 space-y-6">
      <a
        href={getLocalizedPath('/projects')}
        class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-ink transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        {labels.back}
      </a>

      <Card class="p-6 sm:p-8 space-y-6">
        {project.image && (
          <div class="relative overflow-hidden rounded-md">
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover rounded-md"
            />
          </div>
        )}

        <div class="flex flex-wrap items-start justify-between gap-2">
          <h1 class="text-display-md font-semibold text-ink">{project.title}</h1>
          <button
            id="project-copy-link"
            class="flex-shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-hairline text-eyebrow font-medium text-ink-muted hover:text-ink dark:hover:text-white hover:bg-surface-2 dark:hover:bg-surface-3 transition-colors"
            title={labels.copyLink}
            aria-label={labels.copyLink}
            data-label={labels.copyLink}
            data-label-copied={labels.linkCopied}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 flex-shrink-0">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            <span class="copy-link-label">{labels.copyLink}</span>
          </button>
        </div>

        {project.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <Badge text={tag} variant="primary" />
            ))}
          </div>
        )}

        <p class="text-body text-ink-subtle border-t border-hairline pt-6">
          {project.description}
        </p>

        {(project.demo || project.github) && (
          <div class="flex flex-wrap gap-3 pt-2">
            {project.demo && (
              <Button href={project.demo} variant="primary" target="_blank" rel="noopener noreferrer">
                {labels.visit}
              </Button>
            )}
            {project.github && (
              <Button href={project.github} variant="secondary" target="_blank" rel="noopener noreferrer">
                {labels.code}
              </Button>
            )}
          </div>
        )}
      </Card>
    </div>
  </section>
</BaseLayout>

<script>
  const copyLinkBtn = document.getElementById('project-copy-link');

  copyLinkBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      const label = copyLinkBtn.querySelector('.copy-link-label');
      if (label) {
        label.textContent = copyLinkBtn.dataset.labelCopied || 'Link copiado!';
        copyLinkBtn.classList.add('text-accent-500');
        setTimeout(() => {
          label.textContent = copyLinkBtn.dataset.label || 'Copiar link';
          copyLinkBtn.classList.remove('text-accent-500');
        }, 2000);
      }
    } catch {
      window.prompt('Copie o link:', url);
    }
  });
</script>
