---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Projects from '@/components/sections/Projects.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';
import { getStaticPaths } from '@/i18n/routes';

export { getStaticPaths };

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);
---

<BaseLayout
  title={`${t('pages.projects.title')} - Maison Galvão`}
  description={t('pages.projects.description')}
>
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 py-12 md:py-16 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-ink tracking-tight">{t('pages.projects.title')}</h1>
    <p class="text-body-lg text-ink-muted max-w-3xl">
      {t('pages.projects.description')}
    </p>
  </div>

  <Projects id="projects" lang={lang} />
</BaseLayout>
