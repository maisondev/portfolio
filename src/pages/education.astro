---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Education from '@/components/sections/Education.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout
  title="Formação - Maison Galvão"
  description="Formação acadêmica: Engenharia de Software (Gran), Pós-graduação Full Stack e Cloud Computing, Especialista em IA na Gestão Pública."
>
  <div class="py-12 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">Educação</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      Formação completa em tecnologia com múltiplas certificações.
      Compromisso contínuo com aprendizado e desenvolvimento profissional.
    </p>
  </div>

  <Education id="education" />
  <Contact id="contact" />
</BaseLayout>
