---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Blog from '@/components/sections/Blog.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout
  title="Blog - Artigos Técnicos - Maison Galvão"
  description="Artigos e posts técnicos sobre desenvolvimento, arquitetura de sistemas, cloud computing e boas práticas de engenharia."
>
  <div class="py-12 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">Artigos & Writing</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      Compartilhando conhecimento e experiências sobre desenvolvimento, arquitetura e liderança técnica.
      Posts escritos com base em 13+ anos resolvendo problemas reais.
    </p>
  </div>

  <Blog id="blog" />
  <Contact id="contact" />
</BaseLayout>
