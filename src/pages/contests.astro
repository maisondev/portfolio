---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Contests from '@/components/sections/Contests.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout
  title="Concursos Públicos - Maison Galvão"
  description="Aprovações em concursos públicos: Desenvolvedor de Software (PRODAM-AM 2018), Gerente de Informática (Prefeitura 2013). Publicações em diários oficiais."
>
  <div class="py-12 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">Concursos Públicos</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      Histórico de aprovações em concursos públicos. Credibilidade profissional comprovada através
      de publicações em diários oficiais da administração pública.
    </p>
  </div>

  <Contests id="contests" />
  <Contact id="contact" />
</BaseLayout>
