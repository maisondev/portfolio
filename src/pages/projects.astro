---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Projects from '@/components/sections/Projects.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout
  title="Projetos - Maison Galvão"
  description="Meus projetos principais: Sinapses, Portfolio e outros projetos de desenvolvimento com Vue.js, React, Node.js e tecnologias modernas."
>
  <div class="py-12 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">Meus Projetos</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      Projetos que demonstram minha expertise em desenvolvimento full-stack, design de sistemas
      e implementação de soluções modernas.
    </p>
  </div>

  <Projects id="projects" />
  <Contact id="contact" />
</BaseLayout>
