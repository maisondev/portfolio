---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Experience from '@/components/sections/Experience.astro';
import About from '@/components/sections/About.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout
  title="Experiência Profissional - Maison Galvão"
  description="Experiência profissional: 13+ anos em tecnologia, 7 anos como Desenvolvedor na Prodam, 5 anos como Gerente na Prefeitura de Manaus."
>
  <div class="py-12 space-y-4">
    <h1 class="text-5xl sm:text-6xl font-bold text-[#fafafa] tracking-tight">Experiência Profissional</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      13+ anos desenvolvendo soluções na esfera pública, combinando expertise técnica com liderança
      estratégica de equipes e infraestrutura.
    </p>
  </div>

  <Experience id="experience" />
  <About id="about" />
  <Contact id="contact" />
</BaseLayout>
