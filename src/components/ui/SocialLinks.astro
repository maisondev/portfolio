---

<div class="flex gap-4 items-center">
  {socials.map((social) => (
    <a
      href={social.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`${sizeClasses[size]} text-ink-muted ${social.color} transition-colors duration-300 hover:scale-110 transform`}
      title={social.name}
    >
      <Fragment set:html={icons[social.icon as keyof typeof icons]} />
    </a>
  ))}
</div>
