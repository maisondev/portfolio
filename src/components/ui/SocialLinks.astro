---
interface Props {
  variant?: 'icon-only' | 'with-text';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'icon-only', size = 'md' } = Astro.props;

const socials = [
  {
    name: 'GitHub',
    url: 'https://github.com/maisondev',
    icon: 'github',
    color: 'hover:text-ink dark:hover:text-white',
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/maisongalvao',
    icon: 'linkedin',
    color: 'hover:text-primary',
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/maisongalvao/',
    icon: 'instagram',
    color: 'hover:text-primary',
  },
];

const sizeClasses = {
  sm: 'w-5 h-5',
  md: 'w-6 h-6',
  lg: 'w-8 h-8',
