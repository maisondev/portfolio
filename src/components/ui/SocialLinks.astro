---
interface Props {
  variant?: 'icon-only' | 'with-text';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'icon-only', size = 'md' } = Astro.props;

const socials = [
  {
    name: 'GitHub',
    url: 'https://github.com/maisondev',
    icon: 'github',
    color: 'hover:text-[#fafafa]',
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/maisongalvao',
    icon: 'linkedin',
    color: 'hover:text-[#0a66c2]',
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/maisongalvao/',
    icon: 'instagram',
    color: 'hover:text-[#e4405f]',
  },
];

const sizeClasses = {
  sm: 'w-5 h-5',
  md: 'w-6 h-6',
  lg: 'w-8 h-8',
};

const icons = {
  github: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 .3 6 1.5 6 7v3M9 22v-4a4.8 4.8 0 0 0-1-3.5c3 .3 6 1.5 6 7v3M6 1a6 6 0 0 0-6 6v3h6V7a6 6 0 0 1 6-6h3v6h-3a6 6 0 0 0-6 6v3h6V7a6 6 0 0 0-6-6H6z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>`,
};
---

<div class="flex gap-4 items-center">
  {socials.map((social) => (
    <a
      href={social.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`${sizeClasses[size]} text-[#d4d4d8] ${social.color} transition-colors duration-300 hover:scale-110 transform`}
      title={social.name}
    >
      <Fragment set:html={icons[social.icon as keyof typeof icons]} />
    </a>
  ))}
</div>
