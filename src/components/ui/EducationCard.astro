---
import Card from './Card.astro';

interface Module {
  name: string;
  date: string;
  hours: number;
  skills: string[];
  certificateUrl?: string;
  certificatePages?: string[];
}

interface EducationItem {
  degree: string;
  institution: string;
  year: string;
  description: string;
  type: 'fundamental-medio' | 'tecnico' | 'graduacao' | 'pos-graduacao';
  certificateUrl?: string;
  certificatePages?: string[];
  status?: 'completed' | 'in-progress';
  modules?: Module[];
}

interface Props {
  edu: EducationItem;
  lang?: 'pt' | 'en';
}

const { edu, lang = 'pt' } = Astro.props;

const labels = {
  pt: { inProgress: 'Cursando', view: 'Ver', intermediateCerts: 'Certificações Intermediárias:', viewCertificate: 'Ver certificado' },
  en: { inProgress: 'In Progress', view: 'View', intermediateCerts: 'Intermediate Certifications:', viewCertificate: 'View certificate' },
}[lang];
---

<Card variant="secondary" class="p-5 space-y-3">
  <div class="flex gap-3 flex-col">
    <div class="flex-1 min-w-0">
      <h4 class="text-sm font-semibold text-ink leading-tight line-clamp-2">{edu.degree}</h4>
    </div>
    <div class="flex items-center justify-between gap-2">
      <span class="text-caption text-ink-secondary">{edu.year}</span>
      {edu.status === 'in-progress' && (
        <span class="text-caption font-medium px-2 py-1 rounded-sm bg-primary/10 text-primary">{labels.inProgress}</span>
      )}
    </div>
  </div>
  <div class="flex-1 flex flex-col gap-2 min-w-0">
    <p class="text-primary text-caption font-medium line-clamp-1">{edu.institution}</p>
    <p class="text-caption text-ink-muted line-clamp-2 flex-1">{edu.description}</p>
  </div>
  <div class="flex gap-2 flex-wrap">
    {edu.certificateUrl && (
      <button
        class="cert-btn inline-flex items-center gap-1.5 text-caption text-primary hover:text-primary-hover transition-colors"
        data-pdf={edu.certificateUrl}
        data-pages={edu.certificatePages ? JSON.stringify(edu.certificatePages) : undefined}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-3.5 h-3.5 flex-shrink-0"
        >
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
          <polyline points="17 21 17 13 7 13 7 21" />
          <polyline points="7 3 7 8 15 8" />
        </svg>
        <span class="hidden sm:inline">{labels.view}</span>
      </button>
    )}
  </div>

  {edu.modules && edu.modules.length > 0 && (
    <div class="pt-3 border-t border-hairline-muted space-y-3">
      <p class="text-caption font-medium text-ink-secondary">{labels.intermediateCerts}</p>
      <div class="space-y-2">
        {edu.modules.map((module) => (
          <div class="flex items-start justify-between gap-2 p-2 rounded-md bg-surface-1 dark:bg-surface-2">
            <div class="flex-1 min-w-0">
              <p class="text-caption font-medium text-ink line-clamp-1">{module.name}</p>
              <p class="text-caption text-ink-muted">{module.hours}h • {module.date}</p>
              {module.skills.length > 0 && (
                <div class="flex gap-1 flex-wrap mt-1">
                  {module.skills.map((skill) => (
                    <span class="text-caption px-1.5 py-0.5 rounded-sm bg-primary/10 text-primary">{skill}</span>
                  ))}
                </div>
              )}
            </div>
            {module.certificateUrl && (
              <button
                class="cert-btn flex-shrink-0 text-primary hover:text-primary-hover transition-colors"
                data-pdf={module.certificateUrl}
                data-pages={module.certificatePages ? JSON.stringify(module.certificatePages) : undefined}
                title={labels.viewCertificate}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-4 h-4"
                >
                  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                  <polyline points="17 21 17 13 7 13 7 21" />
                  <polyline points="7 3 7 8 15 8" />
                </svg>
              </button>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</Card>
