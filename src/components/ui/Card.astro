---
interface Props {
  variant?: 'primary' | 'secondary' | 'accent';
  hoverable?: boolean;
  fullHeight?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  hoverable = true,
  fullHeight = true,
  class: customClass = ''
} = Astro.props;

// Base styles applied to all cards
const baseStyles = 'bg-surface-1 border border-hairline rounded-lg transition-all duration-300';

// Variant-specific styles
const variantStyles = {
  primary: hoverable ? 'hover:bg-surface-2 hover:border-primary/50' : '',
  secondary: hoverable ? 'hover:bg-surface-2' : '',
  accent: hoverable ? 'hover:border-accent-500/40 hover:shadow-lg' : '',
};

// Height constraint
const heightClass = fullHeight ? 'flex flex-col h-full' : '';

const finalClass = `${baseStyles} ${variantStyles[variant]} ${heightClass} ${customClass}`;
---

<div class={finalClass}>
  <slot />
</div>
