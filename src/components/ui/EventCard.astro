---
import Card from './Card.astro';
import type { Event } from '@/config/events';

interface Props {
  event: Event;
  lang?: 'pt' | 'en';
}

const { event, lang = 'pt' } = Astro.props;
const hoursLabel = lang === 'pt' ? 'horas' : 'hours';
const certificateLabel = lang === 'pt' ? 'Ver Certificado' : 'View Certificate';
const certificateTitleLabel = lang === 'pt' ? 'Ver certificado' : 'View certificate';
---

<Card class="group relative overflow-hidden h-[320px]" fullHeight={false}>
  <!-- Header with organization -->
  <div class="px-6 py-4 border-b border-hairline bg-canvas flex items-center justify-between gap-2">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary">
      {event.organization}
    </p>
  </div>

  <!-- Content -->
  <div class="px-6 py-4 flex flex-col flex-grow space-y-4">
    <!-- Title -->
    <div>
      <h4 class="text-lg font-bold text-ink group-hover:text-primary transition-colors line-clamp-2">
        {event.name}
      </h4>
    </div>

    <!-- Description -->
    {event.description && (
      <p class="text-sm text-ink-muted line-clamp-2">
        {event.description}
      </p>
    )}

    <!-- Info: Date and Hours -->
    <div class="flex flex-col gap-2 text-sm text-ink-muted">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>{event.date}</span>
      </div>
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{event.hoursCompleted} {hoursLabel}</span>
      </div>
    </div>

    <!-- Spacer -->
    <div class="flex-grow"></div>

    <!-- Footer with certificate link -->
    <div class="pt-4 border-t border-hairline">
      <a
        href={event.certificateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded text-xs font-medium bg-primary/10 text-primary border border-primary/30 hover:border-primary/60 hover:bg-primary/20 transition-all"
        title={certificateTitleLabel}
      >
        <svg
          class="w-4 h-4"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
        </svg>
        <span>{certificateLabel}</span>
      </a>
    </div>
  </div>
</Card>
