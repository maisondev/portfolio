---
import Card from './Card.astro';
import Badge from './Badge.astro';
import type { ExperienceAchievement } from '@/config/experience';

interface Props {
  role: string;
  company: string;
  companyUrl?: string;
  period: string;
  description: string;
  highlights: string[];
  technologies: string[];
  achievements?: ExperienceAchievement[];
  lang?: 'pt' | 'en';
}

const { role, company, companyUrl, period, description, highlights, technologies, achievements = [], lang = 'pt' } = Astro.props;
const highlightsLabel = lang === 'pt' ? 'Destaques' : 'Highlights';
---

<Card variant="secondary" class="p-6 sm:p-8 space-y-6">
  <div class="space-y-3">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
      <div>
        <h3 class="text-card-title font-semibold text-ink">{role}</h3>
        {companyUrl ? (
          <a
            href={companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary font-medium text-body-sm hover:text-primary-hover transition-colors inline-flex items-center gap-1"
          >
            {company}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4m-4-6l6-6m0 0l-6 6"></path>
            </svg>
          </a>
        ) : (
          <p class="text-primary font-medium text-body-sm">{company}</p>
        )}
      </div>
      <span class="text-body-sm font-medium text-ink-muted dark:text-ink-subtle whitespace-nowrap flex items-center gap-1.5">
        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 7V3m8 4V3m4 6H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" />
        </svg>
        {period}
      </span>
    </div>
    <p class="text-body text-ink-muted leading-relaxed">{description}</p>
  </div>

  {highlights.length > 0 && (
    <div class="space-y-2">
      <h4 class="text-caption font-semibold text-ink-subtle uppercase tracking-wide">{highlightsLabel}</h4>
      <ul class="space-y-1.5">
        {highlights.map((highlight) => (
          <li class="flex gap-3 text-body-sm text-ink-muted">
            <span class="text-primary font-semibold flex-shrink-0">→</span>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {achievements.length > 0 && (
    <div class="space-y-3">
      {achievements.map((achievement) => (
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 p-4 bg-accent-500/10 border border-accent-500/30 rounded-lg">
          <span class="inline-flex items-center justify-center w-12 h-12 bg-accent-500 rounded-full flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-6 h-6 text-black">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </span>
          <div class="flex-1 space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-block px-2 py-0.5 bg-accent-500 text-black text-xs font-bold rounded uppercase tracking-wider">
                {achievement.badge}
              </span>
              <span class="text-body-sm font-semibold text-ink">{achievement.title}</span>
            </div>
            {achievement.subtitle && (
              <p class="text-caption text-ink-muted">{achievement.subtitle}</p>
            )}
          </div>
          {achievement.link && (
            <a
              href={achievement.link.href}
              class="text-button font-semibold text-accent-500 hover:text-accent-500/80 transition-colors whitespace-nowrap flex items-center gap-1.5"
            >
              {achievement.link.label}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  )}

  <div class="flex flex-wrap gap-2 pt-2">
    {technologies.map((tech) => (
      <Badge text={tech} variant="primary" />
    ))}
  </div>
</Card>
