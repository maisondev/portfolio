---
import Badge from './Badge.astro';

interface Props {
  role: string;
  company: string;
  period: string;
  description: string;
  highlights: string[];
  technologies: string[];
}

const { role, company, period, description, highlights, technologies } = Astro.props;
---

<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 sm:p-8 hover:border-accent-500/30 transition-all duration-300 space-y-6">
  <div class="space-y-2">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-[#fafafa]">{role}</h3>
        <p class="text-accent-500 font-semibold">{company}</p>
      </div>
      <span class="text-sm text-[#a1a1a1] whitespace-nowrap">{period}</span>
    </div>
    <p class="text-[#d4d4d8] text-base leading-relaxed">{description}</p>
  </div>

  {highlights.length > 0 && (
    <div class="space-y-2">
      <h4 class="text-sm font-semibold text-[#a1a1a1] uppercase tracking-wide">Destaques</h4>
      <ul class="space-y-2">
        {highlights.map((highlight) => (
          <li class="flex gap-3 text-[#d4d4d8] text-sm">
            <span class="text-accent-500 font-bold">→</span>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="flex flex-wrap gap-2 pt-2">
    {technologies.map((tech) => (
      <Badge text={tech} variant="primary" />
    ))}
  </div>
</div>
