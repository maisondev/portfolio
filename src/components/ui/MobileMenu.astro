---
interface Props {
  links: Array<{ href: string; label: string }>;
}

const { links } = Astro.props;
const linksJson = JSON.stringify(links);
---

<div class="lg:hidden">
  <button
    id="hamburger"
    type="button"
    class="relative w-10 h-10 flex flex-col justify-center items-center gap-1.5"
  >
    <span id="line1" class="h-0.5 w-6 bg-ink block transition-all duration-300"></span>
    <span id="line2" class="h-0.5 w-6 bg-ink block transition-all duration-300"></span>
    <span id="line3" class="h-0.5 w-6 bg-ink block transition-all duration-300"></span>
  </button>
</div>

<script define:vars={{ linksJson }}>
  const links = JSON.parse(linksJson);

  // Criar overlay diretamente no body
  const overlay = document.createElement('div');
  overlay.id = 'mobile-nav-overlay';
  overlay.className = 'fixed left-0 right-0 bottom-0 bg-canvas border-t border-hairline z-[9999] overflow-y-auto hidden';
  overlay.style.top = '56px';

  const nav = document.createElement('nav');
  nav.className = 'p-4';

  links.forEach(link => {
    const a = document.createElement('a');
    a.href = link.href;
    a.textContent = link.label;
    a.className = 'block px-4 py-3 rounded-md mb-1 border-l-2 border-transparent text-ink-subtle hover:text-primary hover:bg-surface-2 hover:border-primary transition-colors';
    a.addEventListener('click', closeMenu);
    nav.appendChild(a);
  });

  overlay.appendChild(nav);
  document.body.appendChild(overlay);

  const hamburger = document.getElementById('hamburger');
  const line1 = document.getElementById('line1');
  const line2 = document.getElementById('line2');
  const line3 = document.getElementById('line3');

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    overlay.classList.remove('hidden');
    line1.style.transform = 'rotate(45deg) translateY(6px)';
    line2.style.opacity = '0';
    line3.style.transform = 'rotate(-45deg) translateY(-6px)';
  }

  function closeMenu() {
    isOpen = false;
    overlay.classList.add('hidden');
    line1.style.transform = '';
    line2.style.opacity = '1';
    line3.style.transform = '';
  }

  hamburger?.addEventListener('click', () => {
    if (isOpen) closeMenu();
    else openMenu();
  });

  document.addEventListener('click', (e) => {
    if (isOpen && !hamburger.contains(e.target) && !overlay.contains(e.target)) {
      closeMenu();
    }
  });
</script>
