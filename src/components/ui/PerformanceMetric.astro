---
interface Props {
  label: string;
  value: number;
  unit?: string;
  target?: number;
  color?: 'green' | 'orange' | 'red';
}

const { label, value, unit = '', target = 100, color } = Astro.props;

const percentage = (value / target) * 100;
let bgColor = 'bg-gradient-to-r from-green-500 to-emerald-500';
let finalColor = color || 'green';

if (percentage < 50) {
  bgColor = 'bg-gradient-to-r from-red-500 to-pink-500';
  finalColor = 'red';
} else if (percentage < 75) {
  bgColor = 'bg-gradient-to-r from-orange-500 to-amber-500';
  finalColor = 'orange';
}
---

<div class="space-y-2">
  <div class="flex justify-between items-baseline">
    <span class="text-sm font-medium text-ink-muted">{label}</span>
    <span class="text-lg font-bold text-ink">
      {value}<span class="text-sm text-ink-subtle">{unit}</span>
    </span>
  </div>
  <div class="w-full bg-surface-1 rounded-full h-2 overflow-hidden">
    <div
      class={`h-full rounded-full transition-all duration-500 ${bgColor}`}
      style={{ width: `${Math.min(percentage, 100)}%` }}
    ></div>
  </div>
</div>
