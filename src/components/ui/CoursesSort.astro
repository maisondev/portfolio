---
interface Props {
  lang?: 'pt' | 'en';
}

const { lang = 'pt' } = Astro.props;

const labelField = 'text-xs font-semibold text-ink-muted uppercase tracking-widest';
---

<div class="space-y-3 bg-surface-1 border border-hairline rounded-xl p-6 md:p-8">
  <h3 class={labelField}>
    {lang === 'pt' ? 'Ordenar por' : 'Sort by'}
  </h3>
  <div class="flex flex-wrap gap-2.5" data-sort-buttons>
    <button
      id="course-sort-recent"
      data-sort="desc"
      class="sort-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary text-white hover:bg-primary-hover"
      title={lang === 'pt' ? 'Ordenar por mais recentes' : 'Sort by most recent'}
    >
      {lang === 'pt' ? 'Recentes' : 'Recent'}
    </button>
    <button
      id="course-sort-oldest"
      data-sort="asc"
      class="sort-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 text-ink-muted border border-hairline hover:border-primary/50"
      title={lang === 'pt' ? 'Ordenar por mais antigos' : 'Sort by oldest first'}
    >
      {lang === 'pt' ? 'Antigos' : 'Oldest'}
    </button>
  </div>
</div>

<style>
  :global(.dark) .sort-btn {
    @apply bg-surface-2 border-hairline hover:border-primary/50;
  }
</style>
