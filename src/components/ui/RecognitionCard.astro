---
import Button from './Button.astro';
import Card from './Card.astro';
import type { RecognitionWithSlug } from '@/utils/recognitionSlugs';
import { getLocalizedPath as getLocalizedPathFor } from '@/i18n/utils';

interface Props {
  recognition: RecognitionWithSlug;
  lang?: 'pt' | 'en';
}

const { recognition: rec, lang = 'pt' } = Astro.props;

const slug = rec.slug;

const getLocalizedPath = (path: string) => getLocalizedPathFor(lang, path);

const labels = {
  pt: {
    processNumber: 'Nº do Processo',
    issuer: 'Órgão Emissor',
    holder: 'Titular',
    createdAt: 'Data de Criação',
    issuedAt: 'Expedido em',
    validity: 'Validade',
    languages: 'Linguagens',
    role: 'Função',
    coAuthors: 'coautores',
    viewCertificate: 'Ver Certificado Oficial',
    searchInpi: 'Consultar no INPI',
    viewLive: 'Acessar Sistema',
    badge: 'Propriedade Intelectual Registrada',
    copyLink: 'Copiar link',
    linkCopied: 'Link copiado!',
  },
  en: {
    processNumber: 'Process Number',
    issuer: 'Issuing Authority',
    holder: 'Holder',
    createdAt: 'Creation Date',
    issuedAt: 'Issued On',
    validity: 'Validity',
    languages: 'Languages',
    role: 'Role',
    coAuthors: 'co-authors',
    viewCertificate: 'View Official Certificate',
    searchInpi: 'Search on INPI',
    viewLive: 'Access System',
    badge: 'Registered Intellectual Property',
    copyLink: 'Copy link',
    linkCopied: 'Link copied!',
  },
};

const t = labels[lang];
---

<div id={slug} class="recognition-anchor scroll-mt-24 rounded-xl transition-shadow duration-500">
<Card variant="secondary" class="w-full p-6 sm:p-8 space-y-6">
  <!-- Header -->
  <div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-accent-500/10 border border-accent-500/30 rounded-full text-xs font-semibold text-accent-500 uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3 flex-shrink-0">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>INPI</span>
      </span>
      <span class="text-eyebrow font-semibold text-ink-muted uppercase line-clamp-1">
        {t.badge}
      </span>
      <button
        class="recognition-copy-link ml-auto inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-hairline text-eyebrow font-medium text-ink-muted hover:text-ink dark:hover:text-white hover:bg-surface-2 dark:hover:bg-surface-3 transition-colors"
        title={t.copyLink}
        data-anchor={slug}
        data-label={t.copyLink}
        data-label-copied={t.linkCopied}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 flex-shrink-0">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        <span class="copy-link-label">{t.copyLink}</span>
      </button>
    </div>

    <h2 class="text-card-title font-semibold text-ink break-words">
      <a href={getLocalizedPath(`/recognitions/${slug}`)} class="text-ink hover:text-primary transition-colors">
        {rec.title}
      </a>
    </h2>
    <p class="text-body text-ink-muted">
      {rec.subtitle}
    </p>
  </div>

  <!-- Description -->
  <p class="text-body text-ink-subtle">
    {rec.description}
  </p>

  <!-- Details Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 gap-y-4 pt-4 border-t border-hairline">
    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.processNumber}</dt>
      <dd class="text-body text-ink font-mono break-all">{rec.processNumber}</dd>
    </div>

    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.role}</dt>
      <dd class="text-body text-ink">{rec.role} ({rec.authorsCount} {t.coAuthors})</dd>
    </div>

    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.issuer}</dt>
      <dd class="text-body text-ink break-words">
        {rec.issuerUrl ? (
          <a href={rec.issuerUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary-hover underline-offset-4 hover:underline">
            {rec.issuer}
          </a>
        ) : rec.issuer}
      </dd>
    </div>

    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.holder}</dt>
      <dd class="text-body text-ink break-words">{rec.holder}</dd>
    </div>

    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.createdAt}</dt>
      <dd class="text-body text-ink">{rec.createdAt}</dd>
    </div>

    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.issuedAt}</dt>
      <dd class="text-body text-ink">{rec.issuedAt}</dd>
    </div>

    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.validity}</dt>
      <dd class="text-body text-ink">{rec.validity}</dd>
    </div>

    <div class="space-y-2">
      <dt class="text-eyebrow font-semibold text-ink-muted uppercase">{t.languages}</dt>
      <dd class="flex flex-wrap gap-2">
        {rec.languages.map((lng) => (
          <span class="px-2 py-1 bg-surface-2 border border-hairline rounded-md text-eyebrow font-medium text-ink">
            {lng}
          </span>
        ))}
      </dd>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-col sm:flex-row gap-3 pt-4 mt-auto border-t border-hairline">
    <button
      class="recognition-cert-btn py-2 px-4 rounded-md text-button bg-primary text-white hover:bg-primary-hover focus:outline-2 focus:outline-offset-2 focus:outline-primary-focus active:scale-95 flex items-center justify-center gap-2 w-full sm:w-auto transition-all duration-300"
      title={t.viewCertificate}
      data-cert-url={rec.certificateUrl}
      data-cert-title={rec.title}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      <span class="truncate">{t.viewCertificate}</span>
    </button>

    {rec.liveUrl && (
      <Button
        href={rec.liveUrl}
        variant="secondary"
        target="_blank"
        rel="noopener noreferrer"
        title={t.viewLive}
        class="flex items-center justify-center gap-2 w-full sm:w-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        <span class="truncate">{t.viewLive}</span>
      </Button>
    )}

    {rec.searchUrl && (
      <Button
        href={rec.searchUrl}
        variant="secondary"
        target="_blank"
        rel="noopener noreferrer"
        title={t.searchInpi}
        class="flex items-center justify-center gap-2 w-full sm:w-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="truncate">{t.searchInpi}</span>
      </Button>
    )}
  </div>
</Card>
</div>
