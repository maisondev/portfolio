---
import Button from './Button.astro';
import type { Recognition } from '@/config/recognitions';

interface Props {
  recognition: Recognition;
  lang?: 'pt' | 'en';
}

const { recognition: rec, lang = 'pt' } = Astro.props;

const labels = {
  pt: {
    processNumber: 'Nº do Processo',
    issuer: 'Órgão Emissor',
    holder: 'Titular',
    createdAt: 'Data de Criação',
    issuedAt: 'Expedido em',
    validity: 'Validade',
    languages: 'Linguagens',
    role: 'Função',
    coAuthors: 'coautores',
    viewCertificate: 'Ver Certificado Oficial',
    searchInpi: 'Consultar no INPI',
    viewLive: 'Acessar Sistema',
    badge: 'Propriedade Intelectual Registrada',
  },
  en: {
    processNumber: 'Process Number',
    issuer: 'Issuing Authority',
    holder: 'Holder',
    createdAt: 'Creation Date',
    issuedAt: 'Issued On',
    validity: 'Validity',
    languages: 'Languages',
    role: 'Role',
    coAuthors: 'co-authors',
    viewCertificate: 'View Official Certificate',
    searchInpi: 'Search on INPI',
    viewLive: 'Access System',
    badge: 'Registered Intellectual Property',
  },
};

const t = labels[lang];
---

<article class="w-full bg-surface-1 dark:bg-surface-2 border border-hairline dark:border-hairline rounded-lg sm:rounded-2xl p-6 sm:p-8 md:p-12 space-y-6 sm:space-y-8 hover:border-accent-500/40 transition-colors">
  <!-- Header -->
  <div class="space-y-3 sm:space-y-4">
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <span class="inline-flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 bg-accent-500/10 border border-accent-500/30 rounded-full text-xs font-semibold text-accent-500 uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3 sm:w-3.5 sm:h-3.5 flex-shrink-0">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span class="hidden sm:inline">INPI</span>
      </span>
      <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider line-clamp-1">
        {t.badge}
      </span>
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-ink tracking-tight break-words">
      {rec.title}
    </h2>
    <p class="text-sm sm:text-base text-ink-muted leading-relaxed">
      {rec.subtitle}
    </p>
  </div>

  <!-- Description -->
  <p class="text-sm sm:text-base text-ink-subtle leading-relaxed">
    {rec.description}
  </p>

  <!-- Details Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-x-6 md:gap-x-8 gap-y-4 sm:gap-y-5 pt-6 border-t border-hairline dark:border-hairline">
    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.processNumber}</dt>
      <dd class="text-sm sm:text-base text-ink font-mono break-all">{rec.processNumber}</dd>
    </div>

    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.role}</dt>
      <dd class="text-sm sm:text-base text-ink">{rec.role} ({rec.authorsCount} {t.coAuthors})</dd>
    </div>

    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.issuer}</dt>
      <dd class="text-sm sm:text-base text-ink break-words">
        {rec.issuerUrl ? (
          <a href={rec.issuerUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary-hover transition-colors underline-offset-4 hover:underline">
            {rec.issuer}
          </a>
        ) : rec.issuer}
      </dd>
    </div>

    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.holder}</dt>
      <dd class="text-sm sm:text-base text-ink break-words">{rec.holder}</dd>
    </div>

    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.createdAt}</dt>
      <dd class="text-sm sm:text-base text-ink">{rec.createdAt}</dd>
    </div>

    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.issuedAt}</dt>
      <dd class="text-sm sm:text-base text-ink">{rec.issuedAt}</dd>
    </div>

    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.validity}</dt>
      <dd class="text-sm sm:text-base text-ink">{rec.validity}</dd>
    </div>

    <div class="space-y-1">
      <dt class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{t.languages}</dt>
      <dd class="flex flex-wrap gap-1.5 sm:gap-2">
        {rec.languages.map((lng) => (
          <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 bg-surface-2 dark:bg-surface-3 border border-hairline rounded-md text-xs font-medium text-ink">
            {lng}
          </span>
        ))}
      </dd>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 pt-6">
    <button
      class="recognition-cert-btn inline-block font-sans py-2 sm:py-2.5 px-3 sm:px-3.5 rounded-md text-sm sm:text-button transition-all duration-300 bg-primary text-white hover:bg-primary-hover hover:text-white focus:outline-2 focus:outline-offset-2 focus:outline-primary-focus active:scale-95 flex items-center justify-center gap-2 w-full sm:w-auto"
      title={t.viewCertificate}
      data-cert-url={rec.certificateUrl}
      data-cert-title={rec.title}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      <span class="text-xs sm:text-sm truncate">{t.viewCertificate}</span>
    </button>

    {rec.liveUrl && (
      <Button
        href={rec.liveUrl}
        variant="secondary"
        target="_blank"
        rel="noopener noreferrer"
        title={t.viewLive}
        class="flex items-center justify-center gap-2 w-full sm:w-auto text-xs sm:text-sm py-2 sm:py-2.5 px-3 sm:px-3.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        <span class="truncate">{t.viewLive}</span>
      </Button>
    )}

    {rec.searchUrl && (
      <Button
        href={rec.searchUrl}
        variant="secondary"
        target="_blank"
        rel="noopener noreferrer"
        title={t.searchInpi}
        class="flex items-center justify-center gap-2 w-full sm:w-auto text-xs sm:text-sm py-2 sm:py-2.5 px-3 sm:px-3.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="truncate">{t.searchInpi}</span>
      </Button>
    )}
  </div>
</article>
