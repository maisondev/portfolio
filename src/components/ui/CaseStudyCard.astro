---
import Card from './Card.astro';

interface CaseStudy {
  title: string;
  client: string;
  scope: string;
  period: string;
  challenge: string;
  results: string[];
  technologies: string[];
  keyLearnings: string[];
  impact: {
    users: string;
    uptime: string;
    reduction: string;
  };
}

interface Translations {
  challenge: string;
  results: string;
  technologies: string;
  learnings: string;
  users: string;
  uptime: string;
  latencyReduction: string;
}

interface Props {
  study: CaseStudy;
  t: Translations;
}

const { study, t } = Astro.props;
---

<Card variant="accent" class="p-8 space-y-6">
  {/* Header */}
  <div class="space-y-3">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
      <div class="space-y-1">
        <p class="text-accent-500 text-sm font-semibold uppercase tracking-wider">{study.client}</p>
        <h3 class="text-2xl sm:text-3xl font-bold text-ink">{study.title}</h3>
        <p class="text-ink-muted">{study.scope}</p>
      </div>
      <span class="text-sm text-ink-muted whitespace-nowrap pt-1">{study.period}</span>
    </div>
  </div>

  {/* Challenge */}
  <div class="bg-canvas border border-hairline rounded-lg p-4">
    <h4 class="text-sm font-semibold text-accent-500 uppercase mb-2">{t.challenge}</h4>
    <p class="text-ink-muted">{study.challenge}</p>
  </div>

  {/* TODO: Impact Metrics - Revisar textos em inglês depois
  <div class="grid grid-cols-3 gap-4 bg-accent-500/5 border border-accent-500/20 rounded-lg p-4">
    <div class="space-y-1">
      <p class="text-accent-500 font-bold text-xl">{study.impact.users}</p>
      <p class="text-ink-muted text-xs uppercase">{t.users}</p>
    </div>
    <div class="space-y-1">
      <p class="text-accent-500 font-bold text-xl">{study.impact.uptime}</p>
      <p class="text-ink-muted text-xs uppercase">{t.uptime}</p>
    </div>
    <div class="space-y-1">
      <p class="text-accent-500 font-bold text-xl">{study.impact.reduction}</p>
      <p class="text-ink-muted text-xs uppercase">{t.latencyReduction}</p>
    </div>
  </div>
  */}

  {/* Technologies */}
  <div class="space-y-3">
    <h4 class="text-sm font-semibold text-ink uppercase">{t.technologies}</h4>
    <div class="flex flex-wrap gap-2">
      {study.technologies.map((tech) => (
        <span class="px-3 py-1 bg-hairline text-ink-muted rounded-full text-sm border border-hairline hover:border-accent-500/50 transition-colors">
          {tech}
        </span>
      ))}
    </div>
  </div>

  {/* Key Learnings */}
  <div class="space-y-3">
    <h4 class="text-sm font-semibold text-ink uppercase">{t.learnings}</h4>
    <ul class="space-y-2">
      {study.keyLearnings.map((learning) => (
        <li class="flex gap-2 text-ink-muted text-sm">
          <span class="text-accent-500 flex-shrink-0">→</span>
          <span>{learning}</span>
        </li>
      ))}
    </ul>
  </div>
</Card>
