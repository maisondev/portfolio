---
// LoadingOverlay.astro - Loading global bonito com animações incríveis
---

<div id="loading-overlay" class="fixed inset-0 z-[9999] hidden">
  <!-- Overlay com gradiente colorido Vercel-like -->
  <div class="absolute inset-0 bg-gradient-to-br from-black/40 via-purple-900/20 to-black/50 dark:from-black/60 dark:via-purple-950/30 dark:to-black/70 backdrop-blur-md transition-all duration-300"></div>

  <!-- Gradiente de fundo animado -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-blue-500/10 via-purple-500/10 to-pink-500/10 rounded-full blur-3xl animate-gradient-shift"></div>
    <div class="absolute -bottom-1/2 -left-1/2 w-full h-full bg-gradient-to-tr from-emerald-500/10 via-cyan-500/10 to-blue-500/10 rounded-full blur-3xl animate-gradient-shift-delay"></div>
  </div>

  <!-- Conteúdo centralizado -->
  <div class="absolute inset-0 flex items-center justify-center p-4 relative z-10">
    <div class="bg-white dark:bg-[#0f0f0f] rounded-3xl shadow-2xl p-12 flex flex-col items-center gap-8 animate-slide-up max-w-sm w-full border border-white/20 dark:border-white/10 backdrop-blur-xl bg-white/40 dark:bg-white/5">
      <!-- Spinner com gradientes coloridos -->
      <div class="relative w-20 h-20">
        <!-- Glow background -->
        <div class="absolute inset-0 rounded-full bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 opacity-20 blur-lg animate-spin-slow"></div>

        <!-- Anel externo 1 (gradiente roxo-rosa) -->
        <div class="absolute inset-0 rounded-full border-3 border-transparent bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 p-[2px] animate-spin-slow" style="mask-image: conic-gradient(from 0deg, transparent 0deg 90deg, black 90deg 360deg);"></div>

        <!-- Anel externo 2 (gradiente cyan-verde) -->
        <div class="absolute inset-3 rounded-full border-3 border-transparent bg-gradient-to-r from-cyan-400 via-teal-500 to-emerald-500 p-[2px] animate-spin-reverse" style="mask-image: conic-gradient(from 0deg, black 0deg 90deg, transparent 90deg 360deg);"></div>

        <!-- Anel interno com glow -->
        <div class="absolute inset-6 rounded-full border-2 border-transparent bg-gradient-to-r from-violet-400 to-cyan-400 opacity-50 blur-sm animate-pulse-scale"></div>

        <!-- Ponto central com glow -->
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="relative w-3 h-3">
            <div class="absolute inset-0 bg-gradient-to-r from-yellow-300 via-pink-300 to-blue-300 rounded-full animate-ping opacity-75"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-yellow-400 to-blue-400 rounded-full animate-pulse"></div>
          </div>
        </div>
      </div>

      <!-- Texto com animação de fade -->
      <div class="text-center space-y-3">
        <p id="loading-text" class="text-sm font-semibold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 dark:from-blue-400 dark:via-purple-400 dark:to-pink-400 bg-clip-text text-transparent animate-fade-in">
          Carregando...
        </p>
        <!-- Três pontinhos animados com cores -->
        <div class="flex gap-2 justify-center h-5">
          <span class="inline-block w-1.5 h-1.5 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full animate-bounce shadow-lg shadow-blue-500/50" style="animation-delay: 0s;"></span>
          <span class="inline-block w-1.5 h-1.5 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full animate-bounce shadow-lg shadow-purple-500/50" style="animation-delay: 0.2s;"></span>
          <span class="inline-block w-1.5 h-1.5 bg-gradient-to-r from-pink-500 to-cyan-500 rounded-full animate-bounce shadow-lg shadow-pink-500/50" style="animation-delay: 0.4s;"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Sistema global de loading com contador de tarefas
  window.__loadingCounter = 0;

  window.showLoading = (text = 'Carregando...') => {
    const overlay = document.getElementById('loading-overlay');
    const textElement = document.getElementById('loading-text');

    window.__loadingCounter++;

    if (overlay) {
      overlay.classList.remove('hidden');
      if (textElement) {
        textElement.textContent = text;
      }
    }
  };

  window.hideLoading = () => {
    window.__loadingCounter = Math.max(0, window.__loadingCounter - 1);

    if (window.__loadingCounter === 0) {
      const overlay = document.getElementById('loading-overlay');
      if (overlay) {
        overlay.classList.add('hidden');
      }
    }
  };

  // Alias em português
  window.mostrarCarregando = window.showLoading;
  window.esconderCarregando = window.hideLoading;
</script>

<style>
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes spin-reverse {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }

  @keyframes pulse-scale {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.5;
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes gradient-shift {
    0%, 100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(30px, -30px);
    }
  }

  @keyframes gradient-shift-delay {
    0%, 100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-30px, 30px);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 2s linear infinite;
  }

  .animate-spin-reverse {
    animation: spin-reverse 3s linear infinite;
  }

  .animate-pulse-scale {
    animation: pulse-scale 2s ease-in-out infinite;
  }

  .animate-slide-up {
    animation: slide-up 0.4s ease-out;
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out 0.2s both;
  }

  .animate-gradient-shift {
    animation: gradient-shift 8s ease-in-out infinite;
  }

  .animate-gradient-shift-delay {
    animation: gradient-shift-delay 8s ease-in-out infinite 2s;
  }
</style>
