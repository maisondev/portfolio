---
interface Props {
  text: string;
  variant?: 'primary' | 'secondary';
}

const { text, variant = 'secondary' } = Astro.props;

const variantClasses = {
  primary: 'bg-accent-500/10 text-accent-400 border border-accent-500/30',
  secondary: 'bg-[#1a1a1a] text-[#d4d4d8] border border-[#2a2a2a]',
};
---

<span class={`inline-block px-3 py-1 rounded-full text-sm font-medium ${variantClasses[variant]}`}>
  {text}
</span>
