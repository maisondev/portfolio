---
interface Props {
  text: string;
  variant?: 'primary' | 'secondary';
}

const { text, variant = 'secondary' } = Astro.props;

const variantClasses = {
  primary: 'bg-surface-2 text-primary border border-primary/30',
  secondary: 'bg-surface-2 text-ink-subtle border border-hairline',
};
---

<span class={`inline-block px-3 py-1.5 rounded-md text-caption font-medium ${variantClasses[variant]}`}>
  {text}
</span>
