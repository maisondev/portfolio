---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'tertiary';
  target?: string;
  rel?: string;
  class?: string;
  title?: string;
}

const { href, variant = 'primary', target, rel, class: className, title } = Astro.props;

const baseClasses = 'transition-all duration-300 inline-block font-sans text-button py-2 px-3.5 rounded-md';
const variantClasses = {
  primary: 'bg-primary text-white hover:bg-primary-hover focus:outline-2 focus:outline-offset-2 focus:outline-primary-focus active:scale-95',
  secondary: 'bg-surface-1 text-ink border border-hairline hover:bg-surface-2 hover:text-ink hover:border-hairline-strong focus:outline-2 focus:outline-offset-2 focus:outline-primary-focus active:scale-95',
  tertiary: 'bg-canvas text-ink hover:bg-surface-1 hover:text-ink focus:outline-2 focus:outline-offset-2 focus:outline-primary-focus active:scale-95',
};
---

<a href={href} target={target} rel={rel} title={title} class={`${baseClasses} ${variantClasses[variant]} ${className || ''}`}>
  <slot />
</a>
