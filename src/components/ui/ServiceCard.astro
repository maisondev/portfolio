---
import type { Service } from '@/config/services';
import { getServiceIcon } from '@/utils/serviceIcons';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const icon = getServiceIcon(service.icon);
---

<a
  href={service.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative overflow-hidden rounded-lg border border-gray-700 bg-gray-900/50 backdrop-blur-sm transition-all duration-300 hover:border-gray-500 hover:bg-gray-800/80"
>
  <!-- Background gradient effect -->
  <div
    class={`absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-10 bg-gradient-to-br ${service.color}`}
  >
  </div>

  <!-- Content -->
  <div class="relative p-6 flex flex-col items-center justify-center text-center h-full min-h-[180px]">
    <!-- Icon -->
    <div
      class={`mb-4 w-14 h-14 rounded-lg flex items-center justify-center bg-gradient-to-br ${service.color} transition-transform duration-300 group-hover:scale-110 group-hover:shadow-lg`}
    >
      <Fragment set:html={icon} />
    </div>

    <!-- Name -->
    <h4 class="text-lg font-semibold text-gray-100 mb-2 transition-colors duration-300 group-hover:text-white">
      {service.name}
    </h4>

    <!-- Description -->
    {service.description && (
      <p class="text-sm text-gray-400 transition-colors duration-300 group-hover:text-gray-300">
        {service.description}
      </p>
    )}

    <!-- Arrow indicator -->
    <div class="mt-3 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0 translate-y-2">
      <svg
        class="w-4 h-4 text-gray-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 7l5 5m0 0l-5 5m5-5H6"
        />
      </svg>
    </div>
  </div>
</a>
