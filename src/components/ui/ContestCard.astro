---
import Card from './Card.astro';
import { type Contest } from '@/config/contests';
import { Trophy, CheckCircle2, FileText } from '@lucide/astro';
import { type Language } from '@/i18n/utils';

interface Props {
  contest: Contest;
  lang?: Language;
}

const { contest, lang = 'pt' } = Astro.props;

// Calcular valores localmente em vez de receber como props
const getPositionCategory = (position: string) => {
  if (/desenvolvimento|desenvolvedor/i.test(position)) {
    return 'Desenvolvedor';
  }
  const especialidadeMatch = position.match(/Especialidad[ae]\s+([^,\n]+)/i);
  if (especialidadeMatch) {
    return especialidadeMatch[1].trim().split(/\s+/)[0];
  }
  const words = position.split(/[\s,-]+/);
  return words[0];
};

const classNum = contest.classification ? parseInt(contest.classification.split('º')[0]) : 0;
const isFirstPlace = classNum <= (contest.totalVacancies || 0);
const badgeType = isFirstPlace ? 'edital' : 'cadastro_reserva';
const statusType = classNum > (contest.totalVacancies || 0) ? 'reserva' : 'vagas';

const hasDocuments = contest.documents && contest.documents.length > 0;

const labelField = 'text-xs font-semibold text-ink-muted dark:text-ink-muted uppercase tracking-widest';
const valueField = 'text-sm text-ink dark:text-white mt-1.5';

const cardVariant = isFirstPlace ? 'accent' : 'primary';
const cardClass = isFirstPlace
  ? 'hover:shadow-lg dark:hover:shadow-lg/20'
  : 'hover:shadow-lg dark:hover:shadow-lg/20';
---

<Card
  variant={cardVariant}
  class={`p-6 ${cardClass}`}
  data-year={contest.year}
  data-banca={contest.banca}
  data-org={contest.organization}
  data-position={getPositionCategory(contest.position)}
  data-sphere={contest.sphere}
  data-status={statusType}
  data-ranking={contest.classification || ''}
  data-salary={contest.salary || ''}
>
  {/* Header */}
  <div class="space-y-3 pb-4 border-b border-hairline dark:border-hairline">
    <div class="flex items-start justify-between gap-3">
      <div class="flex-1 space-y-2.5">
        <div class="flex items-start gap-2.5">
          {badgeType === 'edital' ? (
            <Trophy
              class="w-5 h-5 text-accent-500 flex-shrink-0 mt-1"
              title={lang === 'pt' ? 'Vagas Diretas' : 'Direct Vacancies'}
            />
          ) : (
            <FileText
              class="w-5 h-5 text-primary flex-shrink-0 mt-1"
              title={lang === 'pt' ? 'Cadastro de Reserva' : 'Reserve List'}
            />
          )}
          <h3 class="text-base font-bold text-ink dark:text-white leading-tight">
            {contest.position}
          </h3>
        </div>

        {/* Órgão */}
        <div>
          <p class={labelField}>
            {lang === 'pt' ? 'Órgão' : 'Agency'}
          </p>
          <p class={valueField}>{contest.organization}</p>
        </div>
      </div>

      {/* Badge */}
      {badgeType && (
        <div class="flex-shrink-0">
          {badgeType === 'edital' ? (
            <div
              class="bg-semantic-success dark:bg-semantic-success text-white dark:text-white px-3 py-2 rounded-md text-xs font-bold flex items-center gap-2 min-w-max hover:brightness-110 dark:hover:brightness-110 transition-all border border-semantic-success dark:border-semantic-success"
              title={lang === 'pt'
                ? 'Aprovado nas vagas diretas'
                : 'Approved in direct vacancies'}
            >
              <CheckCircle2 class="w-4 h-4 text-white dark:text-white flex-shrink-0" />
              <span>{lang === 'pt' ? 'Vagas' : 'Direct'}</span>
            </div>
          ) : (
            <div
              class="bg-primary dark:bg-primary text-white dark:text-white px-3 py-2 rounded-md text-xs font-bold flex items-center gap-2 min-w-max hover:bg-primary-hover dark:hover:bg-primary-hover transition-colors border border-primary-700 dark:border-primary-400"
              title={lang === 'pt'
                ? 'Aprovado em cadastro de reserva'
                : 'Approved in reserve list'}
            >
              <FileText class="w-4 h-4 text-white dark:text-white flex-shrink-0" />
              <span>{lang === 'pt' ? 'Reserva' : 'Reserve'}</span>
            </div>
          )}
        </div>
      )}
    </div>
  </div>

  {/* Details Section */}
  <div class="flex-grow py-3">
    {/* Banca, Ano, Ranking, Vagas e Salário - Grid 3 colunas */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-1">
      {/* Coluna 1: Banca */}
      <div>
        <p class={labelField}>
          {lang === 'pt' ? 'Banca' : 'Organization'}
        </p>
        {contest.concursoLink ? (
          <a
            href={contest.concursoLink}
            target="_blank"
            rel="noopener noreferrer"
            class={`${valueField} text-primary hover:text-primary-hover dark:text-primary dark:hover:text-primary-hover transition-colors inline-block underline decoration-1 underline-offset-2`}
          >
            {contest.banca || '—'}
          </a>
        ) : (
          <p class={valueField}>{contest.banca || '—'}</p>
        )}
      </div>

      {/* Coluna 2: Ano */}
      <div>
        <p class={labelField}>
          {lang === 'pt' ? 'Ano' : 'Year'}
        </p>
        <p class={valueField}>{contest.year || '—'}</p>
      </div>

      {/* Coluna 3: Esfera */}
      <div>
        <p class={labelField}>
          {lang === 'pt' ? 'Esfera' : 'Sphere'}
        </p>
        <p class={valueField}>{contest.sphere || '—'}</p>
      </div>

      {/* Coluna 1: Ranking */}
      <div class="border-t border-hairline/50 dark:border-hairline/50 md:border-t-0 pt-3 md:pt-0">
        <p class={labelField}>
          {lang === 'pt' ? 'Ranking' : 'Ranking'}
        </p>
        <p class={valueField}>{contest.classification || '—'}</p>
      </div>

      {/* Coluna 2: Vagas */}
      <div class="border-t border-hairline/50 dark:border-hairline/50 md:border-t-0 pt-3 md:pt-0">
        <p class={labelField}>
          {lang === 'pt' ? 'Vagas' : 'Vacancies'}
        </p>
        <p class={valueField}>{contest.totalVacancies || '—'}</p>
      </div>

      {/* Coluna 3: Salário */}
      {contest.salary && (
        <div class="border-t border-hairline/50 dark:border-hairline/50 md:border-t-0 pt-3 md:pt-0">
          <p class={labelField}>
            {lang === 'pt' ? 'Salário' : 'Salary'}
          </p>
          <p class={valueField}>{contest.salary || '—'}</p>
        </div>
      )}
    </div>
  </div>

  {/* Documents Section */}
  <div class="pt-4 border-t border-hairline dark:border-hairline">
    <p class={labelField}>
      {lang === 'pt' ? 'Documentos' : 'Documents'}
    </p>
    {hasDocuments && contest.documents!.length > 0 ? (
      <div class="flex flex-wrap gap-2 mt-3">
        {contest.documents!.map((doc) => (
          <button
            class="doc-btn inline-flex items-center gap-2 bg-surface-2 dark:bg-surface-3 hover:bg-surface-3 dark:hover:bg-surface-4 text-primary dark:text-primary hover:text-primary-hover dark:hover:text-primary-hover text-xs px-3 py-2 rounded-md transition-colors font-medium"
            data-doc-title={doc.title}
            data-doc-url={doc.url}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-4 h-4 flex-shrink-0"
            >
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
              <polyline points="17 21 17 13 7 13 7 21" />
              <polyline points="7 3 7 8 15 8" />
            </svg>
            <span>{doc.title}</span>
          </button>
        ))}
      </div>
    ) : (
      <p class="text-xs text-ink-muted dark:text-ink-muted mt-2">—</p>
    )}
  </div>
</Card>
