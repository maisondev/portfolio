---
import { courses, getAllTechnologies } from '@/config/courses';
import CourseCard from './CourseCard.astro';
import CoursesSort from './CoursesSort.astro';

const allTechnologies = getAllTechnologies();

interface Props {
  lang?: string;
}

const { lang = 'pt' } = Astro.props;

const monthMap: Record<string, number> = {
  jan: 0, fev: 1, mar: 2, abr: 3, mai: 4, jun: 5,
  jul: 6, ago: 7, set: 8, out: 9, nov: 10, dez: 11,
};

const parseDate = (completedAt: string): number => {
  const [month, year] = completedAt.split(' ');
  return new Date(parseInt(year), monthMap[month] ?? 0).getTime();
};

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};

// Extract unique institutions
const allInstitutions = Array.from(
  new Set(courses.map((course) => course.platform))
).sort();

// Extract unique years from courses
const allYears = Array.from(
  new Set(
    courses.map((course) => {
      const [, year] = course.completedAt.split(' ');
      return parseInt(year);
    })
  )
).sort((a, b) => b - a); // Sort descending (newest first)

// Build full URL with localization
const buildFilterUrl = (tech?: string, inst?: string, year?: string) => {
  const parts = [];
  if (tech) parts.push(`tech=${encodeURIComponent(tech)}`);
  if (inst) parts.push(`inst=${encodeURIComponent(inst)}`);
  if (year) parts.push(`year=${encodeURIComponent(year)}`);
  const query = parts.length > 0 ? `?${parts.join('&')}` : '';
  return `${getLocalizedPath('/courses')}${query}`;
};
---

<div class="space-y-6" data-courses-filter>
  <!-- Sort Controls Component -->
  <CoursesSort lang={lang} />

  <!-- Filters Accordion Toggle -->
  <button
    id="filters-toggle"
    class="w-full flex items-center justify-between px-4 py-3 rounded-lg border border-hairline bg-surface-1 hover:bg-surface-2 text-ink font-medium transition-all"
  >
    <span>{lang === 'pt' ? 'Filtros' : 'Filters'}</span>
    <svg class="w-5 h-5 transition-transform" id="toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>

  <!-- Filters Section (Hidden by default) -->
  <div class="space-y-6 hidden" id="filters-section" data-filters-section>
    <!-- Search Input -->
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-ink uppercase tracking-wide">
        {lang === 'pt' ? 'Buscar' : 'Search'}
      </h3>
      <input
        type="text"
        id="course-search"
        placeholder={lang === 'pt' ? 'Buscar curso por nome...' : 'Search course by name...'}
        class="w-full px-4 py-2.5 rounded-lg border border-hairline bg-surface-1 text-ink placeholder:text-ink-subtle focus:outline-none focus:border-primary/50 transition-colors"
      />
    </div>

    <!-- Filter by Technology -->
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-ink uppercase tracking-wide">
        {lang === 'pt' ? 'Filtrar por tecnologia' : 'Filter by technology'}
      </h3>
      <div class="flex flex-wrap gap-2" data-tech-filters>
        <button
          data-filter-tech=""
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-primary text-white"
        >
          {lang === 'pt' ? `Todas (${courses.length})` : `All (${courses.length})`}
        </button>
        {allTechnologies
          .map((tech) => {
            const count = courses.filter((course) =>
              course.technologies.some(
                (t) => t.toLowerCase() === tech.toLowerCase()
              )
            ).length;
            return { tech, count };
          })
          .sort((a, b) => b.count - a.count)
          .map(({ tech, count }) => (
            <button
              data-filter-tech={tech}
              class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-surface-1 text-ink-muted border border-hairline hover:border-primary/50"
            >
              {tech} ({count})
            </button>
          ))}
      </div>
    </div>

    <!-- Filter by Institution -->
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-ink uppercase tracking-wide">
        {lang === 'pt' ? 'Filtrar por instituição' : 'Filter by institution'}
      </h3>
      <div class="flex flex-wrap gap-2" data-inst-filters>
        <button
          data-filter-inst=""
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-primary text-white"
        >
          {lang === 'pt' ? `Todas (${allInstitutions.length})` : `All (${allInstitutions.length})`}
        </button>
        {allInstitutions.map((institution) => {
          const count = courses.filter((course) =>
            course.platform.toLowerCase() === institution.toLowerCase()
          ).length;

          return (
            <button
              data-filter-inst={institution}
              class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-surface-1 text-ink-muted border border-hairline hover:border-primary/50"
            >
              {institution} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <!-- Filter by Year -->
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-ink uppercase tracking-wide">
        {lang === 'pt' ? 'Filtrar por ano' : 'Filter by year'}
      </h3>
      <div class="flex flex-wrap gap-2" data-year-filters>
        <button
          data-filter-year=""
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-primary text-white"
        >
          {lang === 'pt' ? `Todos (${allYears.length})` : `All (${allYears.length})`}
        </button>
        {allYears.map((year) => {
          const count = courses.filter((course) => {
            const [, courseYear] = course.completedAt.split(' ');
            return parseInt(courseYear) === year;
          }).length;

          return (
            <button
              data-filter-year={year}
              class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-surface-1 text-ink-muted border border-hairline hover:border-primary/50"
            >
              {year} ({count})
            </button>
          );
        })}
      </div>
    </div>
  </div>
</div>

  <!-- Courses Grid -->
  <div>
    <p class="text-sm text-ink-muted mb-4" data-filter-summary>
      {lang === 'pt' ? `Total: ${courses.length} cursos` : `Total: ${courses.length} courses`}
    </p>

    <div id="courses-grid-wrapper" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-4 gap-4" data-courses-container>
        {courses.map((course) => (
          <div data-course={JSON.stringify({ name: course.name.toLowerCase(), technologies: course.technologies, platform: course.platform, year: parseInt(course.completedAt.split(' ')[1]) })} data-date={parseDate(course.completedAt)} data-year={parseInt(course.completedAt.split(' ')[1])}>
            <CourseCard course={course} lang={lang} />
          </div>
        ))}
      </div>
    </div>

    <div class="hidden text-center py-12 rounded-lg border border-hairline bg-surface-1/50" data-no-results>
      <p class="text-ink-muted">
        {lang === 'pt' ? 'Nenhum curso encontrado com os filtros selecionados' : 'No courses found with the selected filters'}
      </p>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="flex items-center justify-center gap-2 mt-10 flex-wrap hidden">
      <!-- Buttons generated by script -->
    </div>
  </div>

<script define:vars={{courses, lang}}>
  const PAGE_SIZE = 20;
  const filterContainer = document.querySelector('[data-courses-filter]');
  const filtersSection = document.getElementById('filters-section');
  const filtersToggle = document.getElementById('filters-toggle');
  const toggleIcon = document.getElementById('toggle-icon');
  let coursesContainer = document.querySelector('[data-courses-container]');
  const noResults = document.querySelector('[data-no-results]');
  const filterSummary = document.querySelector('[data-filter-summary]');
  const techButtons = filterContainer?.querySelectorAll('[data-filter-tech]');
  const instButtons = filterContainer?.querySelectorAll('[data-filter-inst]');
  const yearButtons = filterContainer?.querySelectorAll('[data-filter-year]');
  const sortButtons = document.querySelectorAll('[data-sort-buttons] .sort-btn');
  const searchInput = document.getElementById('course-search');
  const paginationContainer = document.getElementById('pagination');

  // Filters toggle functionality
  if (filtersToggle && filtersSection) {
    filtersToggle.addEventListener('click', () => {
      filtersSection.classList.toggle('hidden');
      toggleIcon?.classList.toggle('rotate-180');
    });
  }

  // Parse courses from data attributes
  const allCourses = [];
  const courseCards = new Map();
  const coursesWrapper = coursesContainer?.parentElement;
  coursesContainer?.querySelectorAll('[data-course]').forEach((card, index) => {
    const data = JSON.parse(card.getAttribute('data-course') || '{}');
    allCourses.push(data);
    courseCards.set(index, card);
    // Adicionar ID único para rastreamento após reorganização
    card.setAttribute('data-card-index', index.toString());
  });

  if (filterContainer) {
    let params = new URLSearchParams(window.location.search);
    let selectedTech = params.get('tech') || '';
    let selectedInst = params.get('inst') || '';
    let selectedYear = params.get('year') || '';
    let searchQuery = '';
    let currentPage = parseInt(params.get('page') || '0');
    let sortOrder = params.get('sort') || 'desc';

    // Get available technologies based on current institution and year filter
    const getAvailableTechs = (inst = '', year = '') => {
      const techs = new Set();
      allCourses.forEach((course) => {
        const instMatch = !inst || course.platform.toLowerCase() === inst.toLowerCase();
        const yearMatch = !year || course.year === parseInt(year);
        if (instMatch && yearMatch) {
          course.technologies?.forEach((t) => techs.add(t));
        }
      });
      return Array.from(techs).sort();
    };

    // Get available institutions based on current tech and year filter
    const getAvailableInsts = (tech = '', year = '') => {
      const insts = new Set();
      allCourses.forEach((course) => {
        const techMatch = !tech || course.technologies?.some((t) => t.toLowerCase() === tech.toLowerCase());
        const yearMatch = !year || course.year === parseInt(year);
        if (techMatch && yearMatch) {
          insts.add(course.platform);
        }
      });
      return Array.from(insts).sort();
    };

    // Get available years based on current tech and institution filter
    const getAvailableYears = (tech = '', inst = '') => {
      const years = new Set();
      allCourses.forEach((course) => {
        const techMatch = !tech || course.technologies?.some((t) => t.toLowerCase() === tech.toLowerCase());
        const instMatch = !inst || course.platform.toLowerCase() === inst.toLowerCase();
        if (techMatch && instMatch) {
          years.add(course.year);
        }
      });
      return Array.from(years).sort((a, b) => b - a);
    };

    // Helper para encontrar todos os cards independente da estrutura
    const getAllCards = () => {
      return Array.from(coursesWrapper?.querySelectorAll('[data-course]') || coursesContainer?.querySelectorAll('[data-course]') || []);
    };

    const sortCards = () => {
      let currentCards = getAllCards();

      currentCards.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date') || '0');
        const dateB = parseInt(b.getAttribute('data-date') || '0');
        return sortOrder === 'desc' ? dateB - dateA : dateA - dateB;
      });

      const originalGrid = coursesContainer;
      originalGrid.innerHTML = '';

      currentCards.forEach(card => {
        originalGrid.appendChild(card);
      });

      coursesContainer = originalGrid;
    };

    const renderPagination = (visibleCards) => {
      const totalPages = Math.ceil(visibleCards.length / PAGE_SIZE);

      if (paginationContainer) {
        paginationContainer.innerHTML = '';

        if (totalPages > 1) {
          paginationContainer.classList.remove('hidden');

          for (let i = 0; i < totalPages; i++) {
            const btn = document.createElement('button');
            btn.textContent = i + 1;
            btn.className = `px-3 py-2 rounded text-sm font-medium transition-all ${
              i === currentPage
                ? 'bg-primary text-white'
                : 'border border-hairline bg-surface-1 text-ink-muted hover:border-primary/50'
            }`;

            btn.addEventListener('click', () => {
              currentPage = i;
              const newParams = new URLSearchParams();
              if (selectedTech) newParams.set('tech', selectedTech);
              if (selectedInst) newParams.set('inst', selectedInst);
              if (selectedYear) newParams.set('year', selectedYear);
              if (searchQuery) newParams.set('search', searchQuery);
              if (sortOrder !== 'desc') newParams.set('sort', sortOrder);
              if (currentPage > 0) newParams.set('page', currentPage);
              const query = newParams.toString();
              window.history.pushState({}, '', query ? `?${query}` : '');
              updateUI();
              window.scrollTo({ top: coursesContainer?.offsetTop || 0, behavior: 'smooth' });
            });

            paginationContainer.appendChild(btn);
          }
        } else {
          paginationContainer.classList.add('hidden');
        }
      }
    };

    const updateUI = () => {
      const availableTechs = getAvailableTechs(selectedInst, selectedYear);
      const availableInsts = getAvailableInsts(selectedTech, selectedYear);
      const availableYears = getAvailableYears(selectedTech, selectedInst);

      // Update tech buttons
      techButtons?.forEach((btn) => {
        const tech = btn.getAttribute('data-filter-tech');
        const isAvailable = !tech || availableTechs.includes(tech);
        const isSelected = tech === selectedTech;

        if (isSelected) {
          btn.classList.add('bg-primary', 'text-white');
          btn.classList.remove('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = false;
        } else if (isAvailable) {
          btn.classList.remove('bg-primary', 'text-white', 'opacity-50', 'cursor-not-allowed');
          btn.classList.add('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline');
          btn.disabled = false;
        } else {
          btn.classList.remove('bg-primary', 'text-white');
          btn.classList.add('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = true;
        }
      });

      // Update institution buttons
      instButtons?.forEach((btn) => {
        const inst = btn.getAttribute('data-filter-inst');
        const isAvailable = !inst || availableInsts.includes(inst);
        const isSelected = inst === selectedInst;

        if (isSelected) {
          btn.classList.add('bg-primary', 'text-white');
          btn.classList.remove('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = false;
        } else if (isAvailable) {
          btn.classList.remove('bg-primary', 'text-white', 'opacity-50', 'cursor-not-allowed');
          btn.classList.add('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline');
          btn.disabled = false;
        } else {
          btn.classList.remove('bg-primary', 'text-white');
          btn.classList.add('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = true;
        }
      });

      // Update year buttons
      yearButtons?.forEach((btn) => {
        const year = btn.getAttribute('data-filter-year');
        const isAvailable = !year || availableYears.includes(parseInt(year));
        const isSelected = year === selectedYear;

        if (isSelected) {
          btn.classList.add('bg-primary', 'text-white');
          btn.classList.remove('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = false;
        } else if (isAvailable) {
          btn.classList.remove('bg-primary', 'text-white', 'opacity-50', 'cursor-not-allowed');
          btn.classList.add('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline');
          btn.disabled = false;
        } else {
          btn.classList.remove('bg-primary', 'text-white');
          btn.classList.add('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = true;
        }
      });

      // Filter courses
      let visibleCount = 0;
      const visibleCards = [];

      getAllCards().forEach((card) => {
        const cardIndex = parseInt(card.getAttribute('data-card-index') || '0');
        const data = JSON.parse(card.getAttribute('data-course') || '{}');
        const technologies = data.technologies || [];
        const platform = data.platform || '';
        const courseName = data.name || '';
        const year = data.year;

        const techMatch = !selectedTech ||
          technologies.some((t) => t.toLowerCase() === selectedTech.toLowerCase());

        const instMatch = !selectedInst ||
          platform.toLowerCase() === selectedInst.toLowerCase();

        const yearMatch = !selectedYear ||
          year === parseInt(selectedYear);

        const searchMatch = !searchQuery ||
          courseName.includes(searchQuery.toLowerCase());

        if (techMatch && instMatch && yearMatch && searchMatch) {
          visibleCards.push({ card, index: cardIndex });
          visibleCount++;
        }
      });

      // Apply pagination: show/hide cards
      const startIdx = currentPage * PAGE_SIZE;
      const endIdx = startIdx + PAGE_SIZE;
      const paginatedVisibleCards = visibleCards.slice(startIdx, endIdx);
      const paginatedVisibleIndices = new Set(paginatedVisibleCards.map(v => v.index));

      getAllCards().forEach((card) => {
        const cardIndex = parseInt(card.getAttribute('data-card-index') || '0');
        if (paginatedVisibleIndices.has(cardIndex)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Render pagination buttons
      renderPagination(visibleCards);

      // Update summary
      const filters = [];
      if (selectedTech) filters.push(`"${selectedTech}"`);
      if (selectedInst) filters.push(`"${selectedInst}"`);
      if (selectedYear) filters.push(`"${selectedYear}"`);

      if (filterSummary) {
        const isPt = lang === 'pt';
        const isTechSort = sortOrder === 'tech';
        const unitWord = isTechSort ? (isPt ? 'tecnologia(s)' : 'technolog(ies)') : (isPt ? 'curso(s)' : 'course(s)');
        const courseWord = (n) => unitWord;
        if (filters.length === 0) {
          if (searchQuery) {
            filterSummary.textContent = isPt
              ? `Encontrados ${visibleCount} ${courseWord()} com "${searchQuery}"`
              : `Found ${visibleCount} ${courseWord()} matching "${searchQuery}"`;
          } else {
            filterSummary.textContent = isPt
              ? `Total: ${visibleCount} ${isTechSort ? 'tecnologias' : 'cursos'}`
              : `Total: ${visibleCount} ${isTechSort ? 'technologies' : 'courses'}`;
          }
        } else if (filters.length === 1) {
          if (searchQuery) {
            filterSummary.textContent = isPt
              ? `Mostrando ${visibleCount} ${courseWord()} de ${filters[0]} com "${searchQuery}"`
              : `Showing ${visibleCount} ${courseWord()} from ${filters[0]} matching "${searchQuery}"`;
          } else {
            filterSummary.textContent = isPt
              ? `Mostrando ${visibleCount} ${courseWord()} de ${filters[0]}`
              : `Showing ${visibleCount} ${courseWord()} from ${filters[0]}`;
          }
        } else {
          if (searchQuery) {
            filterSummary.textContent = isPt
              ? `Mostrando ${visibleCount} ${courseWord()} de ${filters.join(' + ')} com "${searchQuery}"`
              : `Showing ${visibleCount} ${courseWord()} from ${filters.join(' + ')} matching "${searchQuery}"`;
          } else {
            filterSummary.textContent = isPt
              ? `Mostrando ${visibleCount} ${courseWord()} de ${filters.join(' + ')}`
              : `Showing ${visibleCount} ${courseWord()} from ${filters.join(' + ')}`;
          }
        }
      }

      // Show/hide no results
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    };

    // Add search input listener
    if (searchInput) {
      searchInput.value = params.get('search') || '';
      searchQuery = searchInput.value.toLowerCase();

      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase();
        currentPage = 0;
        const newParams = new URLSearchParams();
        if (selectedTech) newParams.set('tech', selectedTech);
        if (selectedInst) newParams.set('inst', selectedInst);
        if (selectedYear) newParams.set('year', selectedYear);
        if (searchQuery) newParams.set('search', searchQuery);
        if (sortOrder !== 'desc') newParams.set('sort', sortOrder);
        const query = newParams.toString();
        window.history.pushState({}, '', query ? `?${query}` : '');
        updateUI();
      });
    }

    // Update sort buttons visual state
    const updateSortButtons = () => {
      sortButtons?.forEach((btn) => {
        const btnSort = btn.getAttribute('data-sort');
        if (btnSort === sortOrder) {
          btn.classList.add('bg-primary', 'text-white');
          btn.classList.remove('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline');
          btn.disabled = false;
        } else {
          btn.classList.remove('bg-primary', 'text-white');
          btn.classList.add('bg-surface-1', 'text-ink-muted', 'border', 'border-hairline');
          btn.disabled = false;
        }
      });
    };

    // Add sort button listeners
    sortButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        sortOrder = btn.getAttribute('data-sort') || 'desc';
        currentPage = 0;
        const newParams = new URLSearchParams();
        if (selectedTech) newParams.set('tech', selectedTech);
        if (selectedInst) newParams.set('inst', selectedInst);
        if (selectedYear) newParams.set('year', selectedYear);
        if (searchQuery) newParams.set('search', searchQuery);
        if (sortOrder !== 'desc') newParams.set('sort', sortOrder);
        const query = newParams.toString();
        window.history.pushState({}, '', query ? `?${query}` : '');

        // Show loading overlay
        window.showLoading(lang === 'pt' ? 'Reordenando cursos...' : 'Reordering courses...');

        // Use requestAnimationFrame para garantir que o loading apareça antes do processamento
        requestAnimationFrame(() => {
          setTimeout(() => {
            sortCards();
            updateSortButtons();
            updateUI();

            // Hide loading overlay imediatamente após processamento
            window.hideLoading();
          }, 0);
        });
      });
    });

    // Add click handlers to buttons
    techButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.disabled) {
          selectedTech = btn.getAttribute('data-filter-tech') || '';
          currentPage = 0;
          const newParams = new URLSearchParams();
          if (selectedTech) newParams.set('tech', selectedTech);
          if (selectedInst) newParams.set('inst', selectedInst);
          if (selectedYear) newParams.set('year', selectedYear);
          if (searchQuery) newParams.set('search', searchQuery);
          if (sortOrder !== 'desc') newParams.set('sort', sortOrder);
          const query = newParams.toString();
          window.history.pushState({}, '', query ? `?${query}` : '');
          updateUI();
        }
      });
    });

    instButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.disabled) {
          selectedInst = btn.getAttribute('data-filter-inst') || '';
          currentPage = 0;
          const newParams = new URLSearchParams();
          if (selectedTech) newParams.set('tech', selectedTech);
          if (selectedInst) newParams.set('inst', selectedInst);
          if (selectedYear) newParams.set('year', selectedYear);
          if (searchQuery) newParams.set('search', searchQuery);
          if (sortOrder !== 'desc') newParams.set('sort', sortOrder);
          const query = newParams.toString();
          window.history.pushState({}, '', query ? `?${query}` : '');
          updateUI();
        }
      });
    });

    // Add click handlers to year buttons
    yearButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.disabled) {
          selectedYear = btn.getAttribute('data-filter-year') || '';
          currentPage = 0;
          const newParams = new URLSearchParams();
          if (selectedTech) newParams.set('tech', selectedTech);
          if (selectedInst) newParams.set('inst', selectedInst);
          if (selectedYear) newParams.set('year', selectedYear);
          if (searchQuery) newParams.set('search', searchQuery);
          if (sortOrder !== 'desc') newParams.set('sort', sortOrder);
          const query = newParams.toString();
          window.history.pushState({}, '', query ? `?${query}` : '');
          updateUI();
        }
      });
    });

    // Initial sort and update
    updateSortButtons();
    sortCards();
    updateUI();
  }
</script>
