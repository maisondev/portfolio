---
import { courses, getAllTechnologies } from '@/config/courses';
import CourseCard from './CourseCard.astro';

const allTechnologies = getAllTechnologies();

interface Props {
  lang?: string;
}

const { lang = 'pt' } = Astro.props;

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};

// Extract unique institutions
const allInstitutions = Array.from(
  new Set(courses.map((course) => course.platform))
).sort();

// Build full URL with localization
const buildFilterUrl = (tech?: string, inst?: string) => {
  const parts = [];
  if (tech) parts.push(`tech=${encodeURIComponent(tech)}`);
  if (inst) parts.push(`inst=${encodeURIComponent(inst)}`);
  const query = parts.length > 0 ? `?${parts.join('&')}` : '';
  return `${getLocalizedPath('/courses')}${query}`;
};
---

<div class="space-y-8" data-courses-filter>
  <!-- Search Box -->
  <div>
    <input
      type="text"
      id="course-search"
      placeholder="Buscar curso por nome..."
      class="w-full px-4 py-2.5 rounded-lg border border-[#2a2a2a] bg-[#1a1a1a] text-[#fafafa] placeholder:text-[#71717a] focus:outline-none focus:border-accent-500/50 transition-colors"
    />
  </div>

  <!-- Filters Section -->
  <div class="space-y-6">
    <!-- Filter by Technology -->
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-[#fafafa] uppercase tracking-wide">
        Filtrar por tecnologia
      </h3>
      <div class="flex flex-wrap gap-2" data-tech-filters>
        <button
          data-filter-tech=""
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-accent-500 text-[#0a0a0a]"
        >
          Todas ({courses.length})
        </button>
        {allTechnologies.map((tech) => {
          const count = courses.filter((course) =>
            course.technologies.some(
              (t) => t.toLowerCase() === tech.toLowerCase()
            )
          ).length;

          return (
            <button
              data-filter-tech={tech}
              class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-[#1a1a1a] text-[#d4d4d8] border border-[#2a2a2a] hover:border-accent-500/50"
            >
              {tech} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <!-- Filter by Institution -->
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-[#fafafa] uppercase tracking-wide">
        Filtrar por instituição
      </h3>
      <div class="flex flex-wrap gap-2" data-inst-filters>
        <button
          data-filter-inst=""
          class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-accent-500 text-[#0a0a0a]"
        >
          Todas ({allInstitutions.length})
        </button>
        {allInstitutions.map((institution) => {
          const count = courses.filter((course) =>
            course.platform.toLowerCase() === institution.toLowerCase()
          ).length;

          return (
            <button
              data-filter-inst={institution}
              class="filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-[#1a1a1a] text-[#d4d4d8] border border-[#2a2a2a] hover:border-accent-500/50"
            >
              {institution} ({count})
            </button>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Courses Grid -->
  <div>
    <p class="text-sm text-[#d4d4d8] mb-4" data-filter-summary>
      Total: {courses.length} cursos
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-courses-grid>
      {courses.map((course) => (
        <div data-course={JSON.stringify({ technologies: course.technologies, platform: course.platform })}>
          <CourseCard course={course} />
        </div>
      ))}
    </div>

    <div class="hidden text-center py-12 rounded-lg border border-[#2a2a2a] bg-[#1a1a1a]/50" data-no-results>
      <p class="text-[#d4d4d8]">
        Nenhum curso encontrado com os filtros selecionados
      </p>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="flex items-center justify-center gap-2 mt-10 flex-wrap hidden">
      <!-- Buttons generated by script -->
    </div>
  </div>
</div>

<script define:vars={{courses}}>
  const PAGE_SIZE = 48;
  const filterContainer = document.querySelector('[data-courses-filter]');
  const coursesGrid = filterContainer?.querySelector('[data-courses-grid]');
  const noResults = filterContainer?.querySelector('[data-no-results]');
  const filterSummary = filterContainer?.querySelector('[data-filter-summary]');
  const techButtons = filterContainer?.querySelectorAll('[data-filter-tech]');
  const instButtons = filterContainer?.querySelectorAll('[data-filter-inst]');
  const searchInput = document.getElementById('course-search');
  const paginationContainer = document.getElementById('pagination');

  // Parse courses from data attributes
  const allCourses = [];
  const courseCards = new Map();
  coursesGrid?.querySelectorAll('[data-course]').forEach((card, index) => {
    const data = JSON.parse(card.getAttribute('data-course') || '{}');
    allCourses.push(data);
    courseCards.set(index, card);
  });

  // Get course name from the actual course object
  const getCourseNames = () => {
    const names = new Map();
    coursesGrid?.querySelectorAll('[data-course]').forEach((card, index) => {
      const courseObj = courses[index];
      if (courseObj) {
        names.set(index, courseObj.name.toLowerCase());
      }
    });
    return names;
  };

  const courseNames = getCourseNames();

  if (filterContainer) {
    let params = new URLSearchParams(window.location.search);
    let selectedTech = params.get('tech') || '';
    let selectedInst = params.get('inst') || '';
    let searchQuery = '';
    let currentPage = parseInt(params.get('page') || '0');

    // Get available technologies based on current institution filter
    const getAvailableTechs = (inst = '') => {
      const techs = new Set();
      allCourses.forEach((course) => {
        if (!inst || course.platform.toLowerCase() === inst.toLowerCase()) {
          course.technologies?.forEach((t) => techs.add(t));
        }
      });
      return Array.from(techs).sort();
    };

    // Get available institutions based on current tech filter
    const getAvailableInsts = (tech = '') => {
      const insts = new Set();
      allCourses.forEach((course) => {
        if (!tech || course.technologies?.some((t) => t.toLowerCase() === tech.toLowerCase())) {
          insts.add(course.platform);
        }
      });
      return Array.from(insts).sort();
    };

    const renderPagination = (visibleCards) => {
      const totalPages = Math.ceil(visibleCards.length / PAGE_SIZE);

      if (paginationContainer) {
        paginationContainer.innerHTML = '';

        if (totalPages > 1) {
          paginationContainer.classList.remove('hidden');

          for (let i = 0; i < totalPages; i++) {
            const btn = document.createElement('button');
            btn.textContent = i + 1;
            btn.className = `px-3 py-2 rounded text-sm font-medium transition-all ${
              i === currentPage
                ? 'bg-accent-500 text-[#0a0a0a]'
                : 'border border-[#2a2a2a] bg-[#1a1a1a] text-[#d4d4d8] hover:border-accent-500/50'
            }`;

            btn.addEventListener('click', () => {
              currentPage = i;
              const newParams = new URLSearchParams();
              if (selectedTech) newParams.set('tech', selectedTech);
              if (selectedInst) newParams.set('inst', selectedInst);
              if (searchQuery) newParams.set('search', searchQuery);
              if (currentPage > 0) newParams.set('page', currentPage);
              const query = newParams.toString();
              window.history.pushState({}, '', query ? `?${query}` : '');
              updateUI();
              window.scrollTo({ top: coursesGrid?.offsetTop || 0, behavior: 'smooth' });
            });

            paginationContainer.appendChild(btn);
          }
        } else {
          paginationContainer.classList.add('hidden');
        }
      }
    };

    const updateUI = () => {
      const availableTechs = getAvailableTechs(selectedInst);
      const availableInsts = getAvailableInsts(selectedTech);

      // Update tech buttons
      techButtons?.forEach((btn) => {
        const tech = btn.getAttribute('data-filter-tech');
        const isAvailable = !tech || availableTechs.includes(tech);
        const isSelected = tech === selectedTech;

        if (isSelected) {
          btn.classList.add('bg-accent-500', 'text-[#0a0a0a]');
          btn.classList.remove('bg-[#1a1a1a]', 'text-[#d4d4d8]', 'border', 'border-[#2a2a2a]', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = false;
        } else if (isAvailable) {
          btn.classList.remove('bg-accent-500', 'text-[#0a0a0a]', 'opacity-50', 'cursor-not-allowed');
          btn.classList.add('bg-[#1a1a1a]', 'text-[#d4d4d8]', 'border', 'border-[#2a2a2a]');
          btn.disabled = false;
        } else {
          btn.classList.remove('bg-accent-500', 'text-[#0a0a0a]');
          btn.classList.add('bg-[#1a1a1a]', 'text-[#d4d4d8]', 'border', 'border-[#2a2a2a]', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = true;
        }
      });

      // Update institution buttons
      instButtons?.forEach((btn) => {
        const inst = btn.getAttribute('data-filter-inst');
        const isAvailable = !inst || availableInsts.includes(inst);
        const isSelected = inst === selectedInst;

        if (isSelected) {
          btn.classList.add('bg-accent-500', 'text-[#0a0a0a]');
          btn.classList.remove('bg-[#1a1a1a]', 'text-[#d4d4d8]', 'border', 'border-[#2a2a2a]', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = false;
        } else if (isAvailable) {
          btn.classList.remove('bg-accent-500', 'text-[#0a0a0a]', 'opacity-50', 'cursor-not-allowed');
          btn.classList.add('bg-[#1a1a1a]', 'text-[#d4d4d8]', 'border', 'border-[#2a2a2a]');
          btn.disabled = false;
        } else {
          btn.classList.remove('bg-accent-500', 'text-[#0a0a0a]');
          btn.classList.add('bg-[#1a1a1a]', 'text-[#d4d4d8]', 'border', 'border-[#2a2a2a]', 'opacity-50', 'cursor-not-allowed');
          btn.disabled = true;
        }
      });

      // Filter courses
      let visibleCount = 0;
      const visibleCards = [];
      coursesGrid?.querySelectorAll('[data-course]').forEach((card, index) => {
        const data = JSON.parse(card.getAttribute('data-course') || '{}');
        const technologies = data.technologies || [];
        const platform = data.platform || '';
        const courseName = courseNames.get(index) || '';

        const techMatch = !selectedTech ||
          technologies.some((t) => t.toLowerCase() === selectedTech.toLowerCase());

        const instMatch = !selectedInst ||
          platform.toLowerCase() === selectedInst.toLowerCase();

        const searchMatch = !searchQuery ||
          courseName.includes(searchQuery.toLowerCase());

        if (techMatch && instMatch && searchMatch) {
          visibleCards.push({ card, index });
          visibleCount++;
        }
      });

      // Apply pagination: show/hide cards
      const startIdx = currentPage * PAGE_SIZE;
      const endIdx = startIdx + PAGE_SIZE;
      const paginatedVisibleCards = visibleCards.slice(startIdx, endIdx);
      const paginatedVisibleIndices = new Set(paginatedVisibleCards.map(v => v.index));

      coursesGrid?.querySelectorAll('[data-course]').forEach((card, index) => {
        if (paginatedVisibleIndices.has(index)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Render pagination buttons
      renderPagination(visibleCards);

      // Update summary
      const filters = [];
      if (selectedTech) filters.push(`"${selectedTech}"`);
      if (selectedInst) filters.push(`"${selectedInst}"`);

      if (filterSummary) {
        if (filters.length === 0) {
          if (searchQuery) {
            filterSummary.textContent = `Encontrados ${visibleCount} curso(s) com "${searchQuery}"`;
          } else {
            filterSummary.textContent = `Total: ${visibleCount} cursos`;
          }
        } else if (filters.length === 1) {
          if (searchQuery) {
            filterSummary.textContent = `Mostrando ${visibleCount} curso(s) de ${filters[0]} com "${searchQuery}"`;
          } else {
            filterSummary.textContent = `Mostrando ${visibleCount} curso(s) de ${filters[0]}`;
          }
        } else {
          if (searchQuery) {
            filterSummary.textContent = `Mostrando ${visibleCount} curso(s) de ${filters.join(' + ')} com "${searchQuery}"`;
          } else {
            filterSummary.textContent = `Mostrando ${visibleCount} curso(s) de ${filters.join(' + ')}`;
          }
        }
      }

      // Show/hide no results
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    };

    // Add search input listener
    if (searchInput) {
      searchInput.value = params.get('search') || '';
      searchQuery = searchInput.value.toLowerCase();

      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase();
        currentPage = 0;
        const newParams = new URLSearchParams();
        if (selectedTech) newParams.set('tech', selectedTech);
        if (selectedInst) newParams.set('inst', selectedInst);
        if (searchQuery) newParams.set('search', searchQuery);
        const query = newParams.toString();
        window.history.pushState({}, '', query ? `?${query}` : '');
        updateUI();
      });
    }

    // Add click handlers to buttons
    techButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.disabled) {
          selectedTech = btn.getAttribute('data-filter-tech') || '';
          currentPage = 0;
          const newParams = new URLSearchParams();
          if (selectedTech) newParams.set('tech', selectedTech);
          if (selectedInst) newParams.set('inst', selectedInst);
          if (searchQuery) newParams.set('search', searchQuery);
          const query = newParams.toString();
          window.history.pushState({}, '', query ? `?${query}` : '');
          updateUI();
        }
      });
    });

    instButtons?.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!btn.disabled) {
          selectedInst = btn.getAttribute('data-filter-inst') || '';
          currentPage = 0;
          const newParams = new URLSearchParams();
          if (selectedTech) newParams.set('tech', selectedTech);
          if (selectedInst) newParams.set('inst', selectedInst);
          if (searchQuery) newParams.set('search', searchQuery);
          const query = newParams.toString();
          window.history.pushState({}, '', query ? `?${query}` : '');
          updateUI();
        }
      });
    });

    // Initial update
    updateUI();
  }
</script>
