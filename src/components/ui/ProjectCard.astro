---
import Badge from './Badge.astro';
import Button from './Button.astro';
import { truncateChars } from '@/utils/truncate';

interface Props {
  title: string;
  description: string;
  tags: string[];
  github?: string;
  demo?: string;
  image?: string;
  lang?: 'pt' | 'en';
}

const { title, description, tags, github, demo, image, lang = 'pt' } = Astro.props;
const visitLabel = lang === 'pt' ? 'Visitar' : 'Visit';
const codeLabel = lang === 'pt' ? 'Código' : 'Code';

// Truncar descrição a 150 caracteres
const displayDescription = truncateChars(description, 150);
---

<div class="bg-surface-1 border border-hairline rounded-lg p-6 hover:bg-surface-2 transition-all duration-300 flex flex-col">
  {image && (
    <div class="relative overflow-hidden rounded-md group mb-4">
      <img
        src={image}
        alt={title}
        loading="lazy"
        decoding="async"
        class="w-full h-64 object-cover rounded-md group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}

  <div class="space-y-3 mb-4">
    <h3 class="text-card-title font-semibold text-ink">{title}</h3>
    <p class="text-body text-ink-muted">{displayDescription}</p>
  </div>

  <div class="flex flex-wrap gap-2 mb-6">
    {tags.map((tag) => (
      <Badge text={tag} variant="secondary" />
    ))}
  </div>

  <div class="border-t border-hairline pt-4 mt-auto flex gap-3">
    {demo && (
      <Button href={demo} variant="primary" target="_blank">
        {visitLabel}
      </Button>
    )}
    {github && (
      <Button href={github} variant="secondary" target="_blank">
        {codeLabel}
      </Button>
    )}
  </div>
</div>
