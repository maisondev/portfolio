---
import Card from './Card.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import { truncateChars } from '@/utils/truncate';

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  github?: string;
  demo?: string;
  image?: string;
  stars?: number;
  forks?: number;
  lang?: 'pt' | 'en';
}

const { slug, title, description, tags, github, demo, image, stars, forks, lang = 'pt' } = Astro.props;
const visitLabel = lang === 'pt' ? 'Visitar' : 'Visit';
const codeLabel = lang === 'pt' ? 'Código' : 'Code';
const shareLabel = lang === 'pt' ? 'Compartilhar' : 'Share';

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};

const shareUrl = getLocalizedPath(`/projects/${slug}`);

// Truncar descrição a 150 caracteres
const displayDescription = truncateChars(description, 150);
---

<Card class="p-6">
  {image && (
    <div class="relative overflow-hidden rounded-md group mb-4">
      <img
        src={image}
        alt={title}
        loading="lazy"
        decoding="async"
        class="w-full h-64 object-cover rounded-md group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}

  <div class="space-y-3 mb-4">
    <h3 class="text-card-title font-semibold text-ink">
      <a href={getLocalizedPath(`/projects/${slug}`)} class="hover:text-primary transition-colors">
        {title}
      </a>
    </h3>
    {(stars !== undefined || forks !== undefined) && (
      <div class="flex items-center gap-4 text-caption text-ink-muted">
        {stars !== undefined && (
          <span class="inline-flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 flex-shrink-0">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
            </svg>
            {stars}
          </span>
        )}
        {forks !== undefined && (
          <span class="inline-flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 flex-shrink-0">
              <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/>
            </svg>
            {forks}
          </span>
        )}
      </div>
    )}
    <p class="text-body text-ink-muted">{displayDescription}</p>
  </div>

  <div class="flex flex-wrap gap-2 mb-6">
    {tags.map((tag) => (
      <Badge text={tag} variant="secondary" />
    ))}
  </div>

  <div class="border-t border-hairline pt-4 mt-auto flex items-center gap-3">
    {demo && (
      <Button href={demo} variant="primary" target="_blank">
        {visitLabel}
      </Button>
    )}
    {github && (
      <Button href={github} variant="secondary" target="_blank">
        {codeLabel}
      </Button>
    )}
    <button
      class="project-share-btn ml-auto flex-shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-md border border-hairline text-ink-muted hover:text-ink dark:hover:text-white hover:bg-surface-2 dark:hover:bg-surface-3 transition-colors"
      title={shareLabel}
      aria-label={shareLabel}
      data-share-url={shareUrl}
      data-share-title={title}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
        <circle cx="18" cy="5" r="3"/>
        <circle cx="6" cy="12" r="3"/>
        <circle cx="18" cy="19" r="3"/>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
      </svg>
    </button>
  </div>
</Card>

<script>
  document.querySelectorAll('.project-share-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const relativeUrl = btn.getAttribute('data-share-url') || '';
      const url = new URL(relativeUrl, window.location.origin).href;
      const title = btn.getAttribute('data-share-title') || document.title;

      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {
          // Usuário cancelou o compartilhamento
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(url);
        btn.classList.add('text-accent-500');
        setTimeout(() => btn.classList.remove('text-accent-500'), 2000);
      } catch {
        window.prompt('Copie o link:', url);
      }
    });
  });
</script>
