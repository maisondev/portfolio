---
import BlogCard from '@/components/ui/BlogCard.astro';
import { type Language } from '@/i18n/utils';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const t = {
  pt: {
    heading: 'Artigos & Escrita',
    subtitle: 'Compartilhando conhecimento e experiências sobre desenvolvimento, arquitetura e liderança técnica.',
    viewAll: 'Ver todos os artigos →',
  },
  en: {
    heading: 'Articles & Writing',
    subtitle: 'Sharing knowledge and experiences about development, architecture, and technical leadership.',
    viewAll: 'View all articles →',
  },
}[lang];

const posts = [
  {
    title: 'Building Scalable Systems in the Public Sector',
    excerpt: 'Lessons learned from 13+ years developing systems for government institutions with millions of users.',
    date: 'Mar 2024',
    readTime: '8 min',
    tags: ['Architecture', 'Leadership', 'Public Sector'],
    slug: '/blog/scalable-systems-public-sector',
  },
  {
    title: 'TypeScript in Production: Real-World Patterns',
    excerpt: 'Best practices and patterns I use daily at Prodam to maintain code quality in large-scale applications.',
    date: 'Feb 2024',
    readTime: '6 min',
    tags: ['TypeScript', 'Best Practices', 'Production'],
    slug: '/blog/typescript-production-patterns',
  },
  {
    title: 'From Manager to Senior Dev: A Career Pivot',
    excerpt: 'How I transitioned from management back to hands-on development and what I learned in the process.',
    date: 'Jan 2024',
    readTime: '10 min',
    tags: ['Career', 'Leadership', 'Development'],
    slug: '/blog/manager-to-senior-dev',
  },
];
---

<section id={id} class="bg-canvas py-20 md:py-24 space-y-12">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-4">
    <h1 class="text-4xl font-bold text-ink">{t.heading}</h1>
    <p class="text-ink-muted text-lg max-w-3xl">{t.subtitle}</p>
  </div>

  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 grid gap-6">
    {posts.map((post) => (
      <BlogCard
        title={post.title}
        excerpt={post.excerpt}
        date={post.date}
        readTime={post.readTime}
        tags={post.tags}
        slug={post.slug}
        lang={lang}
      />
    ))}
  </div>

  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 text-center pt-6">
    <a
      href="/blog"
      class="inline-block px-6 py-3 text-accent-500 font-semibold hover:text-accent-400 transition-colors"
    >
      {t.viewAll}
    </a>
  </div>
</section>
