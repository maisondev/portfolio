---
import { getEvents } from '@/config/events';
import { type Language } from '@/i18n/utils';
import EventCard from '../ui/EventCard.astro';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;
const events = getEvents(lang);

const sectionTitle = lang === 'pt' ? 'Eventos' : 'Events';
---

<section id={id} class="bg-canvas py-20 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-ink mb-12">{sectionTitle}</h2>

    <div class="grid gap-6">
      {events.map((event) => (
        <EventCard event={event} lang={lang} />
      ))}
    </div>
  </div>
</section>
