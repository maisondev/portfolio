---
import Button from '../ui/Button.astro';
import ProfileImage from '../ui/ProfileImage.astro';
import { type Language } from '@/i18n/utils';
import { MessageCircle } from '@lucide/astro';

interface Props {
  name: string;
  title: string;
  description: string;
  specializations?: string[];
  lang?: Language;
}

const { name, title, description, specializations = [], lang = 'pt' } = Astro.props;

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};
---

<section class="bg-canvas overflow-hidden py-20 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto w-full px-6 md:px-8">
    <!-- Mobile: Foto acima, centralizada -->
    <div class="flex justify-center md:hidden mb-8">
      <ProfileImage size="lg" showBorder={false} />
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-start">
      <!-- Coluna Esquerda: Nome e Título -->
      <div class="space-y-8">
        <div class="space-y-6">
          <h1 class="text-3xl sm:text-5xl md:text-display-xl font-semibold text-ink leading-tight">
            {name}
          </h1>
        </div>

        <h2 class="text-display-md font-semibold text-ink-muted max-w-2xl leading-tight">
          {title}
        </h2>

        <a
          href={getLocalizedPath('/recognitions')}
          class="group inline-flex items-center gap-3 px-4 py-2.5 bg-accent-500/10 hover:bg-accent-500/15 border border-accent-500/30 hover:border-accent-500/60 rounded-full transition-all w-fit"
          title={lang === 'pt' ? 'Ver registro no INPI' : 'View INPI registration'}
        >
          <span class="inline-flex items-center justify-center w-7 h-7 bg-accent-500 rounded-full flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4 text-black">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </span>
          <span class="text-sm font-semibold text-ink">
            {lang === 'pt'
              ? 'Coautor registrado no INPI — SIGEAM 2.0 (Prodam)'
              : 'INPI-registered co-author — SIGEAM 2.0 (Prodam)'}
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-accent-500 group-hover:translate-x-1 transition-transform">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

      <!-- Coluna Direita: Foto (Desktop) -->
      <div class="hidden md:flex md:justify-end">
        <div class="relative rounded-xl overflow-hidden bg-surface-1 p-6">
          <ProfileImage size="xl" showBorder={false} />
        </div>
      </div>
    </div>

    <!-- Especialidades, Descrição e Botões -->
    <div class="mt-16 space-y-8 max-w-3xl">
      {specializations.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {specializations.map((spec) => (
            <span class="px-3 py-1.5 bg-surface-1 border border-hairline rounded-md text-caption text-ink-subtle font-medium">
              {spec}
            </span>
          ))}
        </div>
      )}

      <p class="text-body-lg text-ink-muted max-w-2xl">
        {description}
      </p>

      <div class="flex flex-col sm:flex-row gap-3 pt-4">
        <Button
          href="https://github.com/maisondev"
          variant="primary"
          target="_blank"
          rel="noopener noreferrer"
          title="GitHub"
          class="flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </Button>
        <Button
          href="https://www.linkedin.com/in/maisongalvao"
          variant="secondary"
          target="_blank"
          title="LinkedIn"
          class="flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <span class="hidden sm:inline">LinkedIn</span>
        </Button>
        <Button
          href="https://instagram.com/maisongalvao"
          variant="secondary"
          target="_blank"
          title="Instagram"
          class="flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.322a1.44 1.44 0 110-2.881 1.44 1.44 0 010 2.881z"/>
          </svg>
          <span class="hidden sm:inline">Instagram</span>
        </Button>
        <Button
          href="https://wa.me/5592986255936"
          variant="secondary"
          target="_blank"
          title="WhatsApp"
          class="flex items-center justify-center gap-2"
        >
          <MessageCircle class="w-5 h-5 flex-shrink-0" />
          <span class="hidden sm:inline">WhatsApp</span>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    section {
      min-height: auto;
    }
  }
</style>
