---
import Button from '@/components/ui/Button.astro';
import ProfileImage from '@/components/ui/ProfileImage.astro';
import { type Language } from '@/i18n/utils';

interface Props {
  name: string;
  title: string;
  description: string;
  specializations?: string[];
  lang?: Language;
}

const { name, title, description, specializations = [], lang = 'pt' } = Astro.props;

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};
---

<section class="bg-canvas overflow-hidden py-20 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto w-full px-6 md:px-8">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <!-- Coluna Esquerda: Nome e Título -->
      <div class="space-y-8">
        <div class="space-y-6">
          <h1 class="text-display-xl font-semibold text-ink leading-tight">
            {name}
          </h1>
        </div>

        <h2 class="text-display-md font-semibold text-ink-muted max-w-2xl leading-tight">
          {title}
        </h2>
      </div>

      <!-- Coluna Direita: Foto -->
      <div class="hidden md:flex md:justify-end">
        <div class="relative rounded-xl overflow-hidden bg-surface-1 p-6">
          <ProfileImage size="xl" showBorder={false} />
        </div>
      </div>
    </div>

    <!-- Especialidades, Descrição e Botões -->
    <div class="mt-16 space-y-8 max-w-3xl">
      {specializations.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {specializations.map((spec) => (
            <span class="px-3 py-1.5 bg-surface-1 border border-hairline rounded-md text-caption text-ink-subtle font-medium">
              {spec}
            </span>
          ))}
        </div>
      )}

      <p class="text-body-lg text-ink-muted max-w-2xl">
        {description}
      </p>

      <div class="flex flex-col sm:flex-row gap-3 pt-4">
        <Button
          href="https://github.com/maisondev"
          variant="primary"
          target="_blank"
          title="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </Button>
        <Button
          href="https://www.linkedin.com/in/maisongalvao"
          variant="secondary"
          target="_blank"
          title="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </Button>
        <Button
          href="https://wa.me/5592986255936"
          variant="secondary"
          target="_blank"
          title="WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004c-1.394 0-2.747.366-3.922 1.062l-.274.162-.284.049-1.171.042 1.064 1.033.069.264c.679 1.267.977 2.735.976 4.242 0 4.029 3.582 7.286 8.002 7.286 2.137 0 4.132-.784 5.634-2.202 1.502-1.418 2.333-3.29 2.334-5.284.001-4.03-3.582-7.286-8.002-7.286m0-1.4C19.033 5.579 23 9.539 23 14.416c0 2.529-1.125 4.905-3.088 6.516-.827.695-1.817 1.282-2.889 1.723l-1.621 2.29-2.879-2.076c-.677.127-1.393.19-2.133.19-4.748 0-8.615-3.282-8.615-7.313 0-1.886.627-3.627 1.694-5.04L1 9.08l2.036 2.094c-.125.693-.19 1.406-.19 2.139 0 4.03 3.867 7.313 8.615 7.313 1.884 0 3.633-.639 5.047-1.716l2.118 1.53 1.621-2.29c1.072-.44 2.063-1.03 2.889-1.723 1.963-1.611 3.088-3.987 3.088-6.516 0-4.877-3.968-8.837-8.847-8.837"/>
          </svg>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    section {
      min-height: auto;
    }
  }
</style>
