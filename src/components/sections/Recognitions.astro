---
import { getRecognitions } from '@/config/recognitions';
import { type Language } from '@/i18n/utils';
import RecognitionCard from '../ui/RecognitionCard.astro';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const recognitions = getRecognitions(lang);
---

<section id={id} class="bg-canvas py-20 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-6">
    {recognitions.map((recognition) => (
      <RecognitionCard recognition={recognition} lang={lang} />
    ))}
  </div>

  <!-- Modal para visualizar certificado -->
  <dialog id="recognition-cert-modal" class="backdrop:bg-black/80 rounded-xl border border-hairline-strong bg-surface-1 dark:bg-surface-2 p-6 w-full max-w-5xl max-h-[90vh] overflow-auto">
  <div class="flex justify-between items-center mb-4 sticky top-0 bg-surface-1 dark:bg-surface-2 z-50 pb-4 border-b border-hairline">
    <h3 class="text-lg font-semibold text-ink dark:text-white" id="recognition-cert-title">Certificado</h3>
    <div class="flex items-center gap-2">
      <a id="recognition-cert-download" href="#" target="_blank" rel="noopener noreferrer" class="text-primary dark:text-primary hover:text-primary-hover dark:hover:text-primary-hover transition-colors p-2 hover:bg-surface-2 dark:hover:bg-surface-3 rounded-md" title="Baixar certificado">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </a>
      <button id="close-recognition-cert-modal" class="text-ink-muted dark:text-ink-muted hover:text-ink dark:hover:text-white transition-colors p-2 hover:bg-surface-2 dark:hover:bg-surface-3 rounded-md">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="flex flex-col items-center justify-center gap-4 w-full">
    <iframe id="recognition-cert-pdf" src="" title="Certificado PDF" class="w-full h-[70vh] border border-hairline dark:border-hairline rounded-lg"></iframe>
  </div>
  </dialog>

  <style>
    dialog#recognition-cert-modal::backdrop {
      background-color: rgba(0, 0, 0, 0.8);
    }
  </style>
</section>

<script>
  const modal = document.getElementById('recognition-cert-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('close-recognition-cert-modal');
  const certPdf = document.getElementById('recognition-cert-pdf') as HTMLIFrameElement;
  const certTitle = document.getElementById('recognition-cert-title');
  const downloadLink = document.getElementById('recognition-cert-download') as HTMLAnchorElement;
  const certButtons = document.querySelectorAll('.recognition-cert-btn');

  certButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-cert-url');
      const title = btn.getAttribute('data-cert-title');

      if (url) {
        certTitle!.textContent = title || 'Certificado';
        certPdf.src = url;
        downloadLink.href = url;
        modal.showModal();
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal.close();
    certPdf.src = '';
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
      certPdf.src = '';
    }
  });

  document.addEventListener('keydown', (e) => {
    if (modal?.open && e.key === 'Escape') {
      modal.close();
      certPdf.src = '';
    }
  });

  // Copiar link direto para o reconhecimento
  document.querySelectorAll<HTMLButtonElement>('.recognition-copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const anchor = btn.dataset.anchor;
      if (!anchor) return;
      const url = `${window.location.origin}${window.location.pathname}#${anchor}`;
      try {
        await navigator.clipboard.writeText(url);
        const label = btn.querySelector('.copy-link-label');
        if (label) {
          label.textContent = btn.dataset.labelCopied || 'Link copiado!';
          btn.classList.add('text-accent-500');
          setTimeout(() => {
            label.textContent = btn.dataset.label || 'Copiar link';
            btn.classList.remove('text-accent-500');
          }, 2000);
        }
      } catch {
        window.prompt('Copie o link:', url);
      }
    });
  });

  // Destacar card ao abrir via link com âncora
  const highlightFromHash = () => {
    const hash = window.location.hash.slice(1);
    if (!hash) return;
    const target = document.getElementById(hash);
    if (target?.classList.contains('recognition-anchor')) {
      target.classList.add('ring-2', 'ring-accent-500');
      setTimeout(() => target.classList.remove('ring-2', 'ring-accent-500'), 2500);
    }
  };
  highlightFromHash();
  window.addEventListener('hashchange', highlightFromHash);
</script>
