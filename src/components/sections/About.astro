---
import TechStack from '@/components/sections/TechStack.astro';
import { type Language } from '@/i18n/utils';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const t = {
  pt: {
    heading: 'Sobre',
    p1: 'Desenvolvedor de Software na PRODAM-AM desde 2018, com mais de 16 anos de experiência na área de Tecnologia da Informação. Possuo formação em Análise de Sistemas e Técnico em Informática pelo IFAM, além de pós-graduações em Desenvolvimento Full Stack, Cloud Computing e Inteligência Artificial, complementadas por estudos em gestão de projetos, inovação e engenharia de software.',
    p2: 'Minha trajetória profissional combina experiência técnica e liderança. Atuei como Gerente de Informática na SEMTRAD entre 2013 e 2018, sendo responsável pela coordenação de equipes, suporte à infraestrutura tecnológica e implantação de soluções para a administração pública. Desde 2018, integro a equipe da PRODAM-AM como Desenvolvedor de Software, participando da análise, desenvolvimento, manutenção e modernização de sistemas corporativos.',
    p3: 'Ao longo da carreira, desenvolvi sólida experiência em arquitetura de software, desenvolvimento web, integração de sistemas, modernização de aplicações legadas e adoção de boas práticas de engenharia de software. Também mantenho interesse constante em Inteligência Artificial aplicada à produtividade, automação e apoio à tomada de decisão. Sou apaixonado por tecnologia e aprendizado contínuo, e acredito que software de qualidade é construído pela combinação de conhecimento técnico, disciplina, colaboração e foco na resolução de problemas reais.',
    stack: 'Tech Stack',
    location: 'Localização',
    locationValue: 'Manaus, Amazonas — Brasil',
    locationSub: 'Disponível para trabalho remoto',
    experience: 'Experiência',
    experienceValue: '+16 anos em Tecnologia da Informação',
    experienceSub: 'Técnico em Informática (2010-2013), Gerente de Informática (2013-2018), Desenvolvedor de Software (2018-presente)',
    education: 'Educação',
    educationValue: 'Análise de Sistemas + IFAM',
    educationSub: 'Full Stack • Cloud Computing • Inteligência Artificial',
  },
  en: {
    heading: 'About',
    p1: 'Software Developer at PRODAM-AM since 2018, with more than 16 years of experience in Information Technology. I hold a degree in Systems Analysis and Technical training in Computer Science from IFAM, complemented by postgraduate studies in Full Stack Development, Cloud Computing, and Artificial Intelligence, along with specialized training in project management, innovation, and software engineering.',
    p2: 'My professional trajectory combines technical expertise and leadership. I served as IT Manager at SEMTRAD between 2013 and 2018, responsible for team coordination, technological infrastructure support, and solution implementation for public administration. Since 2018, I have been part of the PRODAM-AM team as a Software Developer, participating in analysis, development, maintenance, and modernization of corporate systems.',
    p3: 'Throughout my career, I have developed solid experience in software architecture, web development, systems integration, legacy application modernization, and adoption of software engineering best practices. I also maintain a constant interest in Artificial Intelligence applied to productivity, automation, and decision support. I am passionate about technology and continuous learning, and I believe that quality software is built through a combination of technical knowledge, discipline, collaboration, and focus on solving real problems.',
    stack: 'Tech Stack',
    location: 'Location',
    locationValue: 'Manaus, Amazonas — Brazil',
    locationSub: 'Available for remote work',
    experience: 'Experience',
    experienceValue: '+16 years in Information Technology',
    experienceSub: 'Technical Specialist (2010-2013), IT Manager (2013-2018), Software Developer (2018-present)',
    education: 'Education',
    educationValue: 'Systems Analysis + IFAM',
    educationSub: 'Full Stack • Cloud Computing • Artificial Intelligence',
  },
}[lang];

---

<section id={id} class="bg-canvas py-20 md:py-24 space-y-16">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-6">
    <h1 class="text-4xl font-bold text-ink">{t.heading}</h1>
    <div class="space-y-4">
      <p class="text-ink-muted text-lg leading-relaxed max-w-3xl">{t.p1}</p>
      <p class="text-ink-muted text-lg leading-relaxed max-w-3xl">{t.p2}</p>
      <p class="text-ink-muted text-lg leading-relaxed max-w-3xl">{t.p3}</p>
    </div>
  </div>

  <TechStack lang={lang} />

  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-surface-1 border border-hairline rounded-lg p-6 space-y-3">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C7.13 2 3 6.13 3 11c0 5.25 9 13 9 13s9-7.75 9-13c0-4.87-4.13-9-9-9zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">{t.location}</h4>
        </div>
        <p class="text-ink text-lg font-semibold">{t.locationValue}</p>
        <p class="text-ink-muted text-sm">{t.locationSub}</p>
      </div>
      <div class="bg-surface-1 border border-hairline rounded-lg p-6 space-y-3">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14l4 4V5c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v3z"/>
          </svg>
          <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">{t.experience}</h4>
        </div>
        <p class="text-ink text-lg font-semibold">{t.experienceValue}</p>
        <p class="text-ink-muted text-sm">{t.experienceSub}</p>
      </div>
      <div class="bg-surface-1 border border-hairline rounded-lg p-6 space-y-3">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6.18L23 9 12 3zM5 9.08L12 12.7l7-3.62V9.08L12 12.7 5 9.08z"/>
          </svg>
          <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">{t.education}</h4>
        </div>
        <p class="text-ink text-lg font-semibold">{t.educationValue}</p>
        <p class="text-ink-muted text-sm">{t.educationSub}</p>
      </div>
    </div>
  </div>
</section>
