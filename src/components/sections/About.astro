---
import Badge from '@/components/ui/Badge.astro';
import { type Language } from '@/i18n/utils';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const frontendSkills = [
  'Vue.js',
  'React',
  'TypeScript',
  'Tailwind CSS',
  'HTML/CSS',
  'Responsive Design',
];

const backendSkills = [
  'Node.js',
  'PostgreSQL',
  'REST APIs',
  'Express.js',
  'Integração de APIs (Gemini)',
  'Arquitetura de Sistemas',
];

const devTools = [
  'Git/GitHub',
  'Docker',
  'Linux',
  'Cloud Deployment',
  'Google Cloud',
  'Database Design',
];
---

<section id={id} class="py-20 space-y-16">
  <div class="space-y-6">
    <h1 class="text-4xl font-bold text-[#fafafa]">Sobre</h1>
    <div class="space-y-4">
      <p class="text-[#d4d4d8] text-lg leading-relaxed max-w-3xl">
        Desenvolvedor de Software na PRODAM-AM com 13 anos de experiência em tecnologia. Formação forte em engenharia de software
        com pós-graduação em Full Stack, Cloud Computing e IA, complementada por especialização em gestão de projetos e inovação com inteligência artificial.
      </p>
      <p class="text-[#d4d4d8] text-lg leading-relaxed max-w-3xl">
        Minha jornada combina experiência profunda em desenvolvimento (7 anos na PRODAM) com liderança estratégica de TI (5 anos como Gerente).
        Especializado em arquitetura de sistemas escaláveis, modernização de aplicações legadas e aplicação prática de IA em gestão pública.
      </p>
      <p class="text-[#d4d4d8] text-lg leading-relaxed max-w-3xl">
        Apaixonado por resolver problemas complexos através de tecnologia bem aplicada. Criei projetos como Sinapses
        (gerador de roadmaps com IA usando Google Gemini) e sou constantemente dedicado a código de qualidade, boas práticas
        de engenharia e compartilhamento de conhecimento.
      </p>
    </div>
  </div>

  <div class="space-y-8">
    <h3 class="text-2xl font-bold text-[#fafafa]">Stack Técnico</h3>

    <div class="grid sm:grid-cols-3 gap-8">
      <div class="space-y-4">
        <h4 class="text-lg font-semibold text-accent-500">Frontend</h4>
        <div class="flex flex-wrap gap-2">
          {frontendSkills.map((skill) => (
            <Badge text={skill} variant="primary" />
          ))}
        </div>
      </div>

      <div class="space-y-4">
        <h4 class="text-lg font-semibold text-accent-500">Backend</h4>
        <div class="flex flex-wrap gap-2">
          {backendSkills.map((skill) => (
            <Badge text={skill} variant="primary" />
          ))}
        </div>
      </div>

      <div class="space-y-4">
        <h4 class="text-lg font-semibold text-accent-500">DevTools</h4>
        <div class="flex flex-wrap gap-2">
          {devTools.map((skill) => (
            <Badge text={skill} variant="primary" />
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 space-y-2">
      <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">📍 Localização</h4>
      <p class="text-[#fafafa] text-lg font-semibold">Manaus, Amazonas - Brasil</p>
      <p class="text-[#a1a1a1] text-sm">Disponível para trabalho remoto</p>
    </div>
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 space-y-2">
      <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">💼 Experiência</h4>
      <p class="text-[#fafafa] text-lg font-semibold">13 anos em Tecnologia</p>
      <p class="text-[#a1a1a1] text-sm">7 anos @ PRODAM, 5 anos em Liderança</p>
    </div>
    <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 space-y-2">
      <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">🎓 Formação</h4>
      <p class="text-[#fafafa] text-lg font-semibold">Engenharia de Software</p>
      <p class="text-[#a1a1a1] text-sm">Full Stack & Cloud Computing</p>
    </div>
  </div>
</section>
