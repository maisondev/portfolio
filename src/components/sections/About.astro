---
import Badge from '@/components/ui/Badge.astro';
import { type Language } from '@/i18n/utils';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const t = {
  pt: {
    heading: 'Sobre',
    p1: 'Desenvolvedor de Software na PRODAM-AM desde 2018, com 16 anos de experiência em tecnologia desde 2010. Formação forte em engenharia de software com pós-graduação em Full Stack, Cloud Computing e IA, complementada por especialização em gestão de projetos e inovação com inteligência artificial.',
    p2: 'Minha jornada no setor público combina 8 anos como Programador na PRODAM (2018-2026) com 5 anos de liderança como Gerente de Informática na SEMTRAD (2013-2018), precedido por experiência técnica desde 2010. Especializado em arquitetura de sistemas escaláveis, modernização de aplicações legadas e aplicação prática de IA em gestão pública.',
    p3: 'Apaixonado por resolver problemas complexos através de tecnologia bem aplicada. Criei projetos como Sinapses (gerador de roadmaps com IA usando Google Gemini) e sou constantemente dedicado a código de qualidade, boas práticas de engenharia e compartilhamento de conhecimento.',
    stack: 'Tech Stack',
    location: '📍 Location',
    locationValue: 'Manaus, Amazonas — Brazil',
    locationSub: 'Available for remote work',
    experience: '💼 Experience',
    experienceValue: '16 years in Technology (2010-2026)',
    experienceSub: '5 years as Manager (2013-2018), 8 years as Developer (2010-2013, 2018-2026)',
    education: '🎓 Education',
    educationValue: 'Software Engineering',
    educationSub: 'Full Stack & Cloud Computing',
  },
  en: {
    heading: 'About',
    p1: 'Software Developer at PRODAM-AM since 2018, with 16 years of technology experience since 2010. Strong background in software engineering with postgraduate studies in Full Stack, Cloud Computing, and AI, complemented by specialization in project management and innovation with artificial intelligence.',
    p2: 'My journey in the public sector combines 8 years as a Programmer at PRODAM (2018-2026) with 5 years of leadership as IT Manager at SEMTRAD (2013-2018), preceded by technical experience since 2010. Specialized in scalable systems architecture, legacy application modernization, and practical AI application in public management.',
    p3: 'Passionate about solving complex problems through well-applied technology. I built projects like Sinapses (AI-powered roadmap generator using Google Gemini) and am constantly dedicated to quality code, good engineering practices, and knowledge sharing.',
    stack: 'Tech Stack',
    location: '📍 Location',
    locationValue: 'Manaus, Amazonas — Brazil',
    locationSub: 'Available for remote work',
    experience: '💼 Experience',
    experienceValue: '16 years in Technology (2010-2026)',
    experienceSub: '5 years as Manager (2013-2018), 8 years as Developer (2010-2013, 2018-2026)',
    education: '🎓 Education',
    educationValue: 'Software Engineering',
    educationSub: 'Full Stack & Cloud Computing',
  },
}[lang];

const backendSkills = lang === 'pt'
  ? ['Node.js', 'PostgreSQL', 'REST APIs', 'Express.js', 'Integração de APIs (Gemini)', 'Arquitetura de Sistemas']
  : ['Node.js', 'PostgreSQL', 'REST APIs', 'Express.js', 'API Integration (Gemini)', 'Systems Architecture'];

const frontendSkills = ['Vue.js', 'React', 'TypeScript', 'Tailwind CSS', 'HTML/CSS', 'Responsive Design'];

const devTools = ['Git/GitHub', 'Docker', 'Linux', 'Cloud Deployment', 'Google Cloud', 'Database Design'];
---

<section id={id} class="bg-canvas py-20 md:py-24 space-y-16">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-6">
    <h1 class="text-4xl font-bold text-ink">{t.heading}</h1>
    <div class="space-y-4">
      <p class="text-ink-muted text-lg leading-relaxed max-w-3xl">{t.p1}</p>
      <p class="text-ink-muted text-lg leading-relaxed max-w-3xl">{t.p2}</p>
      <p class="text-ink-muted text-lg leading-relaxed max-w-3xl">{t.p3}</p>
    </div>
  </div>

  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-8">
    <h3 class="text-2xl font-bold text-ink">{t.stack}</h3>

    <div class="grid sm:grid-cols-3 gap-8">
      <div class="space-y-4">
        <h4 class="text-lg font-semibold text-accent-500">Frontend</h4>
        <div class="flex flex-wrap gap-2">
          {frontendSkills.map((skill) => (
            <Badge text={skill} variant="primary" />
          ))}
        </div>
      </div>

      <div class="space-y-4">
        <h4 class="text-lg font-semibold text-accent-500">Backend</h4>
        <div class="flex flex-wrap gap-2">
          {backendSkills.map((skill) => (
            <Badge text={skill} variant="primary" />
          ))}
        </div>
      </div>

      <div class="space-y-4">
        <h4 class="text-lg font-semibold text-accent-500">DevTools</h4>
        <div class="flex flex-wrap gap-2">
          {devTools.map((skill) => (
            <Badge text={skill} variant="primary" />
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-surface-1 border border-hairline rounded-lg p-6 space-y-2">
        <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">{t.location}</h4>
        <p class="text-ink text-lg font-semibold">{t.locationValue}</p>
        <p class="text-ink-muted text-sm">{t.locationSub}</p>
      </div>
      <div class="bg-surface-1 border border-hairline rounded-lg p-6 space-y-2">
        <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">{t.experience}</h4>
        <p class="text-ink text-lg font-semibold">{t.experienceValue}</p>
        <p class="text-ink-muted text-sm">{t.experienceSub}</p>
      </div>
      <div class="bg-surface-1 border border-hairline rounded-lg p-6 space-y-2">
        <h4 class="text-sm font-semibold text-accent-500 uppercase tracking-wide">{t.education}</h4>
        <p class="text-ink text-lg font-semibold">{t.educationValue}</p>
        <p class="text-ink-muted text-sm">{t.educationSub}</p>
      </div>
    </div>
  </div>
</section>
