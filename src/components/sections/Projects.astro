---
import Badge from '@/components/ui/Badge.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';

interface Props {
  id?: string;
}

const { id } = Astro.props;

const projects = [
  {
    title: 'Portfolio',
    description: 'Meu próprio portfolio construído com Astro, TailwindCSS e TypeScript.',
    tags: ['Astro', 'TypeScript', 'Tailwind CSS'],
    github: 'https://github.com/maisongalvao/portfolio',
    demo: 'https://maisongalvao.dev',
  },
];
---

<section id={id} class="py-20 space-y-12">
  <div class="space-y-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-[#fafafa]">Projetos</h2>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      Alguns dos projetos que criei para aprender novas tecnologias e resolver problemas práticos.
    </p>
  </div>

  <div class="grid gap-6">
    {projects.map((project) => (
      <ProjectCard
        title={project.title}
        description={project.description}
        tags={project.tags}
        github={project.github}
        demo={project.demo}
      />
    ))}
  </div>
</section>
