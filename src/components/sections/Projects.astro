---
import ProjectCard from '../ui/ProjectCard.astro';
import { type Language } from '@/i18n/utils';
import { getProjects } from '@/config/projects';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const projects = getProjects(lang);
---

<section id={id} class="bg-canvas py-20 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 4xl:grid-cols-4 gap-6">
    {projects.map((project) => (
      <ProjectCard
        slug={project.slug}
        title={project.title}
        description={project.description}
        tags={project.tags}
        github={project.github}
        demo={project.demo}
        image={project.image}
        lang={lang}
      />
    ))}
  </div>
</section>
