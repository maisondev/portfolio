---
import Badge from '@/components/ui/Badge.astro';

interface Props {
  id?: string;
  lang?: 'pt' | 'en';
  showAll?: boolean;
}

const { id, lang = 'pt', showAll = false } = Astro.props;

const translations = {
  pt: {
    title: 'Estudos de Caso',
    subtitle: 'Projetos em produção que escalei para milhões de usuários. Documentados sem exposição de dados sensíveis ou propriedade intelectual da empresa.',
    challenge: 'Desafio',
    results: 'Resultados Alcançados',
    technologies: 'Tecnologias & Conceitos',
    learnings: 'Aprendizados Principais',
    users: 'Usuários',
    uptime: 'Uptime',
    latencyReduction: 'Redução Latência',
  },
  en: {
    title: 'Case Studies',
    subtitle: 'Production projects I\'ve scaled to millions of users. Documented without exposing sensitive data or company intellectual property.',
    challenge: 'Challenge',
    results: 'Results Achieved',
    technologies: 'Technologies & Concepts',
    learnings: 'Key Learnings',
    users: 'Users',
    uptime: 'Uptime',
    latencyReduction: 'Latency Reduction',
  },
};

const t = translations[lang];

const caseStudies = [
  {
    title: lang === 'pt'
      ? 'Plataforma de Matrículas - Governo do Amazonas'
      : 'Enrollment Platform - State of Amazonas Government',
    client: lang === 'pt'
      ? 'Secretarias de Educação (SEMED/SEDUC)'
      : 'Education Secretariats (SEMED/SEDUC)',
    scope: lang === 'pt'
      ? 'Arquitetura Distribuída & Otimização de Performance'
      : 'Distributed Architecture & Performance Optimization',
    period: '2020 - Present',
    challenge: lang === 'pt'
      ? 'Sistema legado em Natural/ADABAS atendendo 10k usuários simultâneos. Período de matrículas (dezembro) causava crashes com acessos concentrados. Necessidade de escalar 5x mantendo uptime crítico.'
      : 'Legacy system in Natural/ADABAS handling 10k simultaneous users. Enrollment period (December) caused crashes due to concentrated traffic. Need to scale 5x while maintaining critical uptime.',
    results: lang === 'pt'
      ? [
          '50k+ usuários simultâneos em horários de pico',
          '99.98% de uptime durante pico de matrículas',
          'Latência reduzida de 2000ms para 150ms (p99)',
          'Zero-downtime deployments com Blue-Green',
          'Processamento de 2M+ requisições diárias',
        ]
      : [
          '50k+ simultaneous users during peak hours',
          '99.98% uptime during enrollment peaks',
          'Latency reduced from 2000ms to 150ms (p99)',
          'Zero-downtime deployments with Blue-Green',
          '2M+ requests processing daily',
        ],
    technologies: ['TypeScript', 'Node.js', 'Vue.js', 'PostgreSQL', 'Redis', 'Docker', 'Kubernetes', 'AWS'],
    keyLearnings: lang === 'pt'
      ? [
          'Migração de monolito Natural/ADABAS para arquitetura de microserviços cloud-native',
          'Load testing e capacity planning para picos de demanda previsíveis (.gov)',
          'Compliance e requisitos de acessibilidade em plataformas estaduais',
          'Estratégias de caching distribuído em sistemas de alta concorrência',
          'Orquestração de containers em ambientes heterogêneos',
        ]
      : [
          'Migration from Natural/ADABAS monolith to cloud-native microservices architecture',
          'Load testing and capacity planning for predictable demand peaks (.gov)',
          'Compliance and accessibility requirements in state platforms',
          'Distributed caching strategies in high-concurrency systems',
          'Container orchestration in heterogeneous environments',
        ],
    impact: {
      users: '500k+',
      uptime: '99.98%',
      reduction: '90%',
    },
  },
  {
    title: lang === 'pt'
      ? 'SIGEAM 2.0 - Sistema Integrado de Gestão de Educação'
      : 'SIGEAM 2.0 - Integrated Education Management System',
    client: lang === 'pt'
      ? 'Secretaria de Estado de Educação (SEDUC) & Prefeitura de Manaus'
      : 'State Education Secretariat (SEDUC) & Manaus City Hall',
    scope: lang === 'pt'
      ? 'Migração Legacy → Web | AI-Powered Rule Extraction | Full-Stack Architecture'
      : 'Legacy Migration → Web | AI-Powered Rule Extraction | Full-Stack Architecture',
    period: '2023 - Present',
    challenge: lang === 'pt'
      ? 'Sistema Natural/ADABAS monolítico que integra todos os serviços de educação (estadual + municipal). Utilizado em 1000+ escolas com centenas de milhares de usuários. Necessário migrar para arquitetura web moderna mantendo todas as 500+ regras de negócio complexas e garantindo zero downtime.'
      : 'Monolithic Natural/ADABAS system integrating all education services (state + municipal). Used across 1000+ schools with hundreds of thousands of users. Required migration to modern web architecture while maintaining 500+ complex business rules and ensuring zero downtime.',
    results: lang === 'pt'
      ? [
          '1000+ escolas estaduais e municipais integradas',
          'Migração de 500+ regras de negócio complexas com IA (Claude)',
          'Backend: PHP 8.2 + Symfony 6 (RESTful API)',
          'Frontend: Vue.js 3 + TypeScript (responsive design)',
          'Zero perda de funcionalidade durante transição',
          'Redução de tempo de onboarding de escolas em 60%',
        ]
      : [
          '1000+ state and municipal schools integrated',
          'Migration of 500+ complex business rules using AI (Claude)',
          'Backend: PHP 8.2 + Symfony 6 (RESTful API)',
          'Frontend: Vue.js 3 + TypeScript (responsive design)',
          'Zero functionality loss during transition',
          '60% reduction in school onboarding time',
        ],
    technologies: ['PHP 8.2', 'Symfony 6', 'Vue.js 3', 'TypeScript', 'PostgreSQL', 'Docker', 'AWS', 'Claude API', 'REST APIs'],
    keyLearnings: lang === 'pt'
      ? [
          'Extracting complex business rules from legacy Natural/ADABAS using Claude AI - automating reverse-engineering',
          'Full-stack web architecture for enterprise education systems serving 1000+ institutions',
          'Managing scope in large-scale .gov projects with competing requirements (SEDUC vs Prefeitura)',
          'Database schema normalization from hierarchical (ADABAS) to relational (PostgreSQL)',
          'Progressive rollout strategy to 1000+ schools with minimal disruption',
          'Integration patterns between modern REST APIs and legacy system dependencies',
        ]
      : [
          'Extracting complex business rules from legacy Natural/ADABAS using Claude AI - automating reverse-engineering',
          'Full-stack web architecture for enterprise education systems serving 1000+ institutions',
          'Managing scope in large-scale .gov projects with competing requirements (state vs municipal)',
          'Database schema normalization from hierarchical (ADABAS) to relational (PostgreSQL)',
          'Progressive rollout strategy to 1000+ schools with minimal disruption',
          'Integration patterns between modern REST APIs and legacy system dependencies',
        ],
    impact: {
      users: '1000+ escolas',
      uptime: '99.9%',
      reduction: '60%',
    },
  },
];

const displayedStudies = showAll ? caseStudies : [caseStudies[0]];
---

<section id={id} class="bg-canvas py-20 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-8">
    {displayedStudies.map((study) => (
      <div class="bg-surface-1 border border-hairline rounded-lg p-8 space-y-6 hover:border-accent-500/30 transition-colors">
        {/* Header */}
        <div class="space-y-3">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
            <div class="space-y-1">
              <p class="text-accent-500 text-sm font-semibold uppercase tracking-wider">{study.client}</p>
              <h3 class="text-2xl sm:text-3xl font-bold text-ink">{study.title}</h3>
              <p class="text-ink-muted">{study.scope}</p>
            </div>
            <span class="text-sm text-ink-muted whitespace-nowrap pt-1">{study.period}</span>
          </div>
        </div>

        {/* Challenge */}
        <div class="bg-canvas border border-hairline rounded-lg p-4">
          <h4 class="text-sm font-semibold text-accent-500 uppercase mb-2">{t.challenge}</h4>
          <p class="text-ink-muted">{study.challenge}</p>
        </div>

        {/* Impact Metrics */}
        <div class="grid grid-cols-3 gap-4 bg-accent-500/5 border border-accent-500/20 rounded-lg p-4">
          <div class="space-y-1">
            <p class="text-accent-500 font-bold text-xl">{study.impact.users}</p>
            <p class="text-ink-muted text-xs uppercase">{t.users}</p>
          </div>
          <div class="space-y-1">
            <p class="text-accent-500 font-bold text-xl">{study.impact.uptime}</p>
            <p class="text-ink-muted text-xs uppercase">{t.uptime}</p>
          </div>
          <div class="space-y-1">
            <p class="text-accent-500 font-bold text-xl">{study.impact.reduction}</p>
            <p class="text-ink-muted text-xs uppercase">{t.latencyReduction}</p>
          </div>
        </div>

        {/* Technologies */}
        <div class="space-y-3">
          <h4 class="text-sm font-semibold text-ink uppercase">{t.technologies}</h4>
          <div class="flex flex-wrap gap-2">
            {study.technologies.map((tech) => (
              <span class="px-3 py-1 bg-hairline text-ink-muted rounded-full text-sm border border-hairline hover:border-accent-500/50 transition-colors">
                {tech}
              </span>
            ))}
          </div>
        </div>

        {/* Key Learnings */}
        <div class="space-y-3">
          <h4 class="text-sm font-semibold text-ink uppercase">{t.learnings}</h4>
          <ul class="space-y-2">
            {study.keyLearnings.map((learning) => (
              <li class="flex gap-2 text-ink-muted text-sm">
                <span class="text-accent-500 flex-shrink-0">→</span>
                <span>{learning}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
