---
import PerformanceMetric from '../ui/PerformanceMetric.astro';
---

<section class="bg-canvas py-20 md:py-24 space-y-12">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-4">
    <h2 class="text-3xl md:text-4xl font-bold text-ink">Qualidade & Performance</h2>
    <p class="text-ink-muted text-lg max-w-3xl">
      Obsessão por performance e qualidade de código. Cada projeto é otimizado para máxima velocidade e acessibilidade.
    </p>
  </div>

  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12">
      <!-- Lighthouse Scores -->
      <div class="space-y-6 p-6 rounded-lg border border-hairline bg-gradient-to-br from-surface-1 to-canvas">
      <h3 class="text-xl font-bold text-ink flex items-center gap-2">
        <span class="text-accent-500">⚡</span> Lighthouse Scores
      </h3>
      <div class="space-y-4">
        <PerformanceMetric label="Performance" value={98} unit="/" target={100} />
        <PerformanceMetric label="Accessibility" value={100} unit="/" target={100} />
        <PerformanceMetric label="Best Practices" value={100} unit="/" target={100} />
        <PerformanceMetric label="SEO" value={100} unit="/" target={100} />
      </div>
    </div>

    <!-- Core Web Vitals -->
    <div class="space-y-6 p-6 rounded-lg border border-hairline bg-gradient-to-br from-surface-1 to-canvas">
      <h3 class="text-xl font-bold text-ink flex items-center gap-2">
        <span class="text-accent-500">🎯</span> Core Web Vitals
      </h3>
      <div class="space-y-4">
        <PerformanceMetric label="Largest Contentful Paint" value={1.2} unit="s" target={2.5} />
        <PerformanceMetric label="First Input Delay" value={0.1} unit="ms" target={100} />
        <PerformanceMetric label="Cumulative Layout Shift" value={0.05} unit="" target={0.1} />
      </div>
    </div>

    <!-- Additional Metrics -->
    <div class="grid md:grid-cols-3 gap-4 pt-4">
      <div class="p-4 rounded-lg border border-hairline bg-surface-1 text-center hover:border-accent-500/30 transition-colors">
        <div class="text-2xl font-bold text-accent-500">0ms</div>
        <div class="text-sm text-ink-muted mt-1">First Contentful Paint</div>
      </div>
      <div class="p-4 rounded-lg border border-hairline bg-surface-1 text-center hover:border-accent-500/30 transition-colors">
        <div class="text-2xl font-bold text-accent-500">&lt;100KB</div>
        <div class="text-sm text-ink-muted mt-1">Initial Bundle Size</div>
      </div>
      <div class="p-4 rounded-lg border border-hairline bg-surface-1 text-center hover:border-accent-500/30 transition-colors">
        <div class="text-2xl font-bold text-accent-500">0.8s</div>
        <div class="text-sm text-ink-muted mt-1">Time to Interactive</div>
      </div>
    </div>
  </div>
</section>
