---
import { courses } from '@/config/courses';
import { getTechLogo, hasValidLogo } from '@/utils/techLogos';

interface Tech {
  name: string;
  category: 'frontend' | 'backend' | 'devops' | 'mobile' | 'design-ux' | 'data-analyst' | 'ai-engineer' | 'data-engineer' | null;
}

interface Props {
  title?: string;
  lang?: 'pt' | 'en';
}

// Extrair tecnologias dos cursos
const courseTechs = new Set<string>();
courses.forEach((course) => {
  course.technologies.forEach((tech) => {
    courseTechs.add(tech);
  });
});

// Categorizar tecnologias com mais precisão
const categorizeTech = (tech: string): 'frontend' | 'backend' | 'devops' | 'mobile' | 'design-ux' | 'data-analyst' | 'ai-engineer' | 'data-engineer' | null => {
  const frontendKeywords = ['react', 'vue', 'astro', 'next', 'typescript', 'html', 'css', 'javascript', 'tailwind', 'bootstrap', 'sass', 'jquery', 'flexbox', 'responsive design'];
  const backendKeywords = ['node', 'python', 'php', 'postgresql', 'api', 'graphql', 'database', 'mysql', 'mongodb', 'express', 'fastapi', 'rest', 'laravel', 'java', 'go', 'sql', 'http', 'bash', 'shell', 'servlet', 'jdbc', 'spring'];
  const devopsKeywords = ['docker', 'kubernetes', 'devops', 'ci/cd', 'jenkins', 'github actions', 'aws', 'google cloud', 'azure', 'terraform', 'ansible', 'security', 'devsecops', 'cybersecurity', 'owasp', 'linux', 'vim', 'git', 'version control', 'command line', 'terminal'];
  const mobileKeywords = ['android', 'mobile development', 'ios', 'react native', 'flutter', 'kotlin', 'swift'];
  const designUxKeywords = ['figma', 'adobe xd', 'ux design', 'ui/ux', 'user experience', 'photoshop', 'wireframe', 'prototype', 'gestalt', 'accessibility', 'design'];
  const dataAnalystKeywords = ['data analyst', 'business intelligence', 'bi', 'analytics', 'tableau', 'power bi', 'excel', 'sql analytics'];
  const aiEngineerKeywords = ['ai', 'artificial intelligence', 'claude', 'machine learning', 'deep learning', 'nlp', 'anthropic', 'chatgpt', 'generative', 'langchain', 'pytorch', 'tensorflow', 'ai engineer', 'prompt engineering', 'llm'];
  const dataEngineerKeywords = ['data engineer', 'data science', 'pandas', 'spark', 'etl', 'data pipeline', 'airflow', 'snowflake'];

  const lowerTech = tech.toLowerCase();

  // Match por palavra inteira (evita 'go' casando dentro de 'google cloud')
  const matchesKeyword = (keyword: string) =>
    keyword.includes(' ')
      ? lowerTech.includes(keyword)
      : new RegExp(`(^|[^a-z0-9])${keyword}([^a-z0-9]|$)`).test(lowerTech);

  // Ordem importa: categorias mais específicas antes das mais genéricas
  // (ex.: 'sql analytics' precisa ser reconhecida como data-analyst antes de 'sql' cair em backend)
  if (mobileKeywords.some(matchesKeyword)) return 'mobile';
  if (designUxKeywords.some(matchesKeyword)) return 'design-ux';
  if (dataAnalystKeywords.some(matchesKeyword)) return 'data-analyst';
  if (aiEngineerKeywords.some(matchesKeyword)) return 'ai-engineer';
  if (dataEngineerKeywords.some(matchesKeyword)) return 'data-engineer';
  if (frontendKeywords.some(matchesKeyword)) return 'frontend';
  if (backendKeywords.some(matchesKeyword)) return 'backend';
  if (devopsKeywords.some(matchesKeyword)) return 'devops';

  return null;
};

const techOrderByCategory: Record<string, Record<string, number>> = {
  frontend: {
    // base → linguagens → frameworks → ferramentas
    'HTML5': 1, 'HTML': 1,
    'CSS': 2, 'CSS3': 2,
    'JavaScript': 3,
    'TypeScript': 4,
    'Bootstrap': 5,
    'Tailwind CSS': 6,
    'Vue.js': 7, 'Vue': 7,
    'React': 8,
    'Next.js': 9,
    'Astro': 10,
  },
  backend: {
    // linguagens → frameworks → bancos → APIs
    'Python': 1,
    'PHP': 2,
    'Java': 3,
    'Go': 4,
    'Node.js': 5, 'Node': 5,
    'Express': 6,
    'FastAPI': 7,
    'Laravel': 8,
    'Bash': 9,
    'SQL': 10,
    'MySQL': 11,
    'PostgreSQL': 12,
    'MongoDB': 13,
    'REST': 14,
    'GraphQL': 15,
    'HTTP': 16,
  },
  devops: {
    // controle → terminal → containers → cloud → segurança
    'Git': 1,
    'GitHub Actions': 2,
    'Linux': 3,
    'Bash': 4,
    'Vim': 5,
    'Docker': 6,
    'Kubernetes': 7,
    'Terraform': 8,
    'Ansible': 9,
    'AWS': 10,
    'Google Cloud': 11,
    'Azure': 12,
    'Security': 13, 'Cybersecurity': 13,
    'OWASP': 14,
  },
  'ai-engineer': {
    // fundamentos → modelos → frameworks → ferramentas
    'Machine Learning': 1,
    'Deep Learning': 2,
    'NLP': 3,
    'PyTorch': 4,
    'TensorFlow': 5,
    'Anthropic': 6,
    'Claude': 7,
    'ChatGPT': 8,
    'LangChain': 9,
  },
  'data-engineer': {
    // base → ferramentas → plataformas
    'SQL': 1,
    'Python': 1,
    'Pandas': 2,
    'Spark': 3,
    'ETL': 4,
    'Airflow': 5,
    'Snowflake': 6,
  },
  mobile: {
    // linguagem base → plataforma → frameworks
    'Java': 1,
    'Android': 2,
    'Kotlin': 3,
    'Swift': 4,
    'React Native': 5,
    'Flutter': 6,
  },
  'design-ux': {
    // pesquisa → wireframe → prototipagem → ferramentas
    'UX Design': 1,
    'Figma': 2,
    'Adobe XD': 3,
    'Photoshop': 4,
  },
  'data-analyst': {
    // base → ferramentas → visualização
    'Excel': 1,
    'SQL Analytics': 2,
    'Power BI': 3,
    'Tableau': 4,
  },
};

const getTechOrder = (name: string, category: string): number => {
  const exact = techOrderByCategory[category]?.[name];
  if (exact !== undefined) return exact;
  // fallback: ordem pelo nome original (mantém techs sem mapeamento no final)
  return 999;
};

const techs: Tech[] = Array.from(courseTechs)
  .filter((name) => hasValidLogo(name))
  .map((name) => ({
    name,
    category: categorizeTech(name),
  }))
  .filter((tech) => tech.category !== null)
  .sort((a, b) => {
    const orderA = getTechOrder(a.name, a.category as string);
    const orderB = getTechOrder(b.name, b.category as string);
    if (orderA !== orderB) return orderA - orderB;
    return a.name.localeCompare(b.name);
  });

const techsByCategory = {
  frontend: techs.filter((t) => t.category === 'frontend'),
  backend: techs.filter((t) => t.category === 'backend'),
  devops: techs.filter((t) => t.category === 'devops'),
  mobile: techs.filter((t) => t.category === 'mobile'),
  'design-ux': techs.filter((t) => t.category === 'design-ux'),
  'ai-engineer': techs.filter((t) => t.category === 'ai-engineer'),
  'data-analyst': techs.filter((t) => t.category === 'data-analyst'),
  'data-engineer': techs.filter((t) => t.category === 'data-engineer'),
};

const { title = 'Tech Stack', lang = 'pt' } = Astro.props;
const subtitle = lang === 'pt'
  ? 'Tecnologias que uso para construir soluções inovadoras e escaláveis.'
  : 'Technologies I use to build innovative and scalable solutions.';

// Duplicar arrays para preencher o espaço e efeito infinito
const duplicateTechsForScroll = (techs: Tech[]) => {
  if (techs.length === 0) return [];
  // Duplicar 4x para garantir preenchimento contínuo
  return Array(4).fill(0).flatMap(() => techs);
};

const duplicatedTechs = {
  frontend: duplicateTechsForScroll(techsByCategory.frontend),
  backend: duplicateTechsForScroll(techsByCategory.backend),
  devops: duplicateTechsForScroll(techsByCategory.devops),
  mobile: duplicateTechsForScroll(techsByCategory.mobile),
  'design-ux': duplicateTechsForScroll(techsByCategory['design-ux']),
  'ai-engineer': duplicateTechsForScroll(techsByCategory['ai-engineer']),
  'data-analyst': duplicateTechsForScroll(techsByCategory['data-analyst']),
  'data-engineer': duplicateTechsForScroll(techsByCategory['data-engineer']),
};
---

<section class="bg-canvas py-20 space-y-12 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-8">
    <div>
      <h2 class="text-display-lg font-semibold text-ink">{title}</h2>
      <p class="text-body-lg text-ink-muted max-w-3xl mt-4">{subtitle}</p>
    </div>
  </div>

  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-10">
    {Object.entries(techsByCategory)
      .filter(([_, items]) => items.length > 0)
      .map(([category, items]) => (
      (
      <div class="space-y-4">
        <div>
          <h3 class="text-headline font-semibold text-primary">
            {category === 'frontend' && 'Frontend'}
            {category === 'backend' && 'Backend'}
            {category === 'devops' && 'DevOps'}
            {category === 'mobile' && 'Mobile'}
            {category === 'design-ux' && 'Design & UX'}
            {category === 'ai-engineer' && 'AI Engineer'}
            {category === 'data-analyst' && 'Data Analyst'}
            {category === 'data-engineer' && 'Data Engineer'}
          </h3>
        </div>

        <div class="relative h-20 overflow-hidden">
          {/* Gradient overlay left e right */}
          <div class="absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-canvas to-transparent z-10 pointer-events-none"></div>
          <div class="absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-canvas to-transparent z-10 pointer-events-none"></div>

          {/* Tech carousel horizontal */}
          <div class="animate-scroll-horizontal flex gap-3 py-2 px-4">
            {duplicatedTechs[category as keyof typeof duplicatedTechs].map((tech, idx) => {
              const logo = getTechLogo(tech.name);
              return (
                <div
                  key={`${tech.name}-${idx}`}
                  class="tech-card inline-flex items-center gap-2 px-3 py-2 rounded-md bg-surface-2 hover:bg-surface-3 transition-all duration-300 group flex-shrink-0 cursor-pointer border border-hairline"
                >
                  <img
                    src={logo.logo}
                    alt={tech.name}
                    class="w-4 h-4 flex-shrink-0 object-contain opacity-100 group-hover:opacity-100 transition-opacity"
                    style="filter: drop-shadow(0 0 0.5px rgba(0,0,0,0.2))"
                    loading="lazy"
                    crossorigin="anonymous"
                  />
                  <span class="text-caption text-ink-subtle font-medium group-hover:text-ink-muted transition-colors whitespace-nowrap">
                    {tech.name}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      </div>
      )
    ))}
  </div>
</section>

<style>
  @keyframes scroll-horizontal {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  .animate-scroll-horizontal {
    animation: scroll-horizontal 25s linear infinite;
    animation-play-state: running;
  }

  .animate-scroll-horizontal:hover {
    animation-play-state: paused;
  }

  .tech-card {
    position: relative;
  }

  /* Light mode: black icons stay normal */
  img.is-black {
    filter: drop-shadow(0 0 0.5px rgba(0,0,0,0.2)) !important;
  }

  /* Dark mode: invert black icons to white */
  .dark img.is-black {
    filter: invert(1) drop-shadow(0 0 0.5px rgba(255,255,255,0.2)) !important;
  }

  img.is-colored {
    filter: drop-shadow(0 0 0.5px rgba(0,0,0,0.2)) !important;
  }

  .dark img.is-colored {
    filter: drop-shadow(0 0 0.5px rgba(255,255,255,0.2)) !important;
  }
</style>

<script defer>
  document.querySelectorAll('.tech-card img').forEach((img) => {
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.naturalWidth || 100;
      canvas.height = img.naturalHeight || 100;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0);

      try {
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imageData.data;

        let r = 0, g = 0, b = 0, count = 0;
        for (let i = 0; i < data.length; i += 4) {
          if (data[i + 3] > 128) { // alpha > 128
            r += data[i];
            g += data[i + 1];
            b += data[i + 2];
            count++;
          }
        }

        if (count > 0) {
          r /= count;
          g /= count;
          b /= count;

          // Se RGB é muito escuro (preto/cinza escuro)
          const brightness = (r + g + b) / 3;
          const isGray = Math.abs(r - g) < 20 && Math.abs(g - b) < 20 && Math.abs(r - b) < 20;

          if (brightness < 100 && isGray) {
            img.classList.add('is-black');
          } else {
            img.classList.add('is-colored');
          }
        }
      } catch (e) {
        // Se não conseguir analisar, deixa como colorido
        img.classList.add('is-colored');
      }
    };
  });
</script>
