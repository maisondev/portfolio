---
import { type Language } from '@/i18n/utils';
import { FileText, ExternalLink, Trophy } from '@lucide/astro';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const contests = lang === 'pt' ? [
  {
    position: 'Técnico Municipal - Tecnologia da Informação (Informática)',
    organization: 'Prefeitura de Manaus',
    year: '2010',
    banca: 'Fundação Conesul de Desenvolvimento',
    classification: '1º lugar',
    totalVacancies: 10,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '',
  },
  {
    position: 'Desenvolvedor de Software',
    organization: 'PRODAM-AM (Empresa de Processamento de Dados do Amazonas)',
    year: '2018',
    banca: 'Fundação Professor Carlos Augusto Bittencourt - FUNCAB',
    classification: '21º lugar',
    totalVacancies: 24,
    type: 'edital',
    salary: 'R$ 3.063,86',
    editalUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/Edital.pdf',
    convocacaoUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/24a-CVGP-Site-PRODAM-em-3jul18.pdf',
    officialDiary: '#',
  },
  {
    position: 'Gerente de Informática',
    organization: 'Prefeitura de Manaus - SEMTRAD',
    year: '2013',
    banca: 'CESGRANRIO',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '#',
  },
  {
    position: 'Aprovado em Concurso Público',
    organization: 'SEMA-AM (Secretaria de Estado do Meio Ambiente)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: 'https://diario.imprensaoficial.am.gov.br/portal/visualizacoes/pdf/18078#/p:29/e:18078?find=Maison%20Marcel%20Madri',
  },
  {
    position: 'Aprovado em Concurso Público',
    organization: 'CGM-MANAUS (Controladoria Geral do Município)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '/documents/dom-6300-28042026.pdf',
  },
] : [
  {
    position: 'IT Technician - Information Technology (Computer Science)',
    organization: 'City of Manaus',
    year: '2010',
    banca: 'Conesul Development Foundation',
    classification: '1st place',
    totalVacancies: 10,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '',
  },
  {
    position: 'Software Developer',
    organization: 'PRODAM-AM (Amazonas Data Processing Company)',
    year: '2018',
    banca: 'Professor Carlos Augusto Bittencourt Foundation - FUNCAB',
    classification: '21st place',
    totalVacancies: 24,
    type: 'edital',
    salary: 'R$ 3.063,86',
    editalUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/Edital.pdf',
    convocacaoUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/24a-CVGP-Site-PRODAM-em-3jul18.pdf',
    officialDiary: '#',
  },
  {
    position: 'IT Manager',
    organization: 'City of Manaus - SEMTRAD',
    year: '2013',
    banca: 'CESGRANRIO',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '#',
  },
  {
    position: 'Approved in Public Contest',
    organization: 'SEMA-AM (State Department of Environment)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: 'https://diario.imprensaoficial.am.gov.br/portal/visualizacoes/pdf/18078#/p:29/e:18078?find=Maison%20Marcel%20Madri',
  },
  {
    position: 'Approved in Public Contest',
    organization: 'CGM-MANAUS (General Controller of the Municipality)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '/documents/dom-6300-28042026.pdf',
  },
];

const sortedContests = contests.sort((a, b) => parseInt(b.year) - parseInt(a.year));

const getTypeBadge = (type: string, totalVacancies: number, classification: string) => {
  if (!classification) return null;
  const classNum = parseInt(classification);
  const isFromEdital = classNum <= totalVacancies;
  return isFromEdital ? 'edital' : 'cadastro_reserva';
};

// Extract unique values for filters
const uniqueYears = Array.from(new Set(contests.map(c => c.year))).sort((a, b) => parseInt(b) - parseInt(a));
const uniqueBancas = Array.from(new Set(contests.map(c => c.banca)));
const uniqueOrganizations = Array.from(new Set(contests.map(c => c.organization)));
---

<section id={id} class="bg-canvas dark:bg-canvas py-16 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto px-6 md:px-8 space-y-8" data-contests-filter>
    {/* Filters */}
    <div class="space-y-6">
      {/* Filter by Year */}
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-ink dark:text-white uppercase tracking-widest">
          {lang === 'pt' ? 'Filtrar por ano' : 'Filter by year'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-year-filters>
          <button
            data-filter-year=""
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary text-white hover:bg-primary-hover dark:bg-primary dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Todos' : 'All'}
          </button>
          {uniqueYears.map((year) => (
            <button
              data-filter-year={year}
              class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
            >
              {year}
            </button>
          ))}
        </div>
      </div>

      {/* Filter by Banca */}
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-ink dark:text-white uppercase tracking-widest">
          {lang === 'pt' ? 'Filtrar por banca' : 'Filter by organization'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-banca-filters>
          <button
            data-filter-banca=""
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary text-white hover:bg-primary-hover dark:bg-primary dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Todas' : 'All'}
          </button>
          {uniqueBancas.map((banca) => (
            <button
              data-filter-banca={banca}
              class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
            >
              {banca.split(' - ')[1] || banca}
            </button>
          ))}
        </div>
      </div>

      {/* Filter by Organization */}
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-ink dark:text-white uppercase tracking-widest">
          {lang === 'pt' ? 'Filtrar por instituição' : 'Filter by institution'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-org-filters>
          <button
            data-filter-org=""
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary text-white hover:bg-primary-hover dark:bg-primary dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Todas' : 'All'}
          </button>
          {uniqueOrganizations.map((org) => (
            <button
              data-filter-org={org}
              class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
            >
              {org}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6" data-contests-grid>
      {sortedContests.map((contest) => {
        const badgeType = getTypeBadge(contest.type, contest.totalVacancies, contest.classification);
        const isFirstPlace = contest.classification === '1º lugar' || contest.classification === '1st place';

        return (
          <div class={`group bg-surface-1 dark:bg-surface-2 border rounded-lg p-6 transition-all duration-300 flex flex-col ${isFirstPlace ? 'border-accent-500/40 hover:border-accent-500 dark:border-accent-500/30 dark:hover:border-accent-500' : 'border-hairline hover:border-primary/50 dark:border-hairline dark:hover:border-primary/50'} hover:shadow-lg dark:hover:shadow-lg/20`}>
            {/* Header com Badge à direita */}
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-3">
                <div class="flex-1 space-y-2.5">
                  <div class="flex items-start gap-2.5">
                    {isFirstPlace && <Trophy class="w-5 h-5 text-accent-500 flex-shrink-0 mt-1" />}
                    <h3 class="text-base font-bold text-ink dark:text-white leading-tight">{contest.position}</h3>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-ink-muted dark:text-ink-muted uppercase tracking-wide">{lang === 'pt' ? 'Órgão' : 'Agency'}</p>
                    <p class="text-accent-500 dark:text-accent-400 font-semibold text-sm mt-1">{contest.organization}</p>
                  </div>
                  <div class="space-y-1.5 text-xs">
                    <p class="text-ink-muted dark:text-ink-muted"><span class="font-semibold">Banca:</span> {contest.banca.split(' - ')[1] || contest.banca}</p>
                    <p class="text-ink-muted dark:text-ink-muted"><span class="font-semibold">Ano:</span> {contest.year}</p>
                  </div>
                </div>

                {/* Modalidade Badge à Direita */}
                {badgeType && (
                  <div class="flex-shrink-0">
                    {badgeType === 'edital' ? (
                      <div class="bg-accent-500 dark:bg-accent-500 text-black dark:text-black px-3 py-2 rounded-md text-xs font-bold flex items-center gap-2 min-w-max hover:bg-accent-600 dark:hover:bg-accent-600 transition-colors" data-filter="edital" title={lang === 'pt' ? 'Aprovado nas vagas diretas' : 'Approved in direct vacancies'}>
                        <span class="text-sm">✓</span>
                        <span>{lang === 'pt' ? 'Vagas' : 'Direct'}</span>
                      </div>
                    ) : (
                      <div class="bg-primary dark:bg-primary text-white dark:text-white px-3 py-2 rounded-md text-xs font-bold flex items-center gap-2 min-w-max hover:bg-primary-hover dark:hover:bg-primary-hover transition-colors" data-filter="cadastro-reserva" title={lang === 'pt' ? 'Aprovado em cadastro de reserva' : 'Approved in reserve list'}>
                        <span class="text-sm">📋</span>
                        <span>{lang === 'pt' ? 'Reserva' : 'Reserve'}</span>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>

            {/* Info */}
            <div class="flex-grow">
              <div class="space-y-3 pt-4 border-t border-hairline dark:border-hairline">
                <div class="grid grid-cols-2 gap-4">
                  {/* Classificação */}
                  {contest.classification && (
                    <div>
                      <p class="text-xs font-semibold text-ink-muted dark:text-ink-muted uppercase tracking-wide">{lang === 'pt' ? 'Ranking' : 'Ranking'}</p>
                      <p class="text-base font-bold text-accent-500 dark:text-accent-400 mt-1">{contest.classification}</p>
                    </div>
                  )}

                  {/* Vagas */}
                  {contest.totalVacancies > 0 && (
                    <div>
                      <p class="text-xs font-semibold text-ink-muted dark:text-ink-muted uppercase tracking-wide">{lang === 'pt' ? 'Vagas' : 'Vacancies'}</p>
                      <p class="text-base font-bold text-ink dark:text-white mt-1">{contest.totalVacancies}</p>
                    </div>
                  )}
                </div>

                {/* Salário */}
                {contest.salary && (
                  <div class="pt-2 border-t border-hairline/50 dark:border-hairline/50">
                    <p class="text-xs font-semibold text-ink-muted dark:text-ink-muted uppercase tracking-wide">{lang === 'pt' ? 'Salário' : 'Salary'}</p>
                    <p class="text-sm font-bold text-ink dark:text-white mt-1">{contest.salary}</p>
                  </div>
                )}
              </div>
            </div>

            {/* Links Section - Always at bottom */}
            {(contest.editalUrl || contest.convocacaoUrl || contest.officialDiary !== '#') && (
              <div class="pt-4 border-t border-hairline dark:border-hairline">
                <p class="text-xs font-semibold text-ink-muted dark:text-ink-muted uppercase tracking-wide mb-3">{lang === 'pt' ? 'Documentos' : 'Documents'}</p>
                <div class="flex flex-wrap gap-2">
                  {contest.editalUrl && (
                    <a
                      href={contest.editalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 bg-surface-2 dark:bg-surface-3 hover:bg-surface-3 dark:hover:bg-surface-4 text-primary dark:text-primary hover:text-primary-hover dark:hover:text-primary-hover text-xs px-3 py-2 rounded-md transition-colors font-medium"
                      title={lang === 'pt' ? 'Edital' : 'Announcement'}
                    >
                      <ExternalLink class="w-4 h-4" />
                      {lang === 'pt' ? 'Edital' : 'Announce'}
                    </a>
                  )}
                  {contest.convocacaoUrl && (
                    <a
                      href={contest.convocacaoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 bg-surface-2 dark:bg-surface-3 hover:bg-surface-3 dark:hover:bg-surface-4 text-primary dark:text-primary hover:text-primary-hover dark:hover:text-primary-hover text-xs px-3 py-2 rounded-md transition-colors font-medium"
                      title={lang === 'pt' ? 'Convocação' : 'Call'}
                    >
                      <ExternalLink class="w-4 h-4" />
                      {lang === 'pt' ? 'Convoc.' : 'Call'}
                    </a>
                  )}
                  {contest.officialDiary !== '#' && (
                    <a
                      href={contest.officialDiary}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 bg-surface-2 dark:bg-surface-3 hover:bg-surface-3 dark:hover:bg-surface-4 text-primary dark:text-primary hover:text-primary-hover dark:hover:text-primary-hover text-xs px-3 py-2 rounded-md transition-colors font-medium"
                      title={lang === 'pt' ? 'Diário Oficial' : 'Official Journal'}
                    >
                      <ExternalLink class="w-4 h-4" />
                      {lang === 'pt' ? 'D.O.' : 'Journal'}
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
