<section id={id} class="bg-canvas dark:bg-canvas py-16 md:py-24">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto px-6 md:px-8 space-y-12" data-contests-filter>
    {/* Filters and Sorting Panel */}
    <div class="bg-surface-1 dark:bg-surface-2 border border-hairline dark:border-hairline rounded-xl p-6 md:p-8 space-y-6">
      {/* Filter by Year */}
      <div class="space-y-3">
        <h3 class={labelField('year')}>
          {lang === 'pt' ? 'Filtrar por ano' : 'Filter by year'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-year-filters>
          <button
            data-filter-year=""
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary dark:bg-primary text-white dark:text-white hover:bg-primary-hover dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Todos' : 'All'} <span class="font-semibold">({totalContests})</span>
          </button>
          {uniqueYears.map((year) => (
            <button
              data-filter-year={year}
              class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
            >
              {year} <span class="font-semibold">({countByYear(year)})</span>
            </button>
          ))}
        </div>
      </div>

      {/* Filter by Banca */}
      <div class="space-y-3">
        <h3 class={labelField('banca')}>
          {lang === 'pt' ? 'Filtrar por banca' : 'Filter by organization'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-banca-filters>
          <button
            data-filter-banca=""
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary dark:bg-primary text-white dark:text-white hover:bg-primary-hover dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Todas' : 'All'} <span class="font-semibold">({totalContests})</span>
          </button>
          {uniqueBancas.map((banca) => (
            <button
              data-filter-banca={banca}
              class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
            >
              {banca.split(' - ')[1] || banca} <span class="font-semibold">({countByBanca(banca)})</span>
            </button>
          ))}
        </div>
      </div>

      {/* Filter by Organization */}
      <div class="space-y-3">
        <h3 class={labelField('organization')}>
          {lang === 'pt' ? 'Filtrar por instituição' : 'Filter by institution'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-org-filters>
          <button
            data-filter-org=""
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary dark:bg-primary text-white dark:text-white hover:bg-primary-hover dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Todas' : 'All'} <span class="font-semibold">({totalContests})</span>
          </button>
          {uniqueOrganizations.map((org) => (
            <button
              data-filter-org={org}
              class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
            >
              {org} <span class="font-semibold">({countByOrg(org)})</span>
            </button>
          ))}
        </div>
      </div>

      {/* Filter by Status (Vagas vs Reserva) */}
      <div class="space-y-3">
        <h3 class={labelField('status')}>
          {lang === 'pt' ? 'Filtrar por tipo de aprovação' : 'Filter by approval type'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-status-filters>
          <button
            data-filter-status=""
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary dark:bg-primary text-white dark:text-white hover:bg-primary-hover dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Todos' : 'All'} <span class="font-semibold">({totalContests})</span>
          </button>
          <button
            data-filter-status="vagas"
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
          >
            {lang === 'pt' ? 'Vagas Diretas' : 'Direct Vacancies'} <span class="font-semibold">({contestsVagas})</span>
          </button>
          <button
            data-filter-status="reserva"
            class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
          >
            {lang === 'pt' ? 'Cadastro de Reserva' : 'Reserve List'} <span class="font-semibold">({contestsReserva})</span>
          </button>
        </div>
      </div>

      {/* Sort by */}
      <div class="space-y-3 border-t border-hairline dark:border-hairline pt-6">
        <h3 class={labelField('sort')}>
          {lang === 'pt' ? 'Ordenar por' : 'Sort by'}
        </h3>
        <div class="flex flex-wrap gap-2.5" data-sort-buttons>
          <button
            data-sort="default"
            class="sort-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-primary dark:bg-primary text-white dark:text-white hover:bg-primary-hover dark:hover:bg-primary-hover"
          >
            {lang === 'pt' ? 'Padrão' : 'Default'}
          </button>
          <button
            data-sort="year-desc"
            class="sort-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
          >
            {lang === 'pt' ? 'Ano (Recente)' : 'Year (Recent)'}
          </button>
          <button
            data-sort="year-asc"
            class="sort-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
          >
            {lang === 'pt' ? 'Ano (Antigo)' : 'Year (Oldest)'}
          </button>
          <button
            data-sort="ranking"
            class="sort-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
          >
            {lang === 'pt' ? 'Ranking (Melhor)' : 'Ranking (Best)'}
          </button>
          <button
            data-sort="salary"
            class="sort-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-surface-1 dark:bg-surface-2 text-ink-muted dark:text-ink-muted border border-hairline dark:border-hairline hover:border-primary/50 dark:hover:border-primary/50"
          >
            {lang === 'pt' ? 'Salário (Maior)' : 'Salary (Highest)'}
          </button>
        </div>
      </div>
    </div>

    {/* Contests Grid */}
    <div class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6" data-contests-grid>
      {sortedContests.map((contest) => {
        const badgeType = getTypeBadge(contest.totalVacancies || 0, contest.classification || '');
        const isFirstPlace = contest.classification?.includes('1º') || contest.classification?.includes('1st');
        const hasDocuments = contest.documents && contest.documents.length > 0;
        const classNum = contest.classification ? parseInt(contest.classification.split('º')[0].split('th')[0]) : 0;
        const isReserva = classNum > (contest.totalVacancies || 0);
        const statusType = isReserva ? 'reserva' : 'vagas';

        return (
          <div
            class={`group bg-surface-1 dark:bg-surface-2 border rounded-lg p-6 transition-all duration-300 flex flex-col ${isFirstPlace ? 'border-accent-500/40 hover:border-accent-500 dark:border-accent-500/30 dark:hover:border-accent-500' : 'border-hairline hover:border-primary/50 dark:border-hairline dark:hover:border-primary/50'} hover:shadow-lg dark:hover:shadow-lg/20`}
            data-year={contest.year}
            data-banca={contest.banca}
            data-org={contest.organization}
            data-status={statusType}
            data-ranking={contest.classification || ''}
            data-salary={contest.salary || ''}
          >

            {/* Header */}
            <div class="space-y-3 pb-4 border-b border-hairline dark:border-hairline">
              <div class="flex items-start justify-between gap-3">
                <div class="flex-1 space-y-2.5">
                  <div class="flex items-start gap-2.5">
                    {isFirstPlace && <Trophy class="w-5 h-5 text-accent-500 flex-shrink-0 mt-1" />}
                    <h3 class="text-base font-bold text-ink dark:text-white leading-tight">{contest.position}</h3>
                  </div>

                  {/* Órgão */}
                  <div>
                    <p class={labelField('org')}>
                      {lang === 'pt' ? 'Órgão' : 'Agency'}
                    </p>
                    <p class={valueField('org')}>{contest.organization}</p>
                  </div>
                </div>

                {/* Badge */}
                {badgeType && (
                  <div class="flex-shrink-0">
                    {badgeType === 'edital' ? (
                      <div class="bg-semantic-success dark:bg-semantic-success text-white dark:text-white px-3 py-2 rounded-md text-xs font-bold flex items-center gap-2 min-w-max hover:brightness-110 dark:hover:brightness-110 transition-all border border-semantic-success dark:border-semantic-success" title={lang === 'pt' ? 'Aprovado nas vagas diretas' : 'Approved in direct vacancies'}>
                        <CheckCircle2 class="w-4 h-4 text-white dark:text-white flex-shrink-0" />
                        <span>{lang === 'pt' ? 'Vagas' : 'Direct'}</span>
                      </div>
                    ) : (
                      <div class="bg-primary dark:bg-primary text-white dark:text-white px-3 py-2 rounded-md text-xs font-bold flex items-center gap-2 min-w-max hover:bg-primary-hover dark:hover:bg-primary-hover transition-colors border border-primary-700 dark:border-primary-400" title={lang === 'pt' ? 'Aprovado em cadastro de reserva' : 'Approved in reserve list'}>
                        <FileText class="w-4 h-4 text-white dark:text-white flex-shrink-0" />
                        <span>{lang === 'pt' ? 'Reserva' : 'Reserve'}</span>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>

            {/* Details Section */}
            <div class="flex-grow py-3">
              {/* Banca, Ano, Ranking, Vagas e Salário - Grid 3 colunas */}
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-1">
                {/* Coluna 1: Banca */}
                <div>
                  <p class={labelField('banca')}>
                    {lang === 'pt' ? 'Banca' : 'Organization'}
                  </p>
                  {contest.concursoLink ? (
                    <a href={contest.concursoLink} target="_blank" rel="noopener noreferrer" class={`${valueField('banca')} text-primary hover:text-primary-hover dark:text-primary dark:hover:text-primary-hover transition-colors inline-block underline decoration-1 underline-offset-2`}>{contest.banca || '—'}</a>
                  ) : (
                    <p class={valueField('banca')}>{contest.banca || '—'}</p>
                  )}
                </div>

                {/* Coluna 2: Ano */}
                <div>
                  <p class={labelField('ano')}>
                    {lang === 'pt' ? 'Ano' : 'Year'}
                  </p>
                  <p class={valueField('ano')}>{contest.year || '—'}</p>
                </div>

                {/* Coluna 3: Vazio na primeira linha */}
                <div class="border-t border-hairline/50 dark:border-hairline/50 md:border-t-0"></div>

                {/* Coluna 1: Ranking */}
                <div class="border-t border-hairline/50 dark:border-hairline/50 md:border-t-0 pt-3 md:pt-0">
                  <p class={labelField('ranking')}>
                    {lang === 'pt' ? 'Ranking' : 'Ranking'}
                  </p>
                  <p class={valueField('ranking')}>{contest.classification || '—'}</p>
                </div>

                {/* Coluna 2: Vagas */}
                <div class="border-t border-hairline/50 dark:border-hairline/50 md:border-t-0 pt-3 md:pt-0">
                  <p class={labelField('vagas')}>
                    {lang === 'pt' ? 'Vagas' : 'Vacancies'}
                  </p>
                  <p class={valueField('vagas')}>{contest.totalVacancies || '—'}</p>
                </div>

                {/* Coluna 3: Salário */}
                {contest.salary && (
                  <div class="border-t border-hairline/50 dark:border-hairline/50 md:border-t-0 pt-3 md:pt-0">
                    <p class={labelField('salary')}>
                      {lang === 'pt' ? 'Salário' : 'Salary'}
                    </p>
                    <p class={valueField('salary')}>{contest.salary || '—'}</p>
                  </div>
                )}
              </div>
            </div>

            {/* Documents Section */}
            <div class="pt-4 border-t border-hairline dark:border-hairline">
              <p class={labelField('documents')}>
                {lang === 'pt' ? 'Documentos' : 'Documents'}
              </p>
              {hasDocuments && contest.documents!.length > 0 ? (
                <div class="flex flex-wrap gap-2 mt-3">
                  {contest.documents!.map((doc) => (
                    <button
                      class="doc-btn inline-flex items-center gap-2 bg-surface-2 dark:bg-surface-3 hover:bg-surface-3 dark:hover:bg-surface-4 text-primary dark:text-primary hover:text-primary-hover dark:hover:text-primary-hover text-xs px-3 py-2 rounded-md transition-colors font-medium"
                      data-doc-title={doc.title}
                      data-doc-url={doc.url}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 flex-shrink-0">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                        <polyline points="17 21 17 13 7 13 7 21"/>
                        <polyline points="7 3 7 8 15 8"/>
                      </svg>
                      <span>{doc.title}</span>
                    </button>
                  ))}
                </div>
              ) : (
                <p class="text-xs text-ink-muted dark:text-ink-muted mt-2">—</p>
              )}
            </div>
          </div>
        );
      })}
      </div>
    </div>
  </div>
</section>

{/* Modal para visualizar documento PDF */}
<dialog id="docModal" class="backdrop:bg-black/80 rounded-xl border border-hairline-strong bg-surface-1 dark:bg-surface-2 p-6 w-full max-w-5xl max-h-[90vh] overflow-auto">
  <div class="flex justify-between items-center mb-4 sticky top-0 bg-surface-1 dark:bg-surface-2 z-50 pb-4 border-b border-hairline dark:border-hairline">
    <h3 class="text-lg font-semibold text-ink dark:text-white" id="docTitle">Visualizar Documento</h3>
    <div class="flex items-center gap-2">
      <a id="downloadDocLink" href="#" target="_blank" rel="noopener noreferrer" class="text-primary dark:text-primary hover:text-primary-hover dark:hover:text-primary-hover transition-colors p-2 hover:bg-surface-2 dark:hover:bg-surface-3 rounded-md" title={lang === 'pt' ? 'Baixar documento' : 'Download document'}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </a>
      <button id="closeDocModal" class="text-ink-muted dark:text-ink-muted hover:text-ink dark:hover:text-white transition-colors p-2 hover:bg-surface-2 dark:hover:bg-surface-3 rounded-md">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="flex flex-col items-center gap-4">
    <iframe id="docFrame" src="" title="PDF Document" class="w-full h-[calc(90vh-150px)] border border-hairline dark:border-hairline rounded-lg"></iframe>
  </div>
</dialog>

<style>
  dialog#docModal::backdrop {
    background-color: rgba(0, 0, 0, 0.8);
  }
</style>

<script>
  const docModal = document.getElementById('docModal') as HTMLDialogElement;
  const closeBtnDoc = document.getElementById('closeDocModal');
  const docFrame = document.getElementById('docFrame') as HTMLIFrameElement;
  const docTitle = document.getElementById('docTitle');
  const downloadDocLink = document.getElementById('downloadDocLink') as HTMLAnchorElement;
  const docButtons = document.querySelectorAll('.doc-btn');

  docButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-doc-title');
      const url = btn.getAttribute('data-doc-url');

      docTitle!.textContent = `${title}`;

      if (url) {
        docFrame.src = url;
        downloadDocLink.href = url;
      }

      docModal.showModal();
    });
  });

  closeBtnDoc?.addEventListener('click', () => {
    docModal.close();
    docFrame.src = '';
  });

  docModal?.addEventListener('click', (e) => {
    if (e.target === docModal) {
      docModal.close();
      docFrame.src = '';
    }
  });

  // Fechar com ESC
  document.addEventListener('keydown', (e) => {
    if (docModal?.open && e.key === 'Escape') {
      docModal.close();
      docFrame.src = '';
    }
  });

  // ==================== ORDENAÇÃO ====================
  const sortButtons = document.querySelectorAll('.sort-btn');
  const sortContestsGrid = document.querySelector('[data-contests-grid]');

  sortButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const sortType = btn.getAttribute('data-sort');
      const cards = Array.from(sortContestsGrid!.querySelectorAll('[data-year]')) as HTMLElement[];

      // Remove active class from all buttons
      sortButtons.forEach(b => {
        b.classList.remove('bg-primary', 'text-white', 'dark:bg-primary', 'dark:text-white');
        b.classList.add('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
      });

      // Add active class to clicked button
      btn.classList.remove('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
      btn.classList.add('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');

      // Sort cards
      if (sortType === 'default') {
        cards.sort((a, b) => parseInt(b.getAttribute('data-year')!) - parseInt(a.getAttribute('data-year')!));
      } else if (sortType === 'year-desc') {
        cards.sort((a, b) => parseInt(b.getAttribute('data-year')!) - parseInt(a.getAttribute('data-year')!));
      } else if (sortType === 'year-asc') {
        cards.sort((a, b) => parseInt(a.getAttribute('data-year')!) - parseInt(b.getAttribute('data-year')!));
      } else if (sortType === 'ranking') {
        cards.sort((a, b) => {
          const aRank = parseInt(a.getAttribute('data-ranking')!.split('º')[0].split('th')[0]) || 9999;
          const bRank = parseInt(b.getAttribute('data-ranking')!.split('º')[0].split('th')[0]) || 9999;
          return aRank - bRank;
        });
      } else if (sortType === 'salary') {
        cards.sort((a, b) => {
          const aSalary = parseFloat(a.getAttribute('data-salary')!.replace(/[^\d,]/g, '').replace(',', '.')) || 0;
          const bSalary = parseFloat(b.getAttribute('data-salary')!.replace(/[^\d,]/g, '').replace(',', '.')) || 0;
          return bSalary - aSalary;
        });
      }

      // Re-append sorted cards
      cards.forEach(card => sortContestsGrid!.appendChild(card));
    });
  });

  // ==================== FILTROS ====================
  const filterContainer = document.querySelector('[data-contests-filter]');
  const contestsGrid = document.querySelector('[data-contests-grid]');
  const allContestCards = Array.from(document.querySelectorAll('[data-contests-grid] > div'));

  let activeFilters = {
    year: '',
    banca: '',
    org: '',
    status: ''
  };

  function applyFilters() {
    allContestCards.forEach((card) => {
      let shouldShow = true;

      // Filtro por Ano
      if (activeFilters.year) {
        const cardYear = card.getAttribute('data-year');
        shouldShow = shouldShow && cardYear === activeFilters.year;
      }

      // Filtro por Banca
      if (activeFilters.banca) {
        const cardBanca = card.getAttribute('data-banca');
        shouldShow = shouldShow && cardBanca === activeFilters.banca;
      }

      // Filtro por Organização
      if (activeFilters.org) {
        const cardOrg = card.getAttribute('data-org');
        shouldShow = shouldShow && cardOrg === activeFilters.org;
      }

      // Filtro por Status (Vagas vs Reserva)
      if (activeFilters.status) {
        const cardStatus = card.getAttribute('data-status');
        shouldShow = shouldShow && cardStatus === activeFilters.status;
      }

      card.style.display = shouldShow ? '' : 'none';
    });
  }

  // Event listeners para os filtros
  const filterBtns = filterContainer?.querySelectorAll('.filter-btn');
  filterBtns?.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();

      const yearFilter = btn.getAttribute('data-filter-year');
      const bancaFilter = btn.getAttribute('data-filter-banca');
      const orgFilter = btn.getAttribute('data-filter-org');
      const statusFilter = btn.getAttribute('data-filter-status');

      // Atualizar filtro ativo
      if (yearFilter !== null) {
        activeFilters.year = yearFilter;
        document.querySelectorAll('[data-filter-year]').forEach(b => {
          b.classList.remove('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
          b.classList.add('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
        });
        btn.classList.add('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
        btn.classList.remove('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
      }

      if (bancaFilter !== null) {
        activeFilters.banca = bancaFilter;
        document.querySelectorAll('[data-filter-banca]').forEach(b => {
          b.classList.remove('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
          b.classList.add('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
        });
        btn.classList.add('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
        btn.classList.remove('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
      }

      if (orgFilter !== null) {
        activeFilters.org = orgFilter;
        document.querySelectorAll('[data-filter-org]').forEach(b => {
          b.classList.remove('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
          b.classList.add('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
        });
        btn.classList.add('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
        btn.classList.remove('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
      }

      if (statusFilter !== null) {
        activeFilters.status = statusFilter;
        document.querySelectorAll('[data-filter-status]').forEach(b => {
          b.classList.remove('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
          b.classList.add('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
        });
        btn.classList.add('bg-primary', 'dark:bg-primary', 'text-white', 'dark:text-white');
        btn.classList.remove('bg-surface-1', 'dark:bg-surface-2', 'text-ink-muted', 'dark:text-ink-muted', 'border', 'border-hairline', 'dark:border-hairline');
      }

      applyFilters();
    });
  });
</script>

