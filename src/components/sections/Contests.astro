---
import { type Language } from '@/i18n/utils';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const contests = lang === 'pt' ? [
  {
    position: 'Desenvolvedor de Software',
    organization: 'PRODAM-AM (Empresa de Processamento de Dados do Amazonas)',
    year: '2018',
    status: 'Aprovado',
    banca: 'CESGRANRIO/IBFC',
    officialDiary: '#',
  },
  {
    position: 'Gerente de Informática',
    organization: 'Prefeitura de Manaus - SEMTRAD',
    year: '2013',
    status: 'Aprovado',
    banca: 'CESGRANRIO',
    officialDiary: '#',
  },
  {
    position: 'Aprovado em Concurso Público',
    organization: 'SEMA-AM (Secretaria de Estado do Meio Ambiente)',
    year: '2026',
    status: 'Aprovado',
    banca: 'FCC',
    officialDiary: 'https://diario.imprensaoficial.am.gov.br/portal/visualizacoes/pdf/18078#/p:29/e:18078?find=Maison%20Marcel%20Madri',
  },
  {
    position: 'Aprovado em Concurso Público',
    organization: 'CGM-MANAUS (Controladoria Geral do Município)',
    year: '2026',
    status: 'Aprovado',
    banca: 'FCC',
    officialDiary: '/documents/dom-6300-28042026.pdf',
  },
] : [
  {
    position: 'Software Developer',
    organization: 'PRODAM-AM (Amazonas Data Processing Company)',
    year: '2018',
    status: 'Approved',
    banca: 'CESGRANRIO/IBFC',
    officialDiary: '#',
  },
  {
    position: 'IT Manager',
    organization: 'City of Manaus - SEMTRAD',
    year: '2013',
    status: 'Approved',
    banca: 'CESGRANRIO',
    officialDiary: '#',
  },
  {
    position: 'Approved in Public Contest',
    organization: 'SEMA-AM (State Department of Environment)',
    year: '2026',
    status: 'Approved',
    banca: 'FCC',
    officialDiary: 'https://diario.imprensaoficial.am.gov.br/portal/visualizacoes/pdf/18078#/p:29/e:18078?find=Maison%20Marcel%20Madri',
  },
  {
    position: 'Approved in Public Contest',
    organization: 'CGM-MANAUS (General Controller of the Municipality)',
    year: '2026',
    status: 'Approved',
    banca: 'FCC',
    officialDiary: '/documents/dom-6300-28042026.pdf',
  },
];

// Ordenar concursos por ano (mais recentes primeiro)
const sortedContests = contests.sort((a, b) => parseInt(b.year) - parseInt(a.year));
---

<section id={id} class="py-20 space-y-12">
  <div class="space-y-4">
    <h1 class="text-4xl font-bold text-[#fafafa]">{lang === 'pt' ? 'Concursos Públicos' : 'Public Contests'}</h1>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      {lang === 'pt' ? 'Aprovado em múltiplos concursos públicos. Histórico de aprovações e publicações em diário oficial.' : 'Approved in multiple public contests. History of approvals and publications in official journals.'}
    </p>
  </div>

  <div class="space-y-4">
    {sortedContests.map((contest) => (
      <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 sm:p-8 hover:border-accent-500/30 transition-all duration-300 space-y-4">
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
            <div>
              <h3 class="text-xl sm:text-2xl font-bold text-[#fafafa]">{contest.position}</h3>
              <p class="text-accent-500 font-semibold text-sm sm:text-base">{contest.organization}</p>
            </div>
            <div class="flex gap-2 items-center">
              <span class="bg-accent-500/20 text-accent-400 px-3 py-1 rounded-full text-xs font-semibold">
                {contest.status}
              </span>
              <span class="text-[#a1a1a1] text-sm">{contest.year}</span>
            </div>
          </div>
          <p class="text-[#d4d4d8] text-sm">Banca: {contest.banca}</p>
        </div>

        {contest.officialDiary !== '#' && (
          <div class="pt-3 border-t border-[#2a2a2a]">
            <a
              href={contest.officialDiary}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-accent-500 hover:text-accent-400 font-semibold text-sm transition-colors"
            >
              Diário Oficial
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>
        )}
      </div>
    ))}
  </div>

  <div class="bg-accent-500/10 border border-accent-500/30 rounded-lg p-6 sm:p-8">
    <h3 class="text-lg font-semibold text-accent-400 mb-2">{lang === 'pt' ? '💼 Adicionar Novos Concursos' : '💼 Add New Contests'}</h3>
    <p class="text-[#d4d4d8] text-sm">
      {lang === 'pt' ? 'Para adicionar novos concursos aprovados, preencha os dados acima incluindo o link do diário oficial. Isso demonstra credibilidade profissional e transparência perante a administração pública.' : 'To add new approved contests, fill in the information above including the official journal link. This demonstrates professional credibility and transparency with public administration.'}
    </p>
  </div>
</section>
