---
import { type Language } from '@/i18n/utils';
import { FileText, ExternalLink } from '@lucide/astro';

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const contests = lang === 'pt' ? [
  {
    position: 'Desenvolvedor de Software',
    organization: 'PRODAM-AM (Empresa de Processamento de Dados do Amazonas)',
    year: '2018',
    banca: 'Fundação Professor Carlos Augusto Bittencourt - FUNCAB',
    classification: '21º lugar',
    totalVacancies: 24,
    type: 'edital',
    salary: 'R$ 3.063,86',
    editalUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/Edital.pdf',
    convocacaoUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/24a-CVGP-Site-PRODAM-em-3jul18.pdf',
    officialDiary: '#',
  },
  {
    position: 'Gerente de Informática',
    organization: 'Prefeitura de Manaus - SEMTRAD',
    year: '2013',
    banca: 'CESGRANRIO',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '#',
  },
  {
    position: 'Aprovado em Concurso Público',
    organization: 'SEMA-AM (Secretaria de Estado do Meio Ambiente)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: 'https://diario.imprensaoficial.am.gov.br/portal/visualizacoes/pdf/18078#/p:29/e:18078?find=Maison%20Marcel%20Madri',
  },
  {
    position: 'Aprovado em Concurso Público',
    organization: 'CGM-MANAUS (Controladoria Geral do Município)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '/documents/dom-6300-28042026.pdf',
  },
] : [
  {
    position: 'Software Developer',
    organization: 'PRODAM-AM (Amazonas Data Processing Company)',
    year: '2018',
    banca: 'Professor Carlos Augusto Bittencourt Foundation - FUNCAB',
    classification: '21st place',
    totalVacancies: 24,
    type: 'edital',
    salary: 'R$ 3.063,86',
    editalUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/Edital.pdf',
    convocacaoUrl: 'https://prodam.am.gov.br/wp-content/uploads/2011/09/24a-CVGP-Site-PRODAM-em-3jul18.pdf',
    officialDiary: '#',
  },
  {
    position: 'IT Manager',
    organization: 'City of Manaus - SEMTRAD',
    year: '2013',
    banca: 'CESGRANRIO',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '#',
  },
  {
    position: 'Approved in Public Contest',
    organization: 'SEMA-AM (State Department of Environment)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: 'https://diario.imprensaoficial.am.gov.br/portal/visualizacoes/pdf/18078#/p:29/e:18078?find=Maison%20Marcel%20Madri',
  },
  {
    position: 'Approved in Public Contest',
    organization: 'CGM-MANAUS (General Controller of the Municipality)',
    year: '2026',
    banca: 'FCC',
    classification: '',
    totalVacancies: 0,
    type: 'edital',
    salary: '',
    editalUrl: '',
    convocacaoUrl: '',
    officialDiary: '/documents/dom-6300-28042026.pdf',
  },
];

const sortedContests = contests.sort((a, b) => parseInt(b.year) - parseInt(a.year));

const getTypeBadge = (type: string, totalVacancies: number, classification: string) => {
  if (!classification) return null;
  const classNum = parseInt(classification);
  const isFromEdital = classNum <= totalVacancies;
  return isFromEdital ? 'edital' : 'cadastro_reserva';
};
---

<section id={id} class="bg-canvas py-12 md:py-16">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      {sortedContests.map((contest) => {
        const badgeType = getTypeBadge(contest.type, contest.totalVacancies, contest.classification);

        return (
          <div class="group bg-surface-1 border border-hairline rounded-lg p-3 hover:border-accent-500/50 hover:shadow-md transition-all duration-300 space-y-2.5">
            {/* Header com Badge à direita */}
            <div class="space-y-2">
              <div class="flex items-start justify-between gap-2">
                <div class="flex-1 space-y-1">
                  <h3 class="text-sm font-bold text-ink line-clamp-2">{contest.position}</h3>
                  <p class="text-accent-500 font-medium text-xs line-clamp-1">{contest.organization}</p>
                  <div class="flex items-center justify-between pt-0.5">
                    <p class="text-ink-muted text-xs truncate flex-1">Banca: {contest.banca.split(' - ')[1] || contest.banca}</p>
                    <span class="text-ink-muted text-xs font-medium whitespace-nowrap ml-1">{contest.year}</span>
                  </div>
                </div>

                {/* Modalidade Badge à Direita */}
                {badgeType && (
                  <div class="flex-shrink-0">
                    {badgeType === 'edital' ? (
                      <div class="bg-accent-500 text-black px-2 py-1.5 rounded-md text-xs font-bold flex items-center gap-1 min-w-max" data-filter="edital" title={lang === 'pt' ? 'Aprovado nas vagas diretas' : 'Approved in direct vacancies'}>
                        ✓
                        <span class="hidden sm:inline">{lang === 'pt' ? 'Vagas' : 'Direct'}</span>
                      </div>
                    ) : (
                      <div class="bg-primary text-white px-2 py-1.5 rounded-md text-xs font-bold flex items-center gap-1 min-w-max" data-filter="cadastro-reserva" title={lang === 'pt' ? 'Aprovado em cadastro de reserva' : 'Approved in reserve list'}>
                        📋
                        <span class="hidden sm:inline">{lang === 'pt' ? 'Reserva' : 'Reserve'}</span>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>

            {/* Info */}
            <div class="space-y-1.5 pt-1.5 border-t border-hairline">
              {/* Classificação */}
              {contest.classification && (
                <div class="flex items-center justify-between text-xs">
                  <span class="text-ink-muted font-semibold">{lang === 'pt' ? 'Classificação' : 'Ranking'}</span>
                  <div class="text-right">
                    <p class="font-bold text-accent-500">{contest.classification}</p>
                    {contest.totalVacancies > 0 && (
                      <p class="text-ink-muted text-xs">{lang === 'pt' ? 'de' : 'of'} {contest.totalVacancies}</p>
                    )}
                  </div>
                </div>
              )}

              {/* Salário */}
              {contest.salary && (
                <div class="flex items-center justify-between text-xs">
                  <span class="text-ink-muted font-semibold">{lang === 'pt' ? 'Salário' : 'Salary'}</span>
                  <p class="font-bold text-ink">{contest.salary}</p>
                </div>
              )}
            </div>

            {/* Links */}
            {(contest.editalUrl || contest.convocacaoUrl || contest.officialDiary !== '#') && (
              <div class="pt-1.5 border-t border-hairline">
                <div class="flex flex-wrap gap-1">
                  {contest.editalUrl && (
                    <a
                      href={contest.editalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-0.5 bg-surface-2 hover:bg-surface-3 text-primary hover:text-primary-hover text-xs px-2 py-1 rounded transition-colors"
                      title={lang === 'pt' ? 'Edital' : 'Announcement'}
                    >
                      <ExternalLink class="w-2.5 h-2.5" />
                      {lang === 'pt' ? 'Edital' : 'Announce'}
                    </a>
                  )}
                  {contest.convocacaoUrl && (
                    <a
                      href={contest.convocacaoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-0.5 bg-surface-2 hover:bg-surface-3 text-primary hover:text-primary-hover text-xs px-2 py-1 rounded transition-colors"
                      title={lang === 'pt' ? 'Convocação' : 'Call'}
                    >
                      <ExternalLink class="w-2.5 h-2.5" />
                      {lang === 'pt' ? 'Convoc.' : 'Call'}
                    </a>
                  )}
                  {contest.officialDiary !== '#' && (
                    <a
                      href={contest.officialDiary}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-0.5 bg-surface-2 hover:bg-surface-3 text-primary hover:text-primary-hover text-xs px-2 py-1 rounded transition-colors"
                      title={lang === 'pt' ? 'Diário Oficial' : 'Official Journal'}
                    >
                      <ExternalLink class="w-2.5 h-2.5" />
                      {lang === 'pt' ? 'D.O.' : 'Journal'}
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
