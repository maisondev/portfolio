---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const contests = [
  {
    position: 'Desenvolvedor de Software',
    organization: 'PRODAM-AM (Empresa de Processamento de Dados do Amazonas)',
    year: '2018',
    status: 'Aprovado',
    banca: 'CESGRANRIO/IBFC',
    officialDiary: '#',
  },
  {
    position: 'Gerente de Informática',
    organization: 'Prefeitura de Manaus - SEMTRAD',
    year: '2013',
    status: 'Aprovado',
    banca: 'CESGRANRIO',
    officialDiary: '#',
  },
];
---

<section id={id} class="py-20 space-y-12">
  <div class="space-y-4">
    <h2 class="text-4xl font-bold text-[#fafafa]">Concursos Públicos</h2>
    <p class="text-[#d4d4d8] text-lg max-w-3xl">
      Aprovado em múltiplos concursos públicos. Histórico de aprovações e publicações em diário oficial.
    </p>
  </div>

  <div class="space-y-4">
    {contests.map((contest) => (
      <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 sm:p-8 hover:border-accent-500/30 transition-all duration-300 space-y-4">
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
            <div>
              <h3 class="text-xl sm:text-2xl font-bold text-[#fafafa]">{contest.position}</h3>
              <p class="text-accent-500 font-semibold text-sm sm:text-base">{contest.organization}</p>
            </div>
            <div class="flex gap-2 items-center">
              <span class="bg-accent-500/20 text-accent-400 px-3 py-1 rounded-full text-xs font-semibold">
                {contest.status}
              </span>
              <span class="text-[#a1a1a1] text-sm">{contest.year}</span>
            </div>
          </div>
          <p class="text-[#d4d4d8] text-sm">Banca: {contest.banca}</p>
        </div>

        {contest.officialDiary !== '#' && (
          <div class="pt-3 border-t border-[#2a2a2a]">
            <a
              href={contest.officialDiary}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-accent-500 hover:text-accent-400 font-semibold text-sm transition-colors"
            >
              Diário Oficial
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>
        )}
      </div>
    ))}
  </div>

  <div class="bg-accent-500/10 border border-accent-500/30 rounded-lg p-6 sm:p-8">
    <h3 class="text-lg font-semibold text-accent-400 mb-2">💼 Adicionar Novos Concursos</h3>
    <p class="text-[#d4d4d8] text-sm">
      Para adicionar novos concursos aprovados, preencha os dados acima incluindo o link do diário oficial.
      Isso demonstra credibilidade profissional e transparência perante a administração pública.
    </p>
  </div>
</section>
