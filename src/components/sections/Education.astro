---
import { type Language } from '@/i18n/utils';
import EducationCard from '../ui/EducationCard.astro';

interface Module {
  name: string;
  date: string;
  hours: number;
  skills: string[];
  certificateUrl?: string;
  certificatePages?: string[];
}

interface EducationItem {
  degree: string;
  institution: string;
  year: string;
  description: string;
  type: 'fundamental-medio' | 'tecnico' | 'graduacao' | 'pos-graduacao';
  certificateUrl?: string;
  certificatePages?: string[];
  status?: 'completed' | 'in-progress';
  modules?: Module[];
}

interface Props {
  id?: string;
  lang?: Language;
}

const { id, lang = 'pt' } = Astro.props;

const education = [
  {
    degree: 'Especialista em Desenvolvimento Full Stack e Cloud Computing',
    institution: 'GRAN',
    year: 'Mai 2024 – Nov 2025',
    description: 'Especialização em desenvolvimento full stack com foco em tecnologias cloud e arquitetura moderna.',
    type: 'pos-graduacao',
    certificateUrl: '/certificates/FullStack-Cloud-Computing.pdf',
    certificatePages: ['/certificates/FullStack-Cloud-Computing.pdf'],
  },
  {
    degree: 'Especialista em Inteligência Artificial e Tecnologia na Gestão Pública',
    institution: 'GRAN',
    year: 'Mai 2024 – Nov 2024',
    description: 'Especialização em aplicações de IA no contexto da administração pública.',
    type: 'pos-graduacao',
    certificateUrl: '/certificates/IA-Gestao-Publica-p1.png',
    certificatePages: [
      '/certificates/IA-Gestao-Publica-p1.png',
      '/certificates/IA-Gestao-Publica-p2.png',
      '/certificates/IA-Gestao-Publica-p3.png',
      '/certificates/IA-Gestao-Publica-p4.png',
    ],
  },
  {
    degree: 'Bacharelado em Engenharia de Software',
    institution: 'Gran Faculdade',
    year: 'Out 2024 – Out 2028',
    description: 'Formação em Engenharia de Software com foco em arquitetura e desenvolvimento de sistemas de larga escala.',
    type: 'graduacao',
    status: 'in-progress',
    modules: [
      {
        name: 'Hands-on Professional / Requirements Analyst',
        date: 'maio 2025',
        hours: 340,
        skills: ['Engenharia de Software', 'Arquitetura', 'SO', 'Lógica'],
        certificateUrl: '/certificates/modulo1-eng-software.pdf',
        certificatePages: ['/certificates/modulo1-eng-software.pdf'],
      },
      {
        name: 'Data Administrator / Project Manager',
        date: 'abril 2026',
        hours: 380,
        skills: ['Banco de Dados', 'Ágil', 'Governança de TI', 'Projetos'],
        certificateUrl: '/certificates/modulo2-eng-software.pdf',
        certificatePages: ['/certificates/modulo2-eng-software.pdf'],
      },
    ],
  },
  {
    degree: 'Tecnologia em Análise e Desenvolvimento de Sistemas',
    institution: 'Instituto Federal de Educação, Ciência e Tecnologia do Amazonas (IFAM)',
    year: '2018 – 2023',
    description: 'Formação técnica em análise e desenvolvimento de sistemas, com foco em desenvolvimento de software.',
    type: 'graduacao',
    certificateUrl: '/certificates/TADS-p1.png',
    certificatePages: ['/certificates/TADS-p1.png', '/certificates/TADS-p2.png'],
  },
  {
    degree: 'Ensino Técnico em Informática',
    institution: 'Instituto Federal de Educação, Ciência e Tecnologia do Amazonas (IFAM)',
    year: 'Jan 2006 – Dez 2008',
    description: 'Formação técnica fundamental em informática e princípios de desenvolvimento.',
    type: 'tecnico',
    certificateUrl: '/documents/certificates/ifam-tecnico-informatica.pdf',
    certificatePages: ['/documents/certificates/ifam-tecnico-informatica.pdf'],
  },
  {
    degree: 'Ensino Médio',
    institution: 'Escola Estadual Ruy Araújo',
    year: '2005 – 2007',
    description: 'Formação de ensino médio.',
    type: 'fundamental-medio',
    certificateUrl: '/certificates/Ensino-Medio-p1.png',
    certificatePages: ['/certificates/Ensino-Medio-p1.png', '/certificates/Ensino-Medio-p2.png'],
  },
];

const categories = [
  { type: 'fundamental-medio', label: 'Ensino Fundamental e Médio', order: 1 },
  { type: 'tecnico', label: 'Ensino Técnico', order: 2 },
  { type: 'graduacao', label: 'Ensino Superior', order: 3 },
  { type: 'pos-graduacao', label: 'Pós-Graduações', order: 4 },
];

const educationByCategory = categories.map(cat => ({
  ...cat,
  items: education.filter(e => e.type === cat.type)
})).filter(cat => cat.items.length > 0);

const icons: Record<string, string> = {
  'fundamental-medio': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><path d="M8 7h8M8 11h8M8 15h8"/></svg>`,
  'tecnico': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"/></svg>`,
  'graduacao': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6m0 0l-8.97 4.97a2 2 0 01-2.06 0L2 16m20-6l-8.5-4.5a2 2 0 00-2 0L2 10m0 6v-6m0 0l8.97-4.97a2 2 0 012.06 0L22 10"/></svg>`,
  'pos-graduacao': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><path d="M8 7h8M8 11h8M8 15h8"/></svg>`,
  'certificacao': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
};

---

<section id={id} class="bg-canvas py-20 md:py-24 space-y-16">
  {educationByCategory.map((category) => (
    <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 space-y-4">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-6 h-6 text-primary">
          <Fragment set:html={icons[category.type as keyof typeof icons]} />
        </div>
        <h3 class="text-headline font-semibold text-ink">{category.label}</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 4xl:grid-cols-4 gap-4">
        {category.items.map((edu) => (
          <EducationCard edu={edu} lang={lang} />
        ))}
      </div>
    </div>
  ))}
  </section>
  <!-- Modal para visualizar certificado -->
  <dialog id="certModal" class="backdrop:bg-black/80 rounded-xl border border-hairline-strong bg-surface-1 p-6 w-full max-w-5xl max-h-[90vh] overflow-auto">
    <div class="flex justify-between items-center mb-4 sticky top-0 bg-surface-1 z-50">
      <h3 class="text-card-title font-semibold text-ink">Visualizar Certificado</h3>
      <button id="closeModal" class="text-ink-muted hover:text-ink transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="flex flex-col items-center gap-4">
      <!-- Exibição de imagem -->
      <img id="certImage" src="" alt="Certificado" class="max-w-full h-auto border border-hairline rounded-lg hidden" />

      <!-- Exibição de PDF -->
      <iframe id="certPdf" class="w-full h-[70vh] border border-hairline rounded-lg hidden" allowfullscreen></iframe>

      <!-- Navegação de páginas (apenas para imagens) -->
      <div id="pageNav" class="hidden flex items-center gap-4 text-sm text-ink-muted">
        <button id="prevPage" class="px-3 py-1 border border-hairline rounded-md hover:bg-surface-2 transition-colors">← Anterior</button>
        <span id="pageIndicator" class="text-ink-tertiary">Página 1 de 1</span>
        <button id="nextPage" class="px-3 py-1 border border-hairline rounded-md hover:bg-surface-2 transition-colors">Próxima →</button>
      </div>
    </div>
  </dialog>
</section>

<style>
  dialog#certModal::backdrop {
    background-color: rgba(0, 0, 0, 0.8);
  }
</style>

<script defer>
  const modal = document.getElementById('certModal');
  const closeBtn = document.getElementById('closeModal');
  const certImage = document.getElementById('certImage');
  const certPdf = document.getElementById('certPdf');
  const pageNav = document.getElementById('pageNav');
  const pageIndicator = document.getElementById('pageIndicator');
  const prevPageBtn = document.getElementById('prevPage');
  const nextPageBtn = document.getElementById('nextPage');
  const certButtons = document.querySelectorAll('.cert-btn');

  let currentPages = [];
  let currentPageIndex = 0;
  let isPdf = false;

  function updatePageDisplay() {
    if (currentPages.length === 0) return;

    // Verifica se é PDF
    isPdf = currentPages[0].toLowerCase().endsWith('.pdf');

    if (isPdf) {
      // Exibe PDF
      certPdf.src = currentPages[0];
      certPdf.classList.remove('hidden');
      certImage.classList.add('hidden');
      pageNav.classList.add('hidden');
    } else {
      // Exibe imagem
      certImage.src = currentPages[currentPageIndex];
      certImage.classList.remove('hidden');
      certPdf.classList.add('hidden');
      pageIndicator.textContent = `Página ${currentPageIndex + 1} de ${currentPages.length}`;

      if (currentPages.length > 1) {
        pageNav.classList.remove('hidden');
        if (prevPageBtn) {
          prevPageBtn.disabled = currentPageIndex === 0;
          prevPageBtn.style.opacity = currentPageIndex === 0 ? '0.5' : '1';
        }
        if (nextPageBtn) {
          nextPageBtn.disabled = currentPageIndex === currentPages.length - 1;
          nextPageBtn.style.opacity = currentPageIndex === currentPages.length - 1 ? '0.5' : '1';
        }
      } else {
        pageNav.classList.add('hidden');
      }
    }
  }

  certButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pagesJson = btn.getAttribute('data-pages');
      const firstImageUrl = btn.getAttribute('data-pdf');

      if (pagesJson) {
        currentPages = JSON.parse(pagesJson);
      } else if (firstImageUrl) {
        currentPages = [firstImageUrl];
      }

      currentPageIndex = 0;
      updatePageDisplay();
      modal.showModal();
    });
  });

  prevPageBtn?.addEventListener('click', () => {
    if (currentPageIndex > 0) {
      currentPageIndex--;
      updatePageDisplay();
    }
  });

  nextPageBtn?.addEventListener('click', () => {
    if (currentPageIndex < currentPages.length - 1) {
      currentPageIndex++;
      updatePageDisplay();
    }
  });

  closeBtn?.addEventListener('click', () => {
    modal.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  // Bloquear clique direito
  modal?.addEventListener('contextmenu', (e) => {
    if (modal?.open) {
      e.preventDefault();
      return false;
    }
  });

  // Bloquear teclas de atalho
  document.addEventListener('keydown', (e) => {
    if (modal?.open) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'p' || e.key === 'd')) {
        e.preventDefault();
        e.stopPropagation();
      }
      // Navegação com setas
      if (e.key === 'ArrowLeft') {
        prevPageBtn?.click();
      } else if (e.key === 'ArrowRight') {
        nextPageBtn?.click();
      }
    }
  }, true);
</script>
