---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const education = [
  {
    degree: 'Graduação em Tecnologia da Informação',
    institution: 'Universidade do Estado do Amazonas (UEA)',
    year: '2007',
    description: 'Formação completa em Tecnologia da Informação com foco em desenvolvimento de software e infraestrutura.',
  },
];

const certifications = [
  {
    name: 'Certificação em Desenvolvimento Web Moderno',
    issuer: 'Plataforma de Certificação',
    date: '2024',
  },
  {
    name: 'AWS Solutions Architect Associate',
    issuer: 'Amazon Web Services',
    date: '2023',
  },
  {
    name: 'Kubernetes Administrator (CKA)',
    issuer: 'Linux Foundation',
    date: '2022',
  },
];
---

<section id={id} class="py-20 space-y-12">
  <div>
    <h2 class="text-4xl font-bold text-[#fafafa] mb-8">Educação & Certificações</h2>

    <div class="space-y-6">
      <div class="space-y-4">
        <h3 class="text-2xl font-bold text-[#fafafa]">Formação Acadêmica</h3>
        <div class="space-y-4">
          {education.map((edu) => (
            <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-6 space-y-2">
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
                <div>
                  <h4 class="text-lg font-semibold text-[#fafafa]">{edu.degree}</h4>
                  <p class="text-accent-500">{edu.institution}</p>
                </div>
                <span class="text-sm text-[#a1a1a1]">{edu.year}</span>
              </div>
              <p class="text-[#d4d4d8] text-sm">{edu.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-2xl font-bold text-[#fafafa]">Certificações</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          {certifications.map((cert) => (
            <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-lg p-4 space-y-1">
              <div class="flex items-start gap-2">
                <span class="text-accent-500 text-xl mt-1">✓</span>
                <div class="flex-1">
                  <h4 class="font-semibold text-[#fafafa]">{cert.name}</h4>
                  <p class="text-[#a1a1a1] text-sm">{cert.issuer}</p>
                  <p class="text-[#a1a1a1] text-xs pt-1">{cert.date}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
