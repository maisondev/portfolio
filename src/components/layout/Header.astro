---
import SocialLinks from '@/components/ui/SocialLinks.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};

const links = [
  { href: getLocalizedPath('/'), label: t('nav.home') },
  { href: getLocalizedPath('/projects'), label: t('nav.projects') },
  { href: getLocalizedPath('/experience'), label: t('nav.experience') },
  { href: getLocalizedPath('/education'), label: t('nav.education') },
  { href: getLocalizedPath('/contests'), label: t('nav.contests') },
  { href: getLocalizedPath('/blog'), label: t('nav.blog') },
];
---

<header class="bg-[#0a0a0a] border-b border-[#2a2a2a] sticky top-0 z-50 backdrop-blur-sm bg-[#0a0a0a]/95">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
    <a href={getLocalizedPath('/')} class="text-2xl font-black text-[#fafafa] hover:text-accent-500 transition-colors tracking-wider">
      MG
    </a>

    <ul class="hidden lg:flex gap-1 items-center">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="px-3 py-2 text-sm text-[#d4d4d8] hover:text-accent-500 hover:bg-[#1a1a1a] rounded-md transition-all duration-300"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex gap-4 items-center">
      <SocialLinks size="md" />
      <LanguageSwitcher />
      <a
        href="mailto:maisongalvao@outlook.com"
        class="hidden sm:block px-4 py-2 bg-accent-500 text-[#0a0a0a] rounded-lg font-semibold hover:bg-accent-400 transition-colors text-sm"
      >
        {t('nav.language') === 'Idioma' ? 'Contato' : 'Contact'}
      </a>
    </div>
  </nav>
</header>


