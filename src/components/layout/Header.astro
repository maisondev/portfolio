---
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import ThemeSwitcher from '@/components/ui/ThemeSwitcher.astro';
import MobileMenu from '@/components/ui/MobileMenu.astro';
import { getLanguageFromUrl, getTranslation, type Language } from '@/i18n/utils';

const lang = getLanguageFromUrl(Astro.url) as Language;
const t = (key: string) => getTranslation(lang, key);

const getLocalizedPath = (path: string) => {
  return lang === 'pt' ? `/pt${path}` : `/en${path}`;
};

const links = [
  { href: getLocalizedPath('/'), label: t('nav.home') },
  { href: getLocalizedPath('/contests'), label: t('nav.contests') },
  { href: getLocalizedPath('/courses'), label: t('nav.courses') },
  { href: getLocalizedPath('/events'), label: t('nav.events') },
  { href: getLocalizedPath('/education'), label: t('nav.education') },
  { href: getLocalizedPath('/experience'), label: t('nav.experience') },
  { href: getLocalizedPath('/projects'), label: t('nav.projects') },
  { href: getLocalizedPath('/recognitions'), label: t('nav.recognitions') },
  // { href: getLocalizedPath('/case-studies'), label: t('nav.caseStudies') }, // Oculto temporariamente - aguardando revisão
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  return currentPath === href || currentPath === href + '/';
};
---

<header class="bg-canvas border-b border-hairline sticky top-0 z-50 backdrop-blur-sm bg-canvas/95 transition-colors duration-300">
  <nav class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 py-4 flex justify-between items-center">
    <a href={getLocalizedPath('/')} class="text-headline font-semibold text-primary hover:text-primary-hover transition-colors">
      MG
    </a>

    <ul class="hidden lg:flex gap-1 items-center">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class={`px-3 py-2 text-body-sm rounded-md transition-all duration-300 ${
              isActive(link.href)
                ? 'text-primary bg-surface-2'
                : 'text-ink-subtle hover:text-ink-muted hover:bg-surface-1 dark:hover:bg-surface-2'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex gap-2 items-center">
      <ThemeSwitcher />
      <LanguageSwitcher />
      <a
        href="mailto:maisongalvao@outlook.com"
        class="hidden sm:block px-4 py-2 bg-primary text-white rounded-md text-button font-medium hover:bg-primary-hover hover:text-white transition-colors"
      >
        {t('nav.language') === 'Idioma' ? 'Contato' : 'Contact'}
      </a>
      <MobileMenu links={links} />
    </div>
  </nav>
</header>


