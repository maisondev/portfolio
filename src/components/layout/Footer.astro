---
import SocialLinks from '@/components/ui/SocialLinks.astro';

const year = new Date().getFullYear();

const links = [
  { label: 'Home', href: '/' },
  { label: 'Sobre', href: '/about' },
  { label: 'Cursos', href: '/courses' },
  { label: 'Projetos', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Experiência', href: '/experience' },
  { label: 'Educação', href: '/education' },
  { label: 'Concursos', href: '/contests' },
];
---

<footer class="bg-surface-1 border-t border-hairline mt-20 transition-colors duration-300">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto px-6 md:px-8 py-12 md:py-16">
    <!-- Links Section -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 mb-12">
      <div>
        <h3 class="text-body-sm font-semibold text-ink mb-4">Navegação</h3>
        <ul class="space-y-2">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-body-sm font-semibold text-ink mb-4">Contato</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="mailto:maisongalvao@outlook.com"
              class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
            >
              Email
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/5592986255936"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/maisongalvao"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-body-sm font-semibold text-ink mb-4">Redes</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="https://github.com/maisondev"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://instagram.com/maisongalvao"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
            >
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-hairline pt-8">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-6">
        <p class="text-body-sm text-ink-tertiary">
          © {year} Maison Galvão. Todos os direitos reservados.
        </p>
        <SocialLinks size="md" />
      </div>
    </div>
  </div>
</footer>
