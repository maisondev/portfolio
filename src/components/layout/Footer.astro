---
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { getLanguageFromUrl, getLocalizedPath as getLocalizedPathFor, type Language } from '@/i18n/utils';

const lang = getLanguageFromUrl(Astro.url) as Language;
const year = new Date().getFullYear();

const getLocalizedPath = (path: string) => getLocalizedPathFor(lang, path);

const links = [
  { label: lang === 'pt' ? 'Início' : 'Home', href: getLocalizedPath('/') },
  { label: lang === 'pt' ? 'Concursos' : 'Contests', href: getLocalizedPath('/contests') },
  { label: lang === 'pt' ? 'Cursos' : 'Courses', href: getLocalizedPath('/courses') },
  { label: lang === 'pt' ? 'Eventos' : 'Events', href: getLocalizedPath('/events') },
  { label: lang === 'pt' ? 'Formação' : 'Education', href: getLocalizedPath('/education') },
  { label: lang === 'pt' ? 'Experiência' : 'Experience', href: getLocalizedPath('/experience') },
  { label: lang === 'pt' ? 'Projetos' : 'Projects', href: getLocalizedPath('/projects') },
  { label: lang === 'pt' ? 'Reconhecimentos' : 'Recognitions', href: getLocalizedPath('/recognitions') },
];

const contactLinks = [
  { label: 'Email', href: 'mailto:maisongalvao@outlook.com', external: false },
  { label: 'WhatsApp', href: 'https://wa.me/5592986255936', external: true },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/maisongalvao', external: true },
  { label: 'GitHub', href: 'https://github.com/maisondev', external: true },
  { label: 'Instagram', href: 'https://instagram.com/maisongalvao', external: true },
];
---

<footer class="bg-surface-1 border-t border-hairline mt-20 transition-colors duration-300">
  <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl 4xl:max-w-8xl mx-auto px-6 md:px-8 py-12 md:py-16">
    <!-- Links Section -->
    <div class="grid grid-cols-2 gap-8 mb-12">
      <div>
        <h3 class="text-body-sm font-semibold text-ink mb-4">Navegação</h3>
        <ul class="space-y-2">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-body-sm font-semibold text-ink mb-4">Contato & Redes</h3>
        <ul class="space-y-2">
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-body-sm text-ink-subtle hover:text-ink-muted transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-hairline pt-8">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-6">
        <p class="text-body-sm text-ink-tertiary">
          © {year} Maison Galvão. Todos os direitos reservados.
        </p>
        <SocialLinks size="md" />
      </div>
    </div>
  </div>
</footer>
