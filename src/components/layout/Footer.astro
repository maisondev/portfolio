---
const year = new Date().getFullYear();
---

<footer class="bg-[#0a0a0a] border-t border-[#2a2a2a] mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="text-[#d4d4d8] text-sm">
        © {year} Maison Galvão. Todos os direitos reservados.
      </div>
      <div class="flex gap-4">
        <a
          href="https://github.com/maisongalvao"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#d4d4d8] hover:text-[#fafafa] transition-colors"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/maisongalvao"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#d4d4d8] hover:text-[#fafafa] transition-colors"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</footer>
